<script>
console.log('SCRIPT STARTED - Booking page loaded');
// Custom Calendar Implementation
document.addEventListener('DOMContentLoaded', function() {
    console.log('=== DOM CONTENT LOADED ===');
    console.log('JavaScript is running!');
    
    let currentDate = new Date();
    let selectedDate = null;
    let bookedDates = [];
    let fullyBookedDates = [];
    let minDate = null;
    let maxDate = null;
    let currentSessionId = null;
    let sessionHourlyPrice = 0;

    const calMonthYear = document.getElementById('calMonthYear');
    const calBody = document.getElementById('calBody');
    const prevMonthBtn = document.getElementById('prevMonth');
    const nextMonthBtn = document.getElementById('nextMonth');
    const preferredDateInput = document.getElementById('preferredDate');
    const selectedDateDisplay = document.getElementById('selectedDateDisplay');
    const selectedDateText = document.getElementById('selectedDateText');
    
    console.log('Calendar elements found:');
    console.log('calMonthYear:', calMonthYear);
    console.log('calBody:', calBody);
    console.log('preferredDateInput:', preferredDateInput);
    
    // Check if form exists immediately
    const formCheck = document.getElementById('bookingForm');
    console.log('FORM CHECK - bookingForm found:', formCheck);
    if (formCheck) {
        console.log('Form action:', formCheck.action);
        console.log('Form method:', formCheck.method);
    }

    // ============ DURATION SELECTION ============
    // Session availability data
    let totalAvailableMinutes = 0;
    let remainingAvailableMinutes = 0;
    let sessionDuration = 60; // Default to 60 minutes, will be overridden by database value
    
    // Set session data from template
    {% if selectedSession %}
        {% if selectedSession.availableFrom and selectedSession.availableTo %}
            {% set fromHours = selectedSession.availableFrom|date('H') %}
            {% set fromMins = selectedSession.availableFrom|date('i') %}
            {% set toHours = selectedSession.availableTo|date('H') %}
            {% set toMins = selectedSession.availableTo|date('i') %}
            totalAvailableMinutes = {{ (toHours * 60 + toMins) - (fromHours * 60 + fromMins) }};
            
            // populateStartTimeDropdown function was removed with timeSlotSection
        {% endif %}
        {% if selectedSession.hourlyPrice %}
            sessionHourlyPrice = {{ selectedSession.hourlyPrice }};
        {% endif %}
        {% if selectedSession.duration %}
            sessionDuration = {{ selectedSession.duration }};
        {% endif %}
    {% endif %}
    
    // Generate duration options dynamically based on session's duration unit
    function generateDurationOptions(maxMinutes, hourlyPrice, baseDuration) {
        const container = document.getElementById('durationOptionsContainer');
        if (!container) return;
        
        container.innerHTML = '';
        
        // Generate options as multiples of the base session duration
        // e.g., if baseDuration = 60, options: 60, 120, 180, 240...
        // e.g., if baseDuration = 30, options: 30, 60, 90, 120...
        const availableDurations = [];
        let currentDuration = baseDuration;
        
        // Generate durations up to maxMinutes (or up to 8 hours if no max)
        const maxLimit = maxMinutes > 0 ? maxMinutes : 480; // Default to 8 hours max
        
        while (currentDuration <= maxLimit) {
            availableDurations.push(currentDuration);
            currentDuration += baseDuration;
        }
        
        if (availableDurations.length === 0) {
            document.getElementById('noAvailabilityMessage').style.display = 'block';
            document.getElementById('durationOptions').style.display = 'none';
            return;
        }
        
        document.getElementById('noAvailabilityMessage').style.display = 'none';
        document.getElementById('durationOptions').style.display = 'block';
        
        availableDurations.forEach((duration, index) => {
            const hours = duration / 60;
            const price = hours * hourlyPrice;
            
            // Format duration display
            let durationText = '';
            if (duration < 60) {
                durationText = `${duration} min`;
            } else if (duration === 60) {
                durationText = '1 hour';
            } else if (duration % 60 === 0) {
                durationText = `${hours} hrs`;
            } else {
                durationText = `${hours.toFixed(1)} hrs`;
            }
            
            const colDiv = document.createElement('div');
            colDiv.className = 'col-6 col-md-4';
            
            const optionDiv = document.createElement('div');
            optionDiv.className = 'duration-option' + (index === 0 ? ' selected' : '');
            optionDiv.setAttribute('data-duration', duration);
            optionDiv.setAttribute('data-price', price.toFixed(2));
            
            optionDiv.innerHTML = `
                <div class="duration-time">${durationText}</div>
                <div class="duration-price">$${price.toFixed(2)}</div>
            `;
            
            optionDiv.addEventListener('click', function() {
                // Remove selected from all
                document.querySelectorAll('.duration-option').forEach(opt => opt.classList.remove('selected'));
                // Add selected to clicked
                this.classList.add('selected');
                
                // Update hidden inputs
                document.getElementById('selectedDuration').value = duration;
                document.getElementById('selectedPrice').value = price.toFixed(2);
                
                // Update total price display
                updateTotalPriceDisplay(duration, price.toFixed(2));
            });
            
            colDiv.appendChild(optionDiv);
            container.appendChild(colDiv);
        });
        
        // Select first option by default
        if (availableDurations.length > 0) {
            const firstDuration = availableDurations[0];
            const firstPrice = (firstDuration / 60) * hourlyPrice;
            document.getElementById('selectedDuration').value = firstDuration;
            document.getElementById('selectedPrice').value = firstPrice.toFixed(2);
            updateTotalPriceDisplay(firstDuration, firstPrice.toFixed(2));
        }
    }
    
    // Update total price display
    function updateTotalPriceDisplay(duration, price) {
        const priceDisplay = document.getElementById('totalPriceDisplay');
        const finalPriceEl = document.getElementById('finalPrice');
        const breakdownEl = document.getElementById('priceBreakdownText');
        
        if (priceDisplay) {
            priceDisplay.style.display = 'block';
        }
        
        if (finalPriceEl) {
            finalPriceEl.textContent = '$' + parseFloat(price).toFixed(2);
        }
        
        if (breakdownEl && sessionHourlyPrice > 0) {
            const hours = duration / 60;
            if (hours < 1) {
                breakdownEl.textContent = `${duration} min × $${sessionHourlyPrice.toFixed(2)}/hour`;
            } else {
                breakdownEl.textContent = `${hours.toFixed(1)} hour(s) × $${sessionHourlyPrice.toFixed(2)}/hour`;
            }
        }
    }
    
    // Update remaining hours display based on booked time
    function updateRemainingHoursDisplay(bookedMinutes) {
        const remainingHoursText = document.getElementById('remainingHoursText');
        remainingAvailableMinutes = totalAvailableMinutes - bookedMinutes;
        
        if (remainingHoursText) {
            if (remainingAvailableMinutes <= 0) {
                remainingHoursText.innerHTML = '<strong class="text-danger">Fully booked for this date</strong>';
            } else {
                const remainingHours = (remainingAvailableMinutes / 60).toFixed(1);
                const totalHours = (totalAvailableMinutes / 60).toFixed(1);
                remainingHoursText.innerHTML = `<strong>${remainingHours} hours</strong> remaining (${totalHours} total - ${(bookedMinutes/60).toFixed(1)} booked)`;
            }
        }
        
        // Regenerate duration options based on remaining time
        if (sessionHourlyPrice > 0) {
            generateDurationOptions(remainingAvailableMinutes, sessionHourlyPrice, sessionDuration);
        }
    }
    
    // Initialize duration options on page load if session data is available
    if (totalAvailableMinutes > 0 && sessionHourlyPrice > 0) {
        generateDurationOptions(totalAvailableMinutes, sessionHourlyPrice, sessionDuration);
    }

    // Fetch booked dates for a session
    async function fetchBookedDates(sessionId) {
        if (!sessionId) return [];
        
        try {
            const response = await fetch(`/api/bookings/booked-dates/${sessionId}`);
            if (response.ok) {
                const data = await response.json();
                if (data.success && data.data) {
                    bookedDates = data.data.bookedDates || [];
                    fullyBookedDates = data.data.fullyBookedDates || [];
                    return { bookedDates, fullyBookedDates };
                }
            }
        } catch (error) {
            console.error('Error fetching booked dates:', error);
        }
        return { bookedDates: [], fullyBookedDates: [] };
    }

    // Update booked dates info
    function updateBookedDatesInfo() {
        const bookedDatesInfo = document.getElementById('bookedDatesInfo');
        const bookedDatesCount = document.getElementById('bookedDatesCount');
        
        if (bookedDatesInfo && bookedDatesCount) {
            if (bookedDates.length > 0) {
                bookedDatesCount.textContent = bookedDates.length;
                bookedDatesInfo.style.display = 'block';
            } else {
                bookedDatesInfo.style.display = 'none';
            }
        }
    }

    // Format date to YYYY-MM-DD (local timezone)
    function formatDate(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    // Check if date is booked
    function isBooked(dateStr) {
        return Array.isArray(bookedDates) && bookedDates.includes(dateStr);
    }
    
    // Check if date is fully booked
    function isFullyBooked(dateStr) {
        return Array.isArray(fullyBookedDates) && fullyBookedDates.includes(dateStr);
    }

    // Check if date is in range
    function isInRange(dateStr) {
        if (!minDate && !maxDate) return true;
        const date = new Date(dateStr);
        if (minDate && date < new Date(minDate)) return false;
        if (maxDate && date > new Date(maxDate)) return false;
        return true;
    }

    // Render calendar
    function renderCalendar() {
        const calMonthYear = document.getElementById('calMonthYear');
        const calBody = document.getElementById('calBody');
        
        if (!calMonthYear || !calBody) {
            console.error('Calendar elements not found');
            return;
        }
        
        const year = currentDate.getFullYear();
        const month = currentDate.getMonth();
        
        console.log('Rendering calendar for:', year, month);
        
        // Update header
        const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
                          'July', 'August', 'September', 'October', 'November', 'December'];
        calMonthYear.textContent = `${monthNames[month]} ${year}`;
        
        // Clear calendar body
        calBody.innerHTML = '';
        
        // Get first day of month and number of days
        const firstDay = new Date(year, month, 1);
        const lastDay = new Date(year, month + 1, 0);
        const daysInMonth = lastDay.getDate();
        
        console.log('Days in month:', daysInMonth);
        
        // Adjust for Monday start (0 = Monday, 6 = Sunday)
        let startDay = firstDay.getDay() - 1;
        if (startDay < 0) startDay = 6;
        
        console.log('Start day (Monday=0):', startDay);
        
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        
        // Add empty cells for days before start of month
        for (let i = 0; i < startDay; i++) {
            const emptyDay = document.createElement('div');
            emptyDay.className = 'cal-day empty';
            calBody.appendChild(emptyDay);
        }
        
        // Add days
        for (let day = 1; day <= daysInMonth; day++) {
            const date = new Date(year, month, day);
            const dateStr = formatDate(date);
            
            const dayDiv = document.createElement('div');
            dayDiv.className = 'cal-day';
            dayDiv.textContent = day;
            dayDiv.style.cssText = 'display:flex;align-items:center;justify-content:center;color:#374151;font-weight:600;';
            
            // Check conditions
            const isPast = date < today;
            const booked = isBooked(dateStr);
            const fullyBooked = isFullyBooked(dateStr);
            const inRange = isInRange(dateStr);
            const isSelected = selectedDate === dateStr;
            const isToday = date.getTime() === today.getTime();
            
            if (isToday) dayDiv.classList.add('today');
            if (isSelected) dayDiv.classList.add('selected');
            
            if (fullyBooked) {
                dayDiv.classList.add('fully-booked');
                dayDiv.title = 'This date is fully booked (all hours taken)';
            } else if (booked) {
                dayDiv.classList.add('booked');
                dayDiv.title = 'This date has existing bookings';
                // Still allow selection for partial bookings
                if (!isPast && inRange) {
                    dayDiv.addEventListener('click', function() {
                        selectDate(dateStr);
                    });
                }
            } else if (isPast) {
                dayDiv.classList.add('unavailable');
                dayDiv.title = 'Past date';
            } else if (!inRange) {
                dayDiv.classList.add('unavailable');
                dayDiv.title = 'Outside session date range';
            } else {
                // Date is available for selection
                dayDiv.classList.add('in-range');
                dayDiv.title = 'Click to select this date';
                dayDiv.addEventListener('click', function() {
                    selectDate(dateStr);
                });
            }
            
            calBody.appendChild(dayDiv);
            if (day === 22) {
                console.log('Day 22 element created:', dayDiv);
                console.log('Day 22 textContent:', dayDiv.textContent);
                console.log('Day 22 className:', dayDiv.className);
                // Check DOM after a short delay
                setTimeout(() => {
                    const day22InDOM = document.querySelector('.cal-day.in-range');
                    console.log('Day 22 in DOM after render:', day22InDOM);
                    console.log('All cal-day elements:', document.querySelectorAll('.cal-day').length);
                }, 100);
            }
        }
        
        console.log('Calendar rendered with', daysInMonth, 'days');
    }

    // Select date
    async function selectDate(dateStr) {
        console.log('selectDate called with:', dateStr);
        
        if (isFullyBooked(dateStr)) {
            alert('This date is fully booked (all available hours are taken). Please select another date.');
            return;
        }
        
        selectedDate = dateStr;
        if (preferredDateInput) {
            preferredDateInput.value = dateStr;
        }
        
        // Update display
        if (selectedDateText && selectedDateDisplay) {
            // Parse dateStr (YYYY-MM-DD) to avoid timezone issues
            const [year, month, day] = dateStr.split('-').map(Number);
            // Create date using local components (month is 0-indexed in JavaScript)
            const date = new Date(year, month - 1, day);
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            selectedDateText.textContent = date.toLocaleDateString('en-US', options);
            selectedDateDisplay.style.display = 'block';
        }
        
        // Show time slot section and populate time slots - REMOVED
        // Time slot section was deleted from the form
        
        // Fetch booked time slots for this date and update duration options - REMOVED
        // Duration options were part of the deleted time slot section
        
        // Re-render to show selection
        renderCalendar();
    }
    
    // Update duration options based on booked time for selected date
    async function updateDurationOptionsForDate(dateStr) {
        if (!currentSessionId || !dateStr) return;
        
        try {
            const response = await fetch(`/api/bookings/time-slots/${currentSessionId}/${dateStr}`);
            if (response.ok) {
                const data = await response.json();
                if (data.success && data.data && data.data.bookedSlots) {
                    // Calculate total booked minutes for this date
                    let bookedMinutes = 0;
                    data.data.bookedSlots.forEach(slot => {
                        if (slot.duration_minutes) {
                            bookedMinutes += slot.duration_minutes;
                        }
                    });
                    
                    // Calculate remaining minutes
                    const remainingMinutes = sessionData.totalAvailableMinutes - bookedMinutes;
                    
                    // Update available hours text
                    const availableHoursText = document.getElementById('availableHoursText');
                    if (availableHoursText) {
                        const totalHours = (sessionData.totalAvailableMinutes / 60).toFixed(1);
                        const remainingHours = (remainingMinutes / 60).toFixed(1);
                        const bookedHours = (bookedMinutes / 60).toFixed(1);
                        
                        if (remainingMinutes <= 0) {
                            availableHoursText.innerHTML = '<strong class="text-danger">This session is fully booked for this date</strong>';
                        } else {
                            availableHoursText.innerHTML = `<strong>${remainingHours} hours</strong> available (${totalHours} total - ${bookedHours} booked)`;
                        }
                    }
                    
                    // Update duration dropdown with dynamic options based on remaining time
                    updateDurationDropdown(remainingMinutes);
                }
            }
        } catch (error) {
            console.error('Error fetching booked time slots:', error);
            // Fall back to total available minutes
            updateDurationDropdown(sessionData.totalAvailableMinutes);
        }
    }
    
    // Update duration dropdown with options based on available minutes
    function updateDurationDropdown(availableMinutes) {
        const durationSelect = document.getElementById('durationMinutes');
        if (!durationSelect) return;
        
        // Clear existing options
        durationSelect.innerHTML = '<option value="">Select duration...</option>';
        
        if (availableMinutes <= 0) {
            durationSelect.innerHTML = '<option value="" disabled>No time available</option>';
            return;
        }
        
        // Generate duration options in 30-minute increments up to available time
        const increments = [30, 60, 90, 120, 150, 180, 210, 240, 300, 360, 420, 480];
        let hasSelected = false;
        
        increments.forEach(minutes => {
            if (minutes <= availableMinutes) {
                const option = document.createElement('option');
                option.value = minutes;
                
                // Format duration text
                const hours = minutes / 60;
                let durationText = '';
                if (minutes < 60) {
                    durationText = `${minutes} minutes`;
                } else if (minutes === 60) {
                    durationText = '1 hour';
                } else if (minutes % 60 === 0) {
                    durationText = `${hours} hours`;
                } else {
                    const wholeHours = Math.floor(hours);
                    const mins = minutes % 60;
                    durationText = `${wholeHours} hour${wholeHours > 1 ? 's' : ''} ${mins} min`;
                }
                
                option.textContent = durationText;
                
                // Select first available option by default
                if (!hasSelected) {
                    option.selected = true;
                    hasSelected = true;
                }
                
                durationSelect.appendChild(option);
            }
        });
        
        // Trigger price calculation
        calculatePrice();
    }

    // Navigation
    if (prevMonthBtn) {
        prevMonthBtn.addEventListener('click', function() {
            currentDate.setMonth(currentDate.getMonth() - 1);
            renderCalendar();
        });
    }

    if (nextMonthBtn) {
        nextMonthBtn.addEventListener('click', function() {
            currentDate.setMonth(currentDate.getMonth() + 1);
            renderCalendar();
        });
    }

    // Handle session selection
    const sessionSelect = document.getElementById('sessionSelect');
    if (sessionSelect) {
        sessionSelect.addEventListener('change', async function() {
            const selectedOption = this.options[this.selectedIndex];
            currentSessionId = this.value;
            
            if (currentSessionId && selectedOption) {
                // Update date range
                const startDate = selectedOption.getAttribute('data-start-date');
                const endDate = selectedOption.getAttribute('data-end-date');
                
                minDate = startDate || null;
                maxDate = endDate || null;
                
                // Update info
                const dateRangeInfo = document.getElementById('dateRangeInfo');
                if (dateRangeInfo && startDate && endDate) {
                    dateRangeInfo.innerHTML = `<strong>Session period:</strong> ${startDate} to ${endDate}`;
                }
                
                // Fetch booked dates
                const datesData = await fetchBookedDates(currentSessionId);
                bookedDates = datesData.bookedDates || [];
                fullyBookedDates = datesData.fullyBookedDates || [];
                updateBookedDatesInfo();
                
                // Re-render calendar
                renderCalendar();
                
                // Clear previous selection
                selectedDate = null;
                if (preferredDateInput) {
                    preferredDateInput.value = '';
                }
                if (selectedDateDisplay) {
                    selectedDateDisplay.style.display = 'none';
                }
            }
        });
    }

    // Test if we can attach event listener to form
    const testForm = document.getElementById('bookingForm');
    if (testForm) {
        console.log('TEST: Form found, attaching simple click test');
        testForm.addEventListener('click', function() {
            console.log('TEST: Form was clicked');
        });
    }
    
    // Form validation
    const form = document.getElementById('bookingForm');
    console.log('Form element found:', form);
    
    if (form) {
        form.addEventListener('submit', function(e) {
            console.log('=== FORM SUBMISSION STARTED ===');
            console.log('Event object:', e);
            console.log('Form data before submission:');
            
            // Log all form fields
            const formData = new FormData(form);
            for (let [key, value] of formData.entries()) {
                console.log(`${key}: ${value}`);
            }
            
            const termsCheck = document.getElementById('termsCheck');
            console.log('Terms checkbox found:', termsCheck);
            console.log('Terms checkbox checked:', termsCheck ? termsCheck.checked : 'not found');
            
            // Check if terms are accepted
            if (!termsCheck || !termsCheck.checked) {
                console.log('VALIDATION FAILED: Terms not accepted');
                e.preventDefault();
                alert('Please accept terms and conditions to proceed.');
                return;
            }
            
            console.log('Terms validation passed');
            
            // Check if date is selected
            console.log('Preferred date input:', preferredDateInput);
            console.log('Preferred date value:', preferredDateInput ? preferredDateInput.value : 'not found');
            
            if (!preferredDateInput || !preferredDateInput.value) {
                console.log('VALIDATION FAILED: No date selected');
                e.preventDefault();
                alert('Please select your preferred date for the session.');
                return;
            }

            console.log('Date validation passed');

            // Check if selected date is not in the past
            const [selYear, selMonth, selDay] = preferredDateInput.value.split('-').map(Number);
            const selectedDateObj = new Date(selYear, selMonth - 1, selDay);
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            
            console.log('Selected date:', selectedDateObj);
            console.log('Today:', today);
            console.log('Is past date:', selectedDateObj < today);
            
            if (selectedDateObj < today) {
                console.log('VALIDATION FAILED: Date is in the past');
                e.preventDefault();
                alert('Please select a date that is today or in the future.');
                return;
            }
            
            console.log('Date past validation passed');
            console.log('=== ALL VALIDATIONS PASSED - FORM WILL SUBMIT ===');
            
            // Time slot validation removed - these fields are no longer in the form
        });
    } else {
        console.error('FORM NOT FOUND: No element with id "bookingForm"');
    }

    // ============ TIME SLOT SELECTION LOGIC ============
    
    // Session data for time slot and price calculation
    let sessionData = {
        availableFrom: null,
        availableTo: null,
        hourlyPrice: null,
        totalAvailableMinutes: 0
    };
    
    // Booked time slots for the selected date
    let bookedTimeSlots = [];
    
    // Fetch session data including availability and price
    async function fetchSessionData(sessionId) {
        if (!sessionId) return null;
        
        try {
            const response = await fetch(`/api/session/${sessionId}`);
            if (response.ok) {
                const data = await response.json();
                return data;
            }
        } catch (error) {
            console.error('Error fetching session data:', error);
        }
        return null;
    }
    
    // Fetch booked time slots for a specific date
    async function fetchBookedTimeSlots(sessionId, dateStr) {
        if (!sessionId || !dateStr) return [];
        
        try {
            const response = await fetch(`/api/bookings/time-slots/${sessionId}/${dateStr}`);
            if (response.ok) {
                const data = await response.json();
                if (data.success && data.data && data.data.bookedSlots) {
                    return data.data.bookedSlots;
                }
            }
        } catch (error) {
            console.error('Error fetching booked time slots:', error);
        }
        return [];
    }
    
