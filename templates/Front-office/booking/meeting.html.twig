{% extends 'front_base.html.twig' %}

{% block title %}Meeting - {{ booking.session.name }} - UniLearn{% endblock %}

{% block content %}
<section class="meeting-page py-4">
    <div class="container-fluid px-4">
        <!-- Meeting Header -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div>
                                <h1 class="h4 mb-1">
                                    <i class="bi bi-camera-video text-primary me-2"></i>
                                    {{ booking.session.name }}
                                </h1>
                                <p class="text-muted mb-0">
                                    <i class="bi bi-person me-1"></i>
                                    {% if isInstructor %}
                                        Student: {{ studentName }}
                                    {% else %}
                                        Instructor: {{ instructorName }}
                                    {% endif %}
                                    <span class="mx-2">|</span>
                                    <i class="bi bi-calendar me-1"></i>
                                    {{ booking.preferredDate|date('F j, Y') }}
                                    <span class="mx-2">|</span>
                                    <i class="bi bi-clock me-1"></i>
                                    {{ booking.startTime ? booking.startTime|date('H:i') : 'TBD' }}
                                </p>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="{{ app.request.headers.get('referer') ?: path('teacher_calendar') }}" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-1"></i> Back
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Meeting Status Banner -->
        {% if booking.status == 'accepted' %}
            <div class="row mb-3">
                <div class="col-12">
                    <div class="alert alert-success d-flex align-items-center" role="alert">
                        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                        <div>
                            <strong>Session Ready!</strong> Your meeting is ready to start. Click the "Join Meeting" button below.
                        </div>
                    </div>
                </div>
            </div>
        {% elseif booking.status == 'pending' %}
            <div class="row mb-3">
                <div class="col-12">
                    <div class="alert alert-warning d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        <div>
                            <strong>Pending Confirmation</strong> This session is still pending. You can still start the meeting.
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        <!-- Jitsi Meet Container -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-primary text-white py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="bi bi-camera-video-fill me-2"></i>
                                Video Conference
                            </h5>
                            <span class="badge bg-light text-primary">
                                Room: {{ roomName }}
                            </span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <!-- Jitsi Meet IFrame -->
                        <div id="meet-container" style="height: 600px; width: 100%; position: relative;">
                            <!-- Loading State -->
                            <div id="loading-overlay" class="d-flex flex-column align-items-center justify-content-center h-100 bg-light">
                                <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <h5 class="text-muted">Initializing Video Conference...</h5>
                                <p class="text-muted small">Please wait while we connect you to the meeting room</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Meeting Controls -->
        <div class="row mt-3">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body py-3">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <h6 class="mb-2"><i class="bi bi-info-circle me-2"></i>Meeting Information</h6>
                                <ul class="list-unstyled mb-0 small text-muted">
                                    <li><i class="bi bi-people me-2"></i>Participants: {{ instructorName }} & {{ studentName }}</li>
                                    <li><i class="bi bi-stopwatch me-2"></i>Duration: {{ booking.durationMinutes }} minutes</li>
                                    <li><i class="bi bi-cash me-2"></i>Price: ${{ booking.totalPrice }}</li>
                                </ul>
                            </div>
                            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                                <button id="startMeetingBtn" class="btn btn-success btn-lg me-2">
                                    <i class="bi bi-camera-video me-2"></i>Join Meeting
                                </button>
                                <button id="leaveMeetingBtn" class="btn btn-danger btn-lg me-2" style="display: none;">
                                    <i class="bi bi-box-arrow-right me-2"></i>Leave Meeting
                                </button>
                                {% if isInstructor %}
                                <button id="sendLinkBtn" class="btn btn-primary btn-lg" data-booking-id="{{ booking.id }}">
                                    <i class="bi bi-envelope me-2"></i>Send Link
                                </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tips Section -->
        <div class="row mt-3">
            <div class="col-12">
                {% if not isInstructor %}
                <div class="alert alert-info mb-3">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <strong>Note:</strong> The instructor must join the meeting first before you can enter. If you see a "waiting for moderator" screen, please wait for {{ instructorName }} to join.
                </div>
                {% else %}
                <div class="alert alert-warning mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Instructor:</strong> You must join first to become the meeting moderator. Students will be able to join after you enter.
                </div>
                {% endif %}
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-body py-3">
                        <h6 class="mb-3"><i class="bi bi-lightbulb text-warning me-2"></i>Tips for a Better Experience</h6>
                        <div class="row">
                            <div class="col-md-4 mb-2">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-mic text-primary me-2 mt-1"></i>
                                    <small>Use a good microphone for clear audio</small>
                                </div>
                            </div>
                            <div class="col-md-4 mb-2">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-camera text-primary me-2 mt-1"></i>
                                    <small>Enable your camera for better interaction</small>
                                </div>
                            </div>
                            <div class="col-md-4 mb-2">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-wifi text-primary me-2 mt-1"></i>
                                    <small>Ensure stable internet connection</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Meeting Feedback Section - Hidden initially, shown after meeting ends -->
        <div class="row mt-3" id="feedbackSection" style="display: none;">
            <div class="col-12">
                <div class="card shadow border-0">
                    <div class="card-header bg-success text-white py-3">
                        <h5 class="mb-0"><i class="bi bi-star-fill me-2"></i>Meeting Feedback</h5>
                    </div>
                    <div class="card-body">
                        <div id="feedbackForm">
                            <p class="text-muted mb-4">Thank you for joining the meeting! Please rate your experience to help us improve.</p>
                            
                            <!-- Satisfaction Rating -->
                            <div class="mb-4">
                                <label class="form-label fw-bold">How satisfied were you with the overall meeting?</label>
                                <div class="star-rating" data-rating-type="satisfaction">
                                    {% for i in 1..5 %}
                                        <i class="bi bi-star fs-4 star-icon" data-value="{{ i }}" style="cursor: pointer; color: #ffc107; opacity: 0.3;"></i>
                                    {% endfor %}
                                </div>
                                <input type="hidden" id="satisfactionRating" value="0">
                            </div>
                            
                            <!-- Call Quality Rating -->
                            <div class="mb-4">
                                <label class="form-label fw-bold">How was the call/video quality?</label>
                                <div class="star-rating" data-rating-type="callQuality">
                                    {% for i in 1..5 %}
                                        <i class="bi bi-star fs-4 star-icon" data-value="{{ i }}" style="cursor: pointer; color: #ffc107; opacity: 0.3;"></i>
                                    {% endfor %}
                                </div>
                                <input type="hidden" id="callQualityRating" value="0">
                            </div>
                            
                            <!-- Learning Style Rating -->
                            <div class="mb-4">
                                <label class="form-label fw-bold">How would you rate the learning/teaching style?</label>
                                <div class="star-rating" data-rating-type="learningStyle">
                                    {% for i in 1..5 %}
                                        <i class="bi bi-star fs-4 star-icon" data-value="{{ i }}" style="cursor: pointer; color: #ffc107; opacity: 0.3;"></i>
                                    {% endfor %}
                                </div>
                                <input type="hidden" id="learningStyleRating" value="0">
                            </div>
                            
                            <!-- Comments -->
                            <div class="mb-4">
                                <label class="form-label fw-bold">Additional Comments (Optional)</label>
                                <textarea id="feedbackComments" class="form-control" rows="3" placeholder="Share your thoughts about the session..."></textarea>
                            </div>
                            
                            <!-- Submit Button -->
                            <button id="submitFeedbackBtn" class="btn btn-success btn-lg" data-booking-id="{{ booking.id }}">
                                <i class="bi bi-send me-2"></i>Submit Feedback
                            </button>
                        </div>
                        
                        <!-- Success Message -->
                        <div id="feedbackSuccess" style="display: none;">
                            <div class="text-center py-4">
                                <i class="bi bi-check-circle-fill text-success fs-1 mb-3"></i>
                                <h5 class="text-success">Thank You!</h5>
                                <p class="text-muted">Your feedback has been submitted successfully.</p>
                                <a href="{{ app.request.headers.get('referer') ?: path('teacher_calendar') }}" class="btn btn-outline-primary">
                                    <i class="bi bi-arrow-left me-2"></i>Go Back
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Jitsi Meet API Script -->
<script src="https://meet.jit.si/external_api.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const domain = 'meet.jit.si';
    const options = {
        roomName: '{{ roomName }}',
        width: '100%',
        height: '100%',
        parentNode: document.getElementById('meet-container'),
        userInfo: {
            displayName: '{{ isInstructor ? instructorName : studentName }}',
            email: '{{ app.user.email }}'
        },
        configOverwrite: {
            startWithAudioMuted: false,
            startWithVideoMuted: false,
            prejoinPageEnabled: false,
            enableWelcomePage: false,
            enableClosePage: false,
            // Disable lobby/waiting room - allow immediate joining
            enableLobby: false,
            // Disable moderator requirements
            disableModeratorIndicator: true,
            // Anyone can join without waiting for moderator
            enableAuthenticatedAccess: false,
            // Open room - no password by default
            lockRoomGuestAccess: false,
            // Fix green screen issues
            disableSimulcast: false,
            enableLayerSuspension: true,
            videoQuality: {
                preferredCodec: 'VP8',
                disabledCodec: 'H264'
            },
            disableHardwareAcceleration: false,
            constraints: {
                video: {
                    height: {
                        ideal: 720,
                        max: 720,
                        min: 180
                    },
                    width: {
                        ideal: 1280,
                        max: 1280,
                        min: 320
                    }
                }
            }
        },
        interfaceConfigOverwrite: {
            SHOW_JITSI_WATERMARK: false,
            SHOW_WATERMARK_FOR_GUESTS: false,
            DEFAULT_BACKGROUND: '#667eea',
            // Filmstrip only mode
            filmStripOnly: false,
            // Show participants
            SHOW_PARTICIPANTS_STATUSES: true,
            // Toolbar buttons
            TOOLBAR_BUTTONS: [
                'microphone', 'camera', 'closedcaptions', 'desktop', 'fullscreen',
                'fodeviceselection', 'hangup', 'profile', 'chat', 'recording',
                'livestreaming', 'etherpad', 'sharedvideo', 'settings', 'raisehand',
                'videoquality', 'filmstrip', 'invite', 'feedback', 'stats', 'shortcuts',
                'tileview', 'videobackgroundblur', 'download', 'help', 'mute-everyone', 'security'
            ]
        }
    };

    let api = null;
    let isMeetingActive = false;

    const startMeetingBtn = document.getElementById('startMeetingBtn');
    const leaveMeetingBtn = document.getElementById('leaveMeetingBtn');
    const loadingOverlay = document.getElementById('loading-overlay');

    // Start meeting
    startMeetingBtn.addEventListener('click', function() {
        if (!isMeetingActive) {
            // Initialize Jitsi Meet
            api = new JitsiMeetExternalAPI(domain, options);
            
            // Hide loading overlay when API is ready
            api.addEventListener('videoConferenceJoined', function() {
                loadingOverlay.style.display = 'none';
                isMeetingActive = true;
                startMeetingBtn.style.display = 'none';
                leaveMeetingBtn.style.display = 'inline-block';
            });

            // Handle when user leaves the meeting
            api.addEventListener('videoConferenceLeft', function() {
                isMeetingActive = false;
                startMeetingBtn.style.display = 'inline-block';
                leaveMeetingBtn.style.display = 'none';
                loadingOverlay.style.display = 'flex';
                
                // Check and show feedback status
                setTimeout(checkAndShowFeedbackStatus, 1000);
                
                // Dispose the API
                if (api) {
                    api.dispose();
                    api = null;
                }
            });

            // Handle ready event - show appropriate message
            api.addEventListener('ready', function() {
                {% if isInstructor %}
                // Show instruction for instructor
                loadingOverlay.innerHTML = `
                    <div class="text-center">
                        <div class="alert alert-warning mb-3">
                            <i class="bi bi-exclamation-triangle-fill fs-4 mb-2 d-block"></i>
                            <strong>First Time Setup Required</strong>
                            <p class="mb-2">Click "Je suis l'hôte" (I am the host) below, then authenticate to start the meeting.</p>
                            <small class="text-muted">This only needs to be done once per session.</small>
                        </div>
                    </div>
                `;
                {% else %}
                // Show waiting message for students
                loadingOverlay.innerHTML = `
                    <div class="text-center">
                        <i class="bi bi-hourglass-split text-primary fs-1 mb-3"></i>
                        <h5 class="text-muted">Waiting for Instructor...</h5>
                        <p class="text-muted small">Please wait for {{ instructorName }} to start the meeting</p>
                    </div>
                `;
                {% endif %}
            });

            // Detect when iframe loads authentication page
            const meetContainer = document.getElementById('meet-container');
            const checkForAuth = setInterval(function() {
                try {
                    const iframe = meetContainer.querySelector('iframe');
                    if (iframe && iframe.src && iframe.src.includes('signin')) {
                        {% if isInstructor %}
                        loadingOverlay.innerHTML = `
                            <div class="text-center">
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle-fill fs-4 mb-2 d-block"></i>
                                    <strong>Almost there!</strong>
                                    <p class="mb-0">Click "Je suis l'hôte" in the video window to authenticate.</p>
                                </div>
                            </div>
                        `;
                        {% endif %}
                        clearInterval(checkForAuth);
                    }
                } catch (e) {
                    // Cross-origin restrictions may prevent access
                }
            }, 1000);

            // Clear check after 30 seconds
            setTimeout(function() {
                clearInterval(checkForAuth);
            }, 30000);
        }
    });

    // Leave meeting
    leaveMeetingBtn.addEventListener('click', function() {
        if (api && isMeetingActive) {
            api.executeCommand('hangup');
        }
    });

    // Check feedback status after meeting ends
    async function checkAndShowFeedbackStatus() {
        const bookingId = {{ booking.id }};
        try {
            const response = await fetch(`/api/booking/${bookingId}/feedback/status`, {
                credentials: 'include'
            });
            const data = await response.json();
            
            if (data.success) {
                if (data.hasSubmitted) {
                    // User already submitted feedback
                    showFeedbackStatusMessage('info', 'Feedback Submitted', 'You have already rated this session. Thank you!');
                } else {
                    // User hasn't submitted - show the feedback form
                    const feedbackSection = document.getElementById('feedbackSection');
                    if (feedbackSection) {
                        feedbackSection.style.display = 'block';
                        feedbackSection.scrollIntoView({ behavior: 'smooth' });
                    }
                }
                
                // Show average ratings if available
                if (data.averageRatings && data.averageRatings.total > 0) {
                    const avgRating = Math.round((data.averageRatings.satisfaction + data.averageRatings.callQuality + data.averageRatings.learningStyle) / 3);
                    showFeedbackStatusMessage('success', 'Session Rating', `Average rating: ${avgRating}/5 stars from ${data.averageRatings.total} participant(s)`);
                }
            }
        } catch (error) {
            console.error('Error checking feedback status:', error);
        }
    }

    // Helper function to show status messages
    function showFeedbackStatusMessage(type, title, message) {
        const statusDiv = document.createElement('div');
        statusDiv.className = `alert alert-${type} alert-dismissible fade show mt-3`;
        statusDiv.innerHTML = `
            <i class="bi bi-${type === 'success' ? 'check-circle' : type === 'info' ? 'info-circle' : 'exclamation-triangle'}-fill me-2"></i>
            <strong>${title}</strong>: ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.querySelector('.meeting-page .container-fluid').prepend(statusDiv);
    }

    // Send Link button (for instructors)
    {% if isInstructor %}
    const sendLinkBtn = document.getElementById('sendLinkBtn');
    if (sendLinkBtn) {
        sendLinkBtn.addEventListener('click', function() {
            const bookingId = this.dataset.bookingId;
            const btn = this;
            const originalContent = btn.innerHTML;
            
            // Show loading state
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Sending...';
            btn.disabled = true;
            
            // Send API request to send meeting link
            fetch(`/booking/${bookingId}/send-link`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                credentials: 'include'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    btn.innerHTML = '<i class="bi bi-check-circle me-2"></i>Link Sent!';
                    btn.classList.remove('btn-primary');
                    btn.classList.add('btn-success');
                    
                    // Show success message
                    const alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-success alert-dismissible fade show position-fixed';
                    alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
                    alertDiv.innerHTML = `
                        <i class="bi bi-check-circle-fill me-2"></i>
                        Meeting link sent successfully to {{ studentName }}!
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    `;
                    document.body.appendChild(alertDiv);
                    
                    // Reset button after 3 seconds
                    setTimeout(() => {
                        btn.innerHTML = originalContent;
                        btn.disabled = false;
                        btn.classList.remove('btn-success');
                        btn.classList.add('btn-primary');
                    }, 3000);
                } else {
                    throw new Error(data.error || 'Failed to send link');
                }
            })
            .catch(error => {
                btn.innerHTML = originalContent;
                btn.disabled = false;
                
                // Show error message
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-danger alert-dismissible fade show position-fixed';
                alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
                alertDiv.innerHTML = `
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Failed to send link: ${error.message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.body.appendChild(alertDiv);
            });
        });
    }
    {% endif %}

    // Auto-start meeting for accepted bookings
    {% if booking.status == 'accepted' %}
        // Auto-start after a short delay
        setTimeout(function() {
            startMeetingBtn.click();
        }, 1000);
    {% endif %}

    // Meeting Feedback Functionality
    let hasLeftMeeting = false;
    let meetingEnded = false;

    // Function to show feedback form when meeting ends
    function showFeedbackForm() {
        if (!meetingEnded) {
            meetingEnded = true;
            const feedbackSection = document.getElementById('feedbackSection');
            if (feedbackSection) {
                feedbackSection.style.display = 'block';
                // Scroll to feedback section
                feedbackSection.scrollIntoView({ behavior: 'smooth' });
            }
            
            // Hide the tips section
            const tipsSection = document.querySelector('.row.mt-3');
            if (tipsSection && tipsSection.querySelector('.alert')) {
                tipsSection.style.display = 'none';
            }
        }
    }

    // Handle leave meeting button click
    if (leaveMeetingBtn) {
        leaveMeetingBtn.addEventListener('click', function() {
            hasLeftMeeting = true;
            if (api) {
                api.dispose();
                api = null;
            }
            showFeedbackForm();
        });
    }

    // Handle videoConferenceLeft event from Jitsi
    if (typeof api !== 'undefined' && api) {
        api.addEventListener('videoConferenceLeft', function() {
            hasLeftMeeting = true;
            showFeedbackForm();
        });
    }

    // Star Rating Functionality
    const starRatings = document.querySelectorAll('.star-rating');
    const ratings = {
        satisfaction: 0,
        callQuality: 0,
        learningStyle: 0
    };

    starRatings.forEach(ratingContainer => {
        const stars = ratingContainer.querySelectorAll('.star-icon');
        const ratingType = ratingContainer.dataset.ratingType;
        const inputField = document.getElementById(ratingType + 'Rating');

        stars.forEach((star, index) => {
            star.addEventListener('click', function() {
                const value = parseInt(this.dataset.value);
                ratings[ratingType] = value;
                if (inputField) {
                    inputField.value = value;
                }

                // Update star visuals
                stars.forEach((s, i) => {
                    if (i < value) {
                        s.classList.remove('bi-star');
                        s.classList.add('bi-star-fill');
                        s.style.opacity = '1';
                    } else {
                        s.classList.remove('bi-star-fill');
                        s.classList.add('bi-star');
                        s.style.opacity = '0.3';
                    }
                });
            });

            // Hover effects
            star.addEventListener('mouseenter', function() {
                const value = parseInt(this.dataset.value);
                stars.forEach((s, i) => {
                    if (i < value) {
                        s.style.opacity = '0.7';
                    } else {
                        s.style.opacity = '0.3';
                    }
                });
            });

            star.addEventListener('mouseleave', function() {
                const currentValue = ratings[ratingType];
                stars.forEach((s, i) => {
                    if (i < currentValue) {
                        s.style.opacity = '1';
                    } else {
                        s.style.opacity = '0.3';
                    }
                });
            });
        });
    });

    // Submit Feedback
    const submitFeedbackBtn = document.getElementById('submitFeedbackBtn');
    if (submitFeedbackBtn) {
        submitFeedbackBtn.addEventListener('click', async function() {
            const bookingId = this.dataset.bookingId;
            const satisfactionRating = document.getElementById('satisfactionRating').value;
            const callQualityRating = document.getElementById('callQualityRating').value;
            const learningStyleRating = document.getElementById('learningStyleRating').value;
            const comments = document.getElementById('feedbackComments').value;

            // Validate ratings
            if (satisfactionRating == 0 || callQualityRating == 0 || learningStyleRating == 0) {
                alert('Please provide all three ratings before submitting.');
                return;
            }

            // Disable button during submission
            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting...';

            try {
                const response = await fetch(`/api/booking/${bookingId}/feedback`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    credentials: 'include',
                    body: JSON.stringify({
                        satisfactionRating: parseInt(satisfactionRating),
                        callQualityRating: parseInt(callQualityRating),
                        learningStyleRating: parseInt(learningStyleRating),
                        comments: comments
                    })
                });

                const data = await response.json();

                if (data.success) {
                    // Hide form, show success message
                    document.getElementById('feedbackForm').style.display = 'none';
                    document.getElementById('feedbackSuccess').style.display = 'block';
                } else {
                    throw new Error(data.error || 'Failed to submit feedback');
                }
            } catch (error) {
                alert('Error: ' + error.message);
                this.disabled = false;
                this.innerHTML = '<i class="bi bi-send me-2"></i>Submit Feedback';
            }
        });
    }

    // Check if user already submitted feedback
    async function checkFeedbackStatus() {
        const submitFeedbackBtn = document.getElementById('submitFeedbackBtn');
        if (!submitFeedbackBtn) return;
        
        const bookingId = submitFeedbackBtn.dataset.bookingId;
        try {
            const response = await fetch(`/api/booking/${bookingId}/feedback/status`, {
                credentials: 'include'
            });
            const data = await response.json();
            
            if (data.success && data.hasSubmitted) {
                // User already submitted feedback
                document.getElementById('feedbackForm').style.display = 'none';
                const successDiv = document.getElementById('feedbackSuccess');
                successDiv.style.display = 'block';
                successDiv.querySelector('p').textContent = 'You have already submitted feedback for this meeting.';
            }
        } catch (error) {
            console.error('Error checking feedback status:', error);
        }
    }

    // Check feedback status on page load
    checkFeedbackStatus();
});
</script>

