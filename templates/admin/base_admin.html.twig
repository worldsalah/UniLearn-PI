{% extends 'base.html.twig' %}

{% block stylesheets %}
<style>
/* Admin Dashboard Styles */
.sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: 280px;
    background: #212529;
    z-index: 1000;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 4px 0 20px rgba(0, 0, 0, 0.15);
}
.sidebar .navbar-brand {
    padding: 1rem;
    color: white;
    font-weight: bold;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.sidebar .nav-link {
    color: rgba(255, 255, 255, 0.8);
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    margin: 0.25rem 0.5rem;
    transition: all 0.3s ease;
}
.sidebar .nav-link:hover,
.sidebar .nav-link.active {
    color: white;
    background: rgba(255, 255, 255, 0.1);
}
.page-content {
    margin-left: 280px;
    min-height: 100vh;
    background: #f8f9fa;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.page-content-wrapper {
    padding: 2rem;
}
</style>
{% endblock %}

{% block body %}
<!-- **************** MAIN CONTENT START **************** -->
<main>
    
    {% include 'admin/components/navbar.html.twig' %}

    <!-- Page content START -->
    <div class="page-content">
        
        {% include 'admin/components/topbar.html.twig' %}

        <!-- Page main content START -->
        <div class="page-content-wrapper border">
            
            {% block admin_content %}
            {% endblock %}

        </div>
        <!-- Page main content END -->
    </div>
    <!-- Page content END -->

</main>
<!-- **************** MAIN CONTENT END **************** -->

{% endblock %}

{% block admin_scripts %}
<script>
// Admin Currency Converter Functions
let adminCurrentCurrency = localStorage.getItem('selectedCurrency') || 'USD';
const adminExchangeRates = {
    'USD': 1,
    'EUR': 0.85,
    'GBP': 0.73,
    'JPY': 110.0,
    'CAD': 1.25,
    'AUD': 1.35,
    'CHF': 0.92,
    'CNY': 6.45,
    'INR': 74.0
};

const adminCurrencySymbols = {
    'USD': '$',
    'EUR': '€',
    'GBP': '£',
    'JPY': '¥',
    'CAD': 'C$',
    'AUD': 'A$',
    'CHF': 'CHF',
    'CNY': '¥',
    'INR': '₹'
};

// Convert admin price to selected currency
function convertAdminPrice(price) {
    const convertedPrice = price * adminExchangeRates[adminCurrentCurrency];
    return convertedPrice.toFixed(2);
}

// Format admin price with currency symbol
function formatAdminPrice(price) {
    const convertedPrice = convertAdminPrice(price);
    const symbol = adminCurrencySymbols[adminCurrentCurrency];
    return symbol + convertedPrice;
}

// Update admin currency display
function updateAdminCurrencyDisplay() {
    document.querySelectorAll('.admin-price').forEach(element => {
        const originalPrice = parseFloat(element.dataset.originalPrice || element.textContent.replace(/[^0-9.-]/g, ''));
        if (!isNaN(originalPrice)) {
            element.textContent = formatAdminPrice(originalPrice);
            element.dataset.originalPrice = originalPrice;
        }
    });
}

// Handle admin currency selection
function selectAdminCurrency(currency) {
    adminCurrentCurrency = currency;
    localStorage.setItem('selectedCurrency', currency);
    
    // Update active state
    document.querySelectorAll('.admin-currency-option').forEach(option => {
        option.classList.remove('active');
    });
    document.querySelector(`[data-currency="${currency}"]`).classList.add('active');
    
    // Update all admin prices
    updateAdminCurrencyDisplay();
}

// Fetch admin exchange rates from API
async function fetchAdminExchangeRates() {
    try {
        const response = await fetch('https://api.exchangerate-api.com/v4/latest/USD');
        const data = await response.json();
        
        // Update admin exchange rates
        Object.assign(adminExchangeRates, data.rates);
        
        // Update admin currency display
        updateAdminCurrencyDisplay();
        
        console.log('Admin exchange rates updated successfully');
    } catch (error) {
        console.log('Using fallback admin exchange rates');
        console.log('API Error:', error);
    }
}

// Initialize admin currency converter on page load
document.addEventListener('DOMContentLoaded', function() {
    initAdminCurrencyConverter();
    fetchAdminExchangeRates();
});

function initAdminCurrencyConverter() {
    // Set initial currency selection
    const currencyOption = document.querySelector(`[data-currency="${adminCurrentCurrency}"]`);
    if (currencyOption) {
        currencyOption.classList.add('active');
    }
    
    // Add click handlers to admin currency options
    document.querySelectorAll('.admin-currency-option').forEach(option => {
        option.addEventListener('click', function() {
            selectAdminCurrency(this.dataset.currency);
        });
    });
    
    // Initialize admin price displays
    updateAdminCurrencyDisplay();
}
</script>
{% endblock %}
