{% extends 'admin/admin/admin_base.html.twig' %}

{% block title %}Enrollment Management{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-users me-2"></i>
                        All Enrollments
                        <span class="badge bg-primary ms-2">{{ enrollments|length }}</span>
                    </h5>
                </div>
                <div class="card-body">
                    {% if enrollments|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Student</th>
                                        <th>Course</th>
                                        <th>Status</th>
                                        <th>Progress</th>
                                        <th>Enrolled Date</th>
                                        <th>Completed Date</th>
                                        <th>IP Address</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for enrollment in enrollments %}
                                        <tr>
                                            <td>{{ enrollment.id }}</td>
                                            <td>
                                                {% if enrollment.user %}
                                                    {{ enrollment.user.fullName|default('N/A') }}
                                                    <small class="text-muted d-block">{{ enrollment.user.email }}</small>
                                                {% else %}
                                                    N/A
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if enrollment.course %}
                                                    {{ enrollment.course.title }}
                                                {% else %}
                                                    N/A
                                                {% endif %}
                                            </td>
                                            <td>
                                                <span class="badge bg-{{ enrollment.status == 'active' ? 'success' : 'secondary' }}">
                                                    {{ enrollment.status|capitalize }}
                                                </span>
                                            </td>
                                            <td>
                                                <div class="progress" style="width: 100px; height: 8px; background: #e9ecef; border-radius: 4px;">
                                                    <div class="progress-bar" style="width: {{ enrollment.progress }}%; height: 100%; background: linear-gradient(90deg, #28a745, #20c997); border-radius: 4px;"></div>
                                                </div>
                                                <small class="text-muted">{{ enrollment.progress|round }}%</small>
                                            </td>
                                            <td>{{ enrollment.enrolledAt ? enrollment.enrolledAt|date('Y-m-d H:i') : 'N/A' }}</td>
                                            <td>{{ enrollment.completedAt ? enrollment.completedAt|date('Y-m-d H:i') : 'Not completed' }}</td>
                                            <td>
                                                <code class="text-muted">{{ enrollment.ipAddress|default('N/A') }}</code>
                                            </td>
                                            <td>
                                                <form method="post" action="{{ path('app_admin_enrollment_delete', {'id': enrollment.id}) }}" onsubmit="return confirm('Are you sure you want to delete this enrollment?')">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="text-center py-5">
                            <i class="fas fa-users fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No enrollments found</h5>
                            <p class="text-muted">Students have not enrolled in any courses yet.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.table th {
    background-color: #f8f9fa;
    font-weight: 600;
    border-top: none;
}

.progress {
    position: relative;
}

.table-hover tbody tr:hover {
    background-color: #f8f9fa;
}

.badge {
    font-size: 0.75rem;
}

.btn-sm {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
}
</style>
{% endblock %}
