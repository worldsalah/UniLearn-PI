{% extends 'admin/base_admin.html.twig' %}

{% block title %}User Details - {{ user.fullName }} - Admin{% endblock %}

{% block admin_content %}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-2">User Details</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="{{ path('app_admin_users_index') }}">Users</a></li>
                        <li class="breadcrumb-item active">{{ user.fullName }}</li>
                    </ol>
                </nav>
            </div>
            <a href="{{ path('app_admin_users_index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>Back to Users
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- User Profile Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body text-center p-4">
                <!-- Avatar -->
                <div class="mb-4">
                    <div class="avatar-xl mx-auto mb-3" style="width: 120px; height: 120px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 3rem; font-weight: 600;">
                        {{ user.fullName|first|upper }}
                    </div>
                </div>
                
                <!-- Name & Role -->
                <h4 class="mb-1">{{ user.fullName }}</h4>
                <p class="text-muted mb-3">{{ user.email }}</p>
                
                <!-- Status Badge -->
                <div class="mb-3">
                    {% if user.status == 'active' %}
                        <span class="badge bg-success-subtle text-success px-3 py-2">
                            <i class="bi bi-check-circle me-1"></i>Active
                        </span>
                    {% else %}
                        <span class="badge bg-warning-subtle text-warning px-3 py-2">
                            <i class="bi bi-pause-circle me-1"></i>Inactive
                        </span>
                    {% endif %}
                </div>
                
                <!-- Role Badge -->
                <div class="mb-4">
                    {% set roleColors = {'ADMIN': 'danger', 'INSTRUCTOR': 'success', 'STUDENT': 'primary'} %}
                    {% set roleColor = roleColors[user.role.name|upper]|default('secondary') %}
                    <span class="badge bg-{{ roleColor }}-subtle text-{{ roleColor }} px-3 py-2">
                        <i class="bi bi-person-badge me-1"></i>{{ user.role.name|capitalize }}
                    </span>
                </div>
                
                <!-- Action Buttons -->
                <div class="d-grid gap-2">
                    <a href="{{ path('app_admin_student_edit', {'id': user.id}) }}" class="btn btn-primary">
                        <i class="bi bi-pencil me-2"></i>Edit User
                    </a>
                    <form method="post" action="{{ path('app_admin_user_toggle_status', {'id': user.id}) }}">
                        <button type="submit" class="btn {% if user.status == 'active' %}btn-warning{% else %}btn-success{% endif %} w-100"
                                onclick="return confirm('Are you sure you want to {{ user.status == 'active' ? 'deactivate' : 'activate' }} this user?')">
                            <i class="bi bi-{% if user.status == 'active' %}pause{% else %}play{% endif %}-circle me-2"></i>
                            {{ user.status == 'active' ? 'Deactivate' : 'Activate' }} User
                        </button>
                    </form>
                    <form method="post" action="{{ path('app_admin_user_delete', {'id': user.id}) }}">
                        <button type="submit" class="btn btn-outline-danger w-100"
                                onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.')">
                            <i class="bi bi-trash me-2"></i>Delete User
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <!-- User Details -->
    <div class="col-lg-8">
        <!-- Statistics Cards -->
        <div class="row g-4 mb-4">
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm bg-white h-100">
                    <div class="card-body text-center">
                        <div class="feature-icon bg-primary-subtle text-primary rounded-circle mb-3 mx-auto" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-book fs-4"></i>
                        </div>
                        <h3 class="mb-1">{{ courseCount }}</h3>
                        <p class="text-muted mb-0">Courses</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm bg-white h-100">
                    <div class="card-body text-center">
                        <div class="feature-icon bg-success-subtle text-success rounded-circle mb-3 mx-auto" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-trophy fs-4"></i>
                        </div>
                        <h3 class="mb-1">{{ quizResultCount }}</h3>
                        <p class="text-muted mb-0">Quiz Results</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm bg-white h-100">
                    <div class="card-body text-center">
                        <div class="feature-icon bg-warning-subtle text-warning rounded-circle mb-3 mx-auto" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-calendar3 fs-4"></i>
                        </div>
                        <h3 class="mb-1">{{ user.createdAt|date('Y') }}</h3>
                        <p class="text-muted mb-0">Member Since</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- User Information Card -->
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>User Information</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <small class="text-muted text-uppercase fw-semibold">Full Name</small>
                            <p class="mb-0 fw-medium">{{ user.fullName }}</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <small class="text-muted text-uppercase fw-semibold">Email Address</small>
                            <p class="mb-0 fw-medium">
                                <a href="mailto:{{ user.email }}" class="text-decoration-none">{{ user.email }}</a>
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <small class="text-muted text-uppercase fw-semibold">Role</small>
                            <p class="mb-0 fw-medium">{{ user.role.name|capitalize }}</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <small class="text-muted text-uppercase fw-semibold">Status</small>
                            <p class="mb-0 fw-medium">
                                {% if user.status == 'active' %}
                                    <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                                {% else %}
                                    <span class="text-warning"><i class="bi bi-pause-circle-fill me-1"></i>Inactive</span>
                                {% endif %}
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <small class="text-muted text-uppercase fw-semibold">Registration Date</small>
                            <p class="mb-0 fw-medium">{{ user.createdAt|date('F j, Y') }} at {{ user.createdAt|date('g:i A') }}</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <small class="text-muted text-uppercase fw-semibold">User ID</small>
                            <p class="mb-0 fw-medium">#{{ user.id }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
