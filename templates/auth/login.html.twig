{% extends 'front_base.html.twig' %}

{% block title %}Sign In - Unilearn{% endblock %}

{% block body %}
<!-- **************** MAIN CONTENT START **************** -->
<main>

<!-- =======================
Page Banner START -->
<section class="bg-primary bg-opacity-10 py-5">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="text-center">
                    <h1 class="mb-3">Welcome <span class="text-primary">Back</span></h1>
                    <p class="lead mb-0">Sign in to access your courses and continue learning</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- =======================
Page Banner END -->

<!-- =======================
Login START -->
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-lg-5">
                        <div class="text-center mb-4">
                            <h4 class="mb-2">Sign In</h4>
                            <p class="mb-0 small text-muted">Enter your credentials to access your account</p>
                        </div>
                        
                        <form method="post">
                            {% if error %}
                                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                            {% endif %}
                            
                            {% if app.user %}
                                <div class="mb-3">
                                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
                                </div>
                            {% endif %}
                            
                            <div class="mb-3">
                                <label class="form-label" for="email">Email address</label>
                                <input type="email" value="{{ last_email }}" name="email" id="email" class="form-control" placeholder="john@example.com" autocomplete="email" required autofocus>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label" for="password">Password</label>
                                <div class="input-group">
                                    <input type="password" name="password" id="password" class="form-control" placeholder="Enter your password" autocomplete="current-password" required>
                                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="rememberMe" name="_remember_me">
                                    <label class="form-check-label" for="rememberMe">
                                        Remember me
                                    </label>
                                </div>
                                <a href="{{ path('app_forgot_password') }}" class="text-primary text-decoration-none">Forgot password?</a>
                            </div>
                            
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                            
                            <button type="submit" class="btn btn-primary w-100 mb-3">Sign In</button>
                            
                            <div class="text-center">
                                <p class="mb-0">Don't have an account? <a href="{{ path('app_register') }}" class="text-primary text-decoration-none">Sign up</a></p>
                            </div>
                        </form>
                        
                        <div class="divider my-4">
                            <span class="px-3 bg-white text-muted small">OR</span>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-primary" type="button">
                                <i class="fab fa-google me-2"></i>Continue with Google
                            </button>
                            <button class="btn btn-outline-primary" type="button">
                                <i class="fab fa-facebook-f me-2"></i>Continue with Facebook
                            </button>
                            <button class="btn btn-outline-primary" type="button">
                                <i class="fab fa-linkedin-in me-2"></i>Continue with LinkedIn
                            </button>
                            <button class="btn btn-outline-success" type="button" id="toggleFaceLogin">
                                <i class="fas fa-fingerprint me-2"></i>Login with Face Recognition
                            </button>
                        </div>

                        <!-- Face Login Section -->
                        <div id="faceLoginSection" class="d-none mt-4">
                            <div class="card border-success">
                                <div class="card-header bg-success bg-opacity-10 text-success">
                                    <i class="fas fa-camera me-2"></i>Face Recognition Login
                                </div>
                                <div class="card-body">
                                    <p class="text-muted small mb-3">Enter your email above, complete reCAPTCHA, then verify your face to login.</p>
                                    
                                    <!-- reCAPTCHA -->
                                    <div class="mb-3">
                                        <div class="g-recaptcha" data-sitekey="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI" data-callback="onRecaptchaSuccess"></div>
                                        <small class="text-danger d-none" id="recaptchaError">Please complete the security check</small>
                                    </div>
                                    
                                    <div class="text-center">
                                        <div class="position-relative mb-3" style="max-width: 400px; margin: 0 auto;">
                                            <video id="faceLoginVideo" width="100%" height="300" autoplay playsinline 
                                                   style="border-radius: 8px; background: #000;"></video>
                                            <canvas id="faceLoginCanvas" width="640" height="480" 
                                                    style="border-radius: 8px; background: #f8f9fa; max-width: 100%; display: none;"></canvas>
                                        </div>
                                        <button type="button" id="startFaceLogin" class="btn btn-primary mb-2">
                                            <i class="fas fa-video me-2"></i>Start Camera
                                        </button>
                                        <button type="button" id="captureFaceLogin" class="btn btn-success d-none mb-2" disabled>
                                            <i class="fas fa-fingerprint me-2"></i>Verify Face
                                        </button>
                                        <div id="faceLoginStatus" class="small text-muted"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- =======================
Login END -->

</main>
<!-- **************** MAIN CONTENT END **************** -->

{% include 'components/footer.html.twig' %}

<script>
/**
 * Face Login JavaScript - Inline for login page
 */
if (typeof FaceAuth === 'undefined') {
    class FaceAuth {
        constructor() {
            this.video = null;
            this.canvas = null;
            this.stream = null;
            this.isInitialized = false;
        }

        async initWebcam(videoElementId, canvasElementId) {
            this.video = document.getElementById(videoElementId);
            this.canvas = document.getElementById(canvasElementId);

            if (!this.video || !this.canvas) {
                console.error('Video or canvas element not found');
                return false;
            }

            try {
                this.stream = await navigator.mediaDevices.getUserMedia({
                    video: { width: { ideal: 640 }, height: { ideal: 480 }, facingMode: 'user' },
                    audio: false
                });

                this.video.srcObject = this.stream;
                this.video.style.display = 'block';
                this.canvas.style.display = 'none';

                return new Promise((resolve) => {
                    const timeout = setTimeout(() => {
                        this.isInitialized = true;
                        resolve(true);
                    }, 3000);

                    this.video.onloadedmetadata = () => {
                        clearTimeout(timeout);
                        this.video.play().then(() => {
                            this.isInitialized = true;
                            resolve(true);
                        }).catch(() => resolve(false));
                    };
                });
            } catch (error) {
                console.error('Error accessing webcam:', error);
                this.isInitialized = false;
                return false;
            }
        }

        captureImage() {
            if (!this.isInitialized || !this.video || !this.canvas) {
                alert('Camera not initialized.');
                return null;
            }

            const context = this.canvas.getContext('2d');
            this.canvas.width = this.video.videoWidth || 640;
            this.canvas.height = this.video.videoHeight || 480;
            context.drawImage(this.video, 0, 0, this.canvas.width, this.canvas.height);
            
            this.video.style.display = 'none';
            this.canvas.style.display = 'block';

            return this.canvas.toDataURL('image/jpeg', 0.9);
        }

        stopWebcam() {
            if (this.stream) {
                this.stream.getTracks().forEach(track => track.stop());
                this.stream = null;
            }
            if (this.video) {
                this.video.srcObject = null;
            }
            this.isInitialized = false;
        }
    }

    window.FaceAuth = FaceAuth;
}

let recaptchaToken = null;

function onRecaptchaSuccess(token) {
    recaptchaToken = token;
    document.getElementById('recaptchaError').classList.add('d-none');
    // Enable the capture button if camera is started
    const captureBtn = document.getElementById('captureFaceLogin');
    if (captureBtn && !captureBtn.classList.contains('d-none')) {
        captureBtn.disabled = false;
    }
}
window.onRecaptchaSuccess = onRecaptchaSuccess;

document.addEventListener('DOMContentLoaded', function() {
    const toggleBtn = document.getElementById('toggleFaceLogin');
    const faceLoginSection = document.getElementById('faceLoginSection');
    const startBtn = document.getElementById('startFaceLogin');
    const captureBtn = document.getElementById('captureFaceLogin');
    const statusDiv = document.getElementById('faceLoginStatus');
    
    if (!toggleBtn || !faceLoginSection) return;

    const faceAuth = new FaceAuth();
    let cameraStarted = false;

    // Toggle face login section
    toggleBtn.addEventListener('click', () => {
        // Check email is not empty before showing face login
        const emailInput = document.getElementById('inputEmail');
        if (!emailInput || !emailInput.value.trim()) {
            alert('Please enter your email address first.');
            if (emailInput) emailInput.focus();
            return;
        }
        
        faceLoginSection.classList.toggle('d-none');
        if (!faceLoginSection.classList.contains('d-none')) {
            statusDiv.textContent = 'Complete reCAPTCHA, then click "Start Camera"';
        } else {
            faceAuth.stopWebcam();
            cameraStarted = false;
        }
    });

    // Start camera
    startBtn.addEventListener('click', async () => {
        startBtn.disabled = true;
        startBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Starting...';
        statusDiv.textContent = 'Requesting camera access...';
        
        const success = await faceAuth.initWebcam('faceLoginVideo', 'faceLoginCanvas');
        if (success) {
            cameraStarted = true;
            startBtn.classList.add('d-none');
            captureBtn.classList.remove('d-none');
            // Only enable if reCAPTCHA is completed
            captureBtn.disabled = !recaptchaToken;
            statusDiv.textContent = recaptchaToken 
                ? 'Position your face and click "Verify Face"' 
                : 'Please complete reCAPTCHA first, then click "Verify Face"';
        } else {
            startBtn.disabled = false;
            startBtn.innerHTML = '<i class="fas fa-video me-2"></i>Start Camera';
            statusDiv.textContent = 'Could not access camera. Please check permissions.';
        }
    });

    // Capture and verify face
    captureBtn.addEventListener('click', async () => {
        if (!cameraStarted) {
            alert('Camera not ready.');
            return;
        }
        
        const emailInput = document.getElementById('email') || document.getElementById('inputEmail') || document.getElementById('faceEmail');
        const email = emailInput ? emailInput.value.trim() : '';
        if (!email) {
            alert('Please enter your email address first.');
            if (emailInput) emailInput.focus();
            return;
        }
        
        // Check reCAPTCHA
        if (!recaptchaToken) {
            document.getElementById('recaptchaError').classList.remove('d-none');
            alert('Please complete the security check (reCAPTCHA).');
            return;
        }
        
        captureBtn.disabled = true;
        captureBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Verifying...';
        statusDiv.textContent = 'Verifying your face...';
        
        const imageData = faceAuth.captureImage();
        if (!imageData) {
            captureBtn.disabled = false;
            captureBtn.innerHTML = '<i class="fas fa-fingerprint me-2"></i>Verify Face';
            statusDiv.textContent = 'Failed to capture image. Try again.';
            return;
        }

        // Send to server for verification
        try {
            // Read values directly at send time
            const emailInput = document.getElementById('inputEmail');
            const emailValue = emailInput ? emailInput.value.trim() : '';
            const tokenValue = window.recaptchaToken;
            
            // Debug: show values before sending
            alert('Debug: email=' + emailValue + ', recaptchaToken=' + (tokenValue ? 'present' : 'null'));
            
            const payload = { 
                image: imageData,
                email: emailValue,
                recaptchaToken: tokenValue
            };
            
            const jsonBody = JSON.stringify(payload);
            console.log('JSON body first 200 chars:', jsonBody.substring(0, 200));
            
            const response = await fetch('/face-auth/verify', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: jsonBody
            });

            if (response.redirected) {
                // Successfully authenticated
                window.location.href = response.url;
                return;
            }

            const data = await response.json();

            if (data.success) {
                statusDiv.innerHTML = '<span class="text-success"><i class="fas fa-check"></i> Success! Redirecting...</span>';
                if (data.redirect) {
                    window.location.href = data.redirect;
                }
            } else {
                statusDiv.innerHTML = '<span class="text-danger"><i class="fas fa-times"></i> ' + (data.error || 'Face not recognized') + '</span>';
                captureBtn.disabled = false;
                captureBtn.innerHTML = '<i class="fas fa-fingerprint me-2"></i>Verify Face';
                
                // Restart camera
                setTimeout(() => {
                    faceAuth.stopWebcam();
                    faceAuth.initWebcam('faceLoginVideo', 'faceLoginCanvas');
                }, 2000);
            }
        } catch (error) {
            console.error('Error:', error);
            statusDiv.innerHTML = '<span class="text-danger">Network error. Please try again.</span>';
            captureBtn.disabled = false;
            captureBtn.innerHTML = '<i class="fas fa-fingerprint me-2"></i>Verify Face';
        }
    });
});
</script>

<!-- Google reCAPTCHA -->
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
{% endblock %}
