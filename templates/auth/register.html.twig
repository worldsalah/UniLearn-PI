{% extends 'front_base.html.twig' %}

{% block title %}Sign Up - Unilearn{% endblock %}

{% block body %}
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<!-- **************** MAIN CONTENT START **************** -->
<main>

<!-- =======================
Page Banner START -->
<section class="bg-primary bg-opacity-10 py-5">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="text-center">
                    <h1 class="mb-3">Join <span class="text-primary">Unilearn</span></h1>
                    <p class="lead mb-0">Create your account and start your learning journey today</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- =======================
Page Banner END -->

<!-- =======================
Register START -->
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-lg-5">
                        <div class="text-center mb-4">
                            <h4 class="mb-2">Create Account</h4>
                            <p class="mb-0 small text-muted">Join thousands of learners worldwide</p>
                        </div>
                        
                        <form>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">First Name</label>
                                    <input type="text" class="form-control" placeholder="John" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Last Name</label>
                                    <input type="text" class="form-control" placeholder="Doe" required>
                                </div>
                                
                                <div class="col-12">
                                    <label class="form-label">Email address</label>
                                    <input type="email" class="form-control" placeholder="john@example.com" required>
                                </div>
                                
                                <div class="col-12">
                                    <label class="form-label">Password</label>
                                    <div class="input-group">
                                        <input type="password" class="form-control" placeholder="Create a strong password" required>
                                        <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                    <small class="text-muted">Password must be at least 8 characters long</small>
                                </div>
                                
                                <div class="col-12">
                                    <label class="form-label">Confirm Password</label>
                                    <div class="input-group">
                                        <input type="password" class="form-control" placeholder="Confirm your password" required>
                                        <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="col-12">
                                    <label class="form-label">Account Type</label>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="accountType" id="student" checked>
                                        <label class="form-check-label" for="student">
                                            <i class="fas fa-user-graduate me-2"></i>Student - I want to learn
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="accountType" id="instructor">
                                        <label class="form-check-label" for="instructor">
                                            <i class="fas fa-chalkboard-teacher me-2"></i>Instructor - I want to teach
                                        </label>
                                    </div>
                                </div>
                                
                                <div class="col-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="terms" required>
                                        <label class="form-check-label" for="terms">
                                            I agree to the <a href="#" class="text-primary">Terms of Service</a> and <a href="#" class="text-primary">Privacy Policy</a>
                                        </label>
                                    </div>
                                </div>
                                
                                <!-- Face Registration (Optional) -->
                                <div class="col-12">
                                    <div class="card border-info">
                                        <div class="card-header bg-info bg-opacity-10 text-info">
                                            <i class="fas fa-fingerprint me-2"></i>Face Recognition (Optional)
                                        </div>
                                        <div class="card-body">
                                            <p class="small text-muted mb-2">Enable face recognition for faster, password-free login in the future.</p>
                                            <button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#faceRegistrationModal">
                                                <i class="fas fa-camera me-2"></i>Register Face (Optional)
                                            </button>
                                            <input type="hidden" name="faceImage" id="faceImageInput">
                                            <div id="faceRegistrationStatus" class="mt-2 small d-none">
                                                <i class="fas fa-check-circle text-success me-1"></i>Face registered successfully!
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- reCAPTCHA -->
                                <div class="col-12">
                                    <div class="d-flex justify-content-center mb-3">
                                        <div class="g-recaptcha" data-sitekey="{{ google_recaptcha_site_key }}"></div>
                                    </div>
                                </div>
                                
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary w-100 mb-3">Create Account</button>
                                </div>
                                
                                <div class="col-12">
                                    <div class="text-center">
                                        <p class="mb-0">Already have an account? <a href="{{ path('app_login') }}" class="text-primary text-decoration-none">Sign in</a></p>
                                    </div>
                                </div>
                            </div>
                        </form>
                        
                        <div class="divider my-4">
                            <span class="px-3 bg-white text-muted small">OR</span>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <a href="{{ path('auth_google') }}" class="btn btn-outline-primary">
                                <i class="fab fa-google me-2"></i>Sign up with Google
                            </a>
                            <a href="{{ path('auth_facebook') }}" class="btn btn-outline-primary">
                                <i class="fab fa-facebook-f me-2"></i>Sign up with Facebook
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- =======================
Register END -->

</main>
<!-- **************** MAIN CONTENT END **************** -->

{% include 'components/footer.html.twig' %}

<!-- Face Registration Modal -->
<div class="modal fade" id="faceRegistrationModal" tabindex="-1" aria-labelledby="faceRegistrationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="faceRegistrationModalLabel">
                    <i class="fas fa-camera me-2"></i>Register Your Face
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    Position your face within the frame and ensure good lighting. This will be used for password-free login.
                </div>
                <div class="position-relative mb-3">
                    <video id="faceVideo" width="100%" height="400" autoplay playsinline 
                           style="border-radius: 8px; background: #000; display: none;"></video>
                    <canvas id="faceCanvas" width="640" height="480" 
                            style="border-radius: 8px; background: #f8f9fa; width: 100%; height: 400px;"></canvas>
                </div>
                <div class="text-center">
                    <button type="button" id="captureFaceBtn" class="btn btn-primary btn-lg">
                        <i class="fas fa-camera me-2"></i>Capture Face
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="{{ asset('js/face-auth.js') }}"></script>
<script>
// Handle face registration for new users
let registeredFaceImage = null;

document.addEventListener('DOMContentLoaded', function() {
    const captureBtn = document.getElementById('captureFaceBtn');
    const faceInput = document.getElementById('faceImageInput');
    const statusDiv = document.getElementById('faceRegistrationStatus');
    
    if (captureBtn) {
        captureBtn.addEventListener('click', function() {
            const imageData = window.FaceAuth.captureImage();
            if (imageData) {
                registeredFaceImage = imageData;
                faceInput.value = imageData;
                statusDiv.classList.remove('d-none');
                const modal = bootstrap.Modal.getInstance(document.getElementById('faceRegistrationModal'));
                modal.hide();
                window.FaceAuth.stopWebcam();
                alert('Face captured! Complete registration to enable face login.');
            }
        });
    }
});
</script>
{% endblock %}
