<script>
(function() {
    const chatbotWidget = document.getElementById('chatbot-widget');
    
    // Exit early if chatbot widget doesn't exist on this page
    if (!chatbotWidget) return;
    
    const chatbotToggle = document.getElementById('chatbot-toggle');
    const chatbotWindow = document.getElementById('chatbot-window');
    const chatbotClose = document.getElementById('chatbot-close');
    const chatbotClear = document.getElementById('chatbot-clear');
    const chatbotExport = document.getElementById('chatbot-export');
    const chatbotNotifications = document.getElementById('chatbot-notifications');
    const chatbotSearch = document.getElementById('chatbot-search');
    const chatbotSearchBar = document.getElementById('chatbot-search-bar');
    const chatbotSearchInput = document.getElementById('chatbot-search-input');
    const chatbotSearchCount = document.getElementById('chatbot-search-count');
    const chatbotSearchPrev = document.getElementById('chatbot-search-prev');
    const chatbotSearchNext = document.getElementById('chatbot-search-next');
    const chatbotSearchCloseBtn = document.getElementById('chatbot-search-close-btn');
    const chatbotPersonality = document.getElementById('chatbot-personality');
    const chatbotPersonalitySelector = document.getElementById('chatbot-personality-selector');
    const chatbotInput = document.getElementById('chatbot-input');
    const chatbotSend = document.getElementById('chatbot-send');
    const chatbotMessages = document.getElementById('chatbot-messages');
    const chatbotSuggestions = document.getElementById('chatbot-suggestions');
    const chatbotVoiceInput = document.getElementById('chatbot-voice-input');
    const chatbotStopSpeech = document.getElementById('chatbot-stop-speech');
    const chatbotAttachBtn = document.getElementById('chatbot-attach-btn');
    const chatbotFileInput = document.getElementById('chatbot-file-input');
    const chatbotAttachmentsPreview = document.getElementById('chatbot-attachments-preview');
    const typingIndicatorInput = document.getElementById('typing-indicator-input');

    let context = [];
    let isOpen = false;
    let currentLanguage = 'en';
    let isRecording = false;
    let mediaRecorder = null;
    let audioChunks = [];
    let synthesis = window.speechSynthesis;
    let currentUtterance = null;
    let attachments = []; // Store file attachments
    let typingTimeout = null; // For typing indicator
    
    // User preferences storage
    const PREFERENCES_KEY = 'unilearn_chatbot_preferences';
    let userPreferences = loadPreferences();
    
    const STORAGE_KEY = 'unilearn_chatbot_conversation';
    
    // Load user preferences
    function loadPreferences() {
        const saved = localStorage.getItem(PREFERENCES_KEY);
        if (saved) {
            try {
                return JSON.parse(saved);
            } catch (e) {
                return getDefaultPreferences();
            }
        }
        return getDefaultPreferences();
    }
    
    function getDefaultPreferences() {
        return {
            language: 'en',
            personality: 'friendly', // friendly, professional, tutor
            speechEnabled: true,
            speechRate: 1,
            speechPitch: 1,
            lastTopics: [],
            favoriteCourses: [],
            userName: null,
            visitCount: 0,
            firstVisit: new Date().toISOString()
        };
    }
    
    function savePreferences() {
        localStorage.setItem(PREFERENCES_KEY, JSON.stringify(userPreferences));
    }
    
    // Track topics user is interested in
    function trackTopic(topic) {
        if (!userPreferences.lastTopics.includes(topic)) {
            userPreferences.lastTopics.unshift(topic);
            if (userPreferences.lastTopics.length > 10) {
                userPreferences.lastTopics.pop();
            }
            savePreferences();
        }
    }
    
    // Track favorite courses
    function trackFavoriteCourse(courseId, courseTitle) {
        if (!userPreferences.favoriteCourses.find(c => c.id === courseId)) {
            userPreferences.favoriteCourses.push({ id: courseId, title: courseTitle, timestamp: Date.now() });
            if (userPreferences.favoriteCourses.length > 5) {
                userPreferences.favoriteCourses.shift();
            }
            savePreferences();
        }
    }
    
    // Increment visit count
    function trackVisit() {
        userPreferences.visitCount++;
        savePreferences();
    }
    
    // Get personalized greeting
    function getPersonalizedGreeting() {
        const hour = new Date().getHours();
        let timeGreeting = 'Hello';
        
        if (hour < 12) timeGreeting = 'Good morning';
        else if (hour < 18) timeGreeting = 'Good afternoon';
        else timeGreeting = 'Good evening';
        
        let greeting = translations[currentLanguage].welcome;
        
        if (userPreferences.visitCount > 1) {
            const name = userPreferences.userName ? `, ${userPreferences.userName}` : '';
            greeting = `${timeGreeting}${name}! 👋 Welcome back to UniLearn. `;
            
            if (userPreferences.lastTopics.length > 0) {
                greeting += `Last time you were interested in: ${userPreferences.lastTopics[0]}. Would you like to continue?`;
            }
        }
        
        return greeting;
    }
    
    // Extract topic keywords from message
    function extractTopicKeywords(message) {
        const keywords = [];
        const topicPatterns = [
            /course[s]?\s+(?:about\s+)?(\w+)/gi,
            /learn\s+(\w+)/gi,
            /study\s+(\w+)/gi,
            /programming\s+(\w+)/gi,
            /(\w+)\s+programming/gi,
            /(\w+)\s+course/gi,
            /about\s+(\w+)/gi
        ];
        
        topicPatterns.forEach(pattern => {
            let match;
            while ((match = pattern.exec(message)) !== null) {
                if (match[1] && match[1].length > 2) {
                    keywords.push(match[1].toLowerCase());
                }
            }
        });
        
        // Also check for specific keywords
        const specificTopics = ['programming', 'python', 'javascript', 'java', 'react', 'web development', 
                                'data science', 'machine learning', 'design', 'marketing', 'business'];
        specificTopics.forEach(topic => {
            if (message.toLowerCase().includes(topic)) {
                keywords.push(topic);
            }
        });
        
        return [...new Set(keywords)]; // Remove duplicates
    }
    
    // Language translations
    const translations = {
        en: {
            welcome: "Hello! 👋 I'm your UniLearn AI Assistant. How can I help you today?",
            placeholder: "Type your message...",
            hint: 'Press Enter to send • Try "search programming courses"',
            suggestions: ["What courses are available?", "How do I enroll?", "Popular courses", "Programming courses"]
        },
        fr: {
            welcome: "Bonjour! 👋 Je suis votre assistant AI UniLearn. Comment puis-je vous aider?",
            placeholder: "Tapez votre message...",
            hint: 'Appuyez sur Entrée • Essayez "chercher cours programmation"',
            suggestions: ["Quels cours sont disponibles?", "Comment s'inscrire?", "Cours populaires", "Cours de programmation"]
        },
        ar: {
            welcome: "مرحبا! 👋 أنا مساعدك الذكي UniLearn. كيف يمكنني مساعدتك?",
            placeholder: "اكتب رسالتك...",
            hint: 'اضغط Enter • جرب "ابحث عن دورات البرمجة"',
            suggestions: ["ما الدورات المتاحة?", "كيف أسجل?", "دورات شائعة", "دورات برمجة"]
        }
    };

    // Start recording using MediaRecorder (Groq API)
    function startRecording() {
        if (isRecording) return;
        
        navigator.mediaDevices.getUserMedia({ audio: true })
            .then(stream => {
                isRecording = true;
                chatbotVoiceInput.classList.add('recording');
                audioChunks = [];
                
                mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm' });
                
                mediaRecorder.ondataavailable = event => {
                    audioChunks.push(event.data);
                };
                
                mediaRecorder.onstop = async () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                    await sendAudioToServer(audioBlob);
                    
                    // Stop all tracks
                    stream.getTracks().forEach(track => track.stop());
                };
                
                mediaRecorder.start();
            })
            .catch(err => {
                console.error('Microphone error:', err);
                addMessage('⚠️ Could not access microphone. Please check permissions.', 'bot');
            });
    }
    
    function stopRecording() {
        isRecording = false;
        chatbotVoiceInput.classList.remove('recording');
        
        if (mediaRecorder && mediaRecorder.state !== 'inactive') {
            mediaRecorder.stop();
        }
    }
    
    // Send audio to server for transcription
    async function sendAudioToServer(audioBlob) {
        try {
            const reader = new FileReader();
            reader.onload = async function() {
                const base64 = reader.result.split(',')[1];
                
                const response = await fetch('/chatbot/transcribe', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        audio: base64,
                        language: currentLanguage
                    })
                });
                
                const data = await response.json();
                
                if (data.success && data.text) {
                    chatbotInput.value = data.text;
                    sendMessage();
                } else {
                    addMessage('⚠️ Could not transcribe audio: ' + (data.error || 'Unknown error'), 'bot');
                }
            };
            reader.readAsDataURL(audioBlob);
        } catch (error) {
            console.error('Transcription error:', error);
            addMessage('⚠️ Transcription failed. Please try again or type your message.', 'bot');
        }
    }

    // Load saved conversation on page load
    function loadConversation() {
        if (!chatbotMessages) return;
        
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
            try {
                const data = JSON.parse(saved);
                context = data.context || [];
                currentLanguage = data.language || 'en';
                
                if (data.messages && data.messages.length > 0) {
                    chatbotMessages.innerHTML = '';
                    
                    data.messages.forEach(msg => {
                        if (msg.type === 'course-card' || msg.type === 'instructor-card') {
                            addCardToDOM(msg);
                        } else {
                            addMessageToDOM(msg.text, msg.role, false);
                        }
                    });
                    
                    // Show suggestions after loading
                    showSuggestions();
                }
            } catch (e) {
                console.error('Error loading conversation:', e);
            }
        }
    }

    // Save conversation to localStorage
    function saveConversation() {
        const messages = [];
        chatbotMessages.querySelectorAll('.chatbot-message, .chatbot-course-card, .chatbot-instructor-card').forEach(msgDiv => {
            if (msgDiv.classList.contains('chatbot-course-card')) {
                messages.push({
                    type: 'course-card',
                    html: msgDiv.outerHTML
                });
            } else if (msgDiv.classList.contains('chatbot-instructor-card')) {
                messages.push({
                    type: 'instructor-card',
                    html: msgDiv.outerHTML
                });
            } else {
                const isUser = msgDiv.classList.contains('chatbot-message-user');
                const bubble = msgDiv.querySelector('.chatbot-bubble p');
                if (bubble) {
                    messages.push({
                        role: isUser ? 'user' : 'bot',
                        text: bubble.textContent
                    });
                }
            }
        });
        
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
            context: context,
            messages: messages,
            language: currentLanguage,
            timestamp: Date.now()
        }));
    }

    // Clear conversation
    function clearConversation() {
        context = [];
        localStorage.removeItem(STORAGE_KEY);
        chatbotMessages.innerHTML = `
            <div class="chatbot-message chatbot-message-bot">
                <div class="chatbot-avatar">
                    <i class="fas fa-robot"></i>
                </div>
                <div class="chatbot-bubble">
                    <p>${translations[currentLanguage].welcome}</p>
                </div>
            </div>
            <div class="chatbot-quick-actions">
                <button class="quick-action-btn" data-action="browse-courses">
                    <i class="fas fa-book"></i>
                    <span>Browse Courses</span>
                </button>
                <button class="quick-action-btn" data-action="find-instructor">
                    <i class="fas fa-chalkboard-teacher"></i>
                    <span>Find Instructor</span>
                </button>
                <button class="quick-action-btn" data-action="book-session">
                    <i class="fas fa-calendar-check"></i>
                    <span>Book Session</span>
                </button>
                <button class="quick-action-btn" data-action="marketplace">
                    <i class="fas fa-shopping-cart"></i>
                    <span>Marketplace</span>
                </button>
                <button class="quick-action-btn" data-action="my-courses">
                    <i class="fas fa-graduation-cap"></i>
                    <span>My Courses</span>
                </button>
                <button class="quick-action-btn" data-action="support">
                    <i class="fas fa-headset"></i>
                    <span>Get Support</span>
                </button>
            </div>
        `;
        showSuggestions();
    }
    
    // Show suggestions
    function showSuggestions() {
        const suggestions = translations[currentLanguage].suggestions;
        const chipsHtml = suggestions.map(s => 
            `<button class="suggestion-chip" data-question="${s}">${s}</button>`
        ).join('');
        
        const suggestionsDiv = document.createElement('div');
        suggestionsDiv.className = 'chatbot-suggestions visible';
        suggestionsDiv.innerHTML = `
            <div class="suggestions-label">Suggested questions:</div>
            <div class="suggestions-chips">${chipsHtml}</div>
        `;
        chatbotMessages.appendChild(suggestionsDiv);
        chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
    }

    // Initialize
    loadConversation();
    trackVisit();
    
    // Update welcome message with personalized greeting
    if (chatbotMessages) {
        const welcomeBubble = chatbotMessages.querySelector('.chatbot-message-bot .chatbot-bubble p');
        if (welcomeBubble) {
            welcomeBubble.textContent = getPersonalizedGreeting();
        }
    }
    
    // Scroll to bottom after loading conversation
    setTimeout(() => {
        if (chatbotMessages) {
            chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
        }
    }, 100);

    // Toggle chat window
    chatbotToggle.addEventListener('click', () => {
        isOpen = !isOpen;
        chatbotWindow.style.display = isOpen ? 'flex' : 'none';
        if (isOpen) {
            chatbotInput.focus();
            // Hide badge
            document.getElementById('chatbot-badge').style.display = 'none';
            // Scroll to bottom of messages
            setTimeout(() => {
                chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
            }, 100);
        }
    });

    chatbotClose.addEventListener('click', () => {
        isOpen = false;
        chatbotWindow.style.display = 'none';
    });
    
