    // Speak text using text-to-speech
    function speakText(text) {
        if (!synthesis) return;
        
        synthesis.cancel(); // Cancel any ongoing speech
        
        currentUtterance = new SpeechSynthesisUtterance(text);
        currentUtterance.lang = currentLanguage === 'fr' ? 'fr-FR' : currentLanguage === 'ar' ? 'ar-SA' : 'en-US';
        currentUtterance.rate = 1;
        currentUtterance.pitch = 1;
        
        currentUtterance.onstart = () => {
            showStopButton();
        };
        
        currentUtterance.onend = () => {
            hideStopButton();
        };
        
        currentUtterance.onerror = () => {
            hideStopButton();
        };
        
        synthesis.speak(currentUtterance);
    }

    // Quick action buttons
    chatbotMessages.addEventListener('click', (e) => {
        // Quick action buttons
        const quickBtn = e.target.closest('.quick-action-btn');
        if (quickBtn) {
            const action = quickBtn.dataset.action;
            handleQuickAction(action);
            return;
        }
        
        // Suggestion chips
        const chip = e.target.closest('.suggestion-chip');
        if (chip) {
            chatbotInput.value = chip.dataset.question;
            sendMessage();
            return;
        }
        
        // Course card buttons
        const courseBtn = e.target.closest('.chatbot-course-btn');
        if (courseBtn) {
            const action = courseBtn.dataset.action;
            const courseId = courseBtn.dataset.courseId;
            handleCourseAction(action, courseId);
            return;
        }
    });
    
    // Handle quick actions
    function handleQuickAction(action) {
        const actions = {
            'browse-courses': { text: 'Show me available courses', path: '/courses' },
            'find-instructor': { text: 'Help me find an instructor', path: '/instructors' },
            'book-session': { text: 'I want to book a session', path: '/booking' },
            'marketplace': { text: 'Take me to the marketplace', path: '/marketplace' },
            'my-courses': { text: 'Show my enrolled courses', path: '/enrollment/my-courses' },
            'support': { text: 'I need help and support', path: '/help-center' }
        };
        
        const actionData = actions[action];
        if (actionData) {
            chatbotInput.value = actionData.text;
            sendMessage();
        }
    }
    
    // Handle course actions
    function handleCourseAction(action, courseId) {
        switch (action) {
            case 'view':
                window.location.href = `/courses/${courseId}`;
                break;
            case 'enroll':
                addMessage('Enrolling you in this course...', 'bot');
                window.location.href = `/courses/${courseId}/enroll`;
                break;
            case 'add-cart':
                addMessage('Adding to cart...', 'bot');
                // Add to cart logic
                fetch(`/cart/add/${courseId}`, { method: 'POST' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            addMessage('✅ Course added to cart!', 'bot');
                        }
                    });
                break;
        }
    }

    // Send message
    async function sendMessage() {
        const message = chatbotInput.value.trim();
        if (!message && attachments.length === 0) return;

        // Hide suggestions after first message
        const suggestions = chatbotMessages.querySelector('.chatbot-suggestions');
        if (suggestions) suggestions.remove();

        // Add user message with attachments
        addMessage(message, 'user', attachments);
        
        // Track topic from message
        const topicKeywords = extractTopicKeywords(message);
        if (topicKeywords.length > 0) {
            topicKeywords.forEach(topic => trackTopic(topic));
        }
        
        // Prepare form data for file uploads
        const formData = new FormData();
        formData.append('message', message);
        formData.append('context', JSON.stringify(context));
        formData.append('language', currentLanguage);
        formData.append('personality', userPreferences.personality || 'friendly');
        
        // Add attachments
        if (attachments.length > 0) {
            attachments.forEach((att, index) => {
                formData.append(`attachments[${index}]`, att.file);
            });
            formData.append('attachmentInfo', JSON.stringify(attachments.map(a => ({
                name: a.name,
                size: a.size,
                type: a.type
            }))));
        }
        
        // Clear input and attachments
        chatbotInput.value = '';
        attachments = [];
        chatbotAttachmentsPreview.innerHTML = '';

        // Save conversation
        saveConversation();

        // Show typing indicator
        showTyping();

        try {
            const response = await fetch('/chatbot/message', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            // Remove typing indicator
            removeTyping();

            if (data.success) {
                // Check if response contains course data
                if (data.courses && data.courses.length > 0) {
                    addMessage(data.message, 'bot');
                    data.courses.forEach(course => addCourseCard(course));
                } else if (data.instructors && data.instructors.length > 0) {
                    addMessage(data.message, 'bot');
                    data.instructors.forEach(instructor => addInstructorCard(instructor));
                } else if (data.sessions && data.sessions.length > 0) {
                    addMessage(data.message, 'bot');
                    data.sessions.forEach(session => addSessionCard(session));
                } else {
                    addMessage(data.message, 'bot');
                }
                
                // Update context
                context.push({ role: 'user', content: message });
                context.push({ role: 'assistant', content: data.message });
                if (context.length > 20) {
                    context = context.slice(-20);
                }
                
                // Save conversation
                saveConversation();
                
                // Handle actions
                if (data.action) {
                    handleAction(data.action);
                }
                
                // Display action result if present (AI agent executed an action)
                if (data.action_result) {
                    const result = data.action_result;
                    if (result.success) {
                        // Show success message with checkmark
                        addMessage(`✅ ${result.message}`, 'bot');
                    } else {
                        // Show error message
                        addMessage(`❌ ${result.error}`, 'bot');
                    }
                    saveConversation();
                }
                
                // Text-to-speech for bot response
                if (synthesis) {
                    speakText(data.message);
                }
                
                // Notify user if chat is closed
                notifyBotResponse(data.message);
                
                // Show suggestions after response
                setTimeout(showSuggestions, 1000);
            } else {
                addMessage(data.error || 'Sorry, I encountered an error. Please try again.', 'bot');
                saveConversation();
            }
        } catch (error) {
            removeTyping();
            addMessage('Sorry, I encountered an error. Please try again.', 'bot');
            console.error('Chatbot error:', error);
            saveConversation();
        }
    }

    // Handle actions from AI
    function handleAction(action) {
        if (!action || !action.type) return;
        
        const executableActions = ['update_profile', 'enroll_course', 'unenroll_course', 'add_favorite', 'remove_favorite', 'search_content', 'get_recommendations'];
        
        // Check if this is an executable action that was already processed by backend
        if (executableActions.includes(action.type)) {
            // These actions are executed server-side, just show the result
            // The action_result is already in the response
            return;
        }
        
        switch (action.type) {
            case 'navigate':
                // Handle both array format ["/profile"] and object format {"path": "/profile"}
                let path = '/';
                if (Array.isArray(action.params)) {
                    path = action.params[0] || '/';
                } else if (typeof action.params === 'object' && action.params !== null) {
                    path = action.params.path || action.params.route || '/';
                } else if (typeof action.params === 'string') {
                    path = action.params;
                }
                
                // Ensure path starts with /
                if (path && !path.startsWith('/')) {
                    path = '/' + path;
                }
                
                console.log('Navigating to:', path);
                setTimeout(() => {
                    addMessage('🔄 Redirecting you...', 'bot');
                    saveConversation();
                    setTimeout(() => {
                        window.location.href = path;
                    }, 1000);
                }, 500);
                break;
                
            case 'search':
                const searchType = typeof action.params === 'object' ? action.params.type : (action.params[0] || 'courses');
                const searchQuery = typeof action.params === 'object' ? action.params.query : (action.params[1] || '');
                if (searchType === 'course' || searchType === 'courses') {
                    saveConversation();
                    window.location.href = '/courses?search=' + encodeURIComponent(searchQuery);
                }
                break;
                
            case 'filter':
                const filterType = action.params[0] || 'category';
                const filterValue = action.params[1] || '';
                if (filterType === 'category') {
                    saveConversation();
                    window.location.href = '/courses?category=' + encodeURIComponent(filterValue);
                }
                break;
                
            case 'enroll':
                const courseId = action.params[0] || action.params.courseId;
                if (courseId) {
                    saveConversation();
                    window.location.href = `/courses/${courseId}/enroll`;
                }
                break;
        }
    }
    
    // Handle action confirmation dialog
    function showActionConfirmation(action, params) {
        const actionDescriptions = {
            'update_profile': `Update your ${params.field} to "${params.value}"?`,
            'enroll_course': `Enroll in this course?`,
            'unenroll_course': `Unenroll from this course?`,
            'add_favorite': `Add this course to favorites?`,
            'remove_favorite': `Remove this course from favorites?`
        };
        
        const description = actionDescriptions[action] || `Execute action: ${action}?`;
        
        return confirm(description);
    }

    chatbotSend.addEventListener('click', sendMessage);
    chatbotInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
            sendMessage();
        }
    });

    // Add message to DOM only
    function addMessageToDOM(text, role, attachments = [], scroll = true) {
        const messageDiv = document.createElement('div');
        messageDiv.className = `chatbot-message chatbot-message-${role}`;
        
        let attachmentsHtml = '';
        if (attachments && attachments.length > 0) {
            attachmentsHtml = attachments.map(att => {
                const icon = getFileIcon(att.type);
                const isImage = att.type && att.type.startsWith('image/');
                if (isImage) {
                    return `
                        <div class="chatbot-message-attachment">
                            <i class="fas fa-file-image"></i>
                            <div class="attachment-info">
                                <div class="attachment-name">${escapeHtml(att.name)}</div>
                                <div class="attachment-size">${formatFileSize(att.size)}</div>
                            </div>
                        </div>
                    `;
                }
                return `
                    <div class="chatbot-message-attachment">
                        <i class="fas ${icon}"></i>
                        <div class="attachment-info">
                            <div class="attachment-name">${escapeHtml(att.name)}</div>
                            <div class="attachment-size">${formatFileSize(att.size)}</div>
                        </div>
                    </div>
                `;
            }).join('');
        }
        
        // Generate timestamp
        const now = new Date();
        const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const dateStr = now.toLocaleDateString([], { month: 'short', day: 'numeric' });
        
        // Generate action buttons based on role
        let actionsHtml = '';
        if (role === 'user') {
            actionsHtml = `
                <div class="message-actions">
                    <button class="message-action-btn copy" title="Copy">
                        <i class="fas fa-copy"></i> Copy
                    </button>
                    <button class="message-action-btn delete" title="Delete">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </div>
            `;
        } else {
            actionsHtml = `
                <div class="message-actions">
                    <button class="message-action-btn copy" title="Copy">
                        <i class="fas fa-copy"></i> Copy
                    </button>
                    <button class="message-action-btn regenerate" title="Regenerate">
                        <i class="fas fa-redo"></i> Regenerate
                    </button>
                    <button class="message-action-btn delete" title="Delete">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </div>
            `;
        }
        
        messageDiv.innerHTML = `
            <div class="chatbot-avatar">
                <i class="fas fa-${role === 'user' ? 'user' : 'robot'}"></i>
            </div>
            <div class="chatbot-bubble">
                <p>${escapeHtml(text)}</p>
                ${attachmentsHtml}
                <div class="message-timestamp">
                    <span class="message-time" title="${dateStr} at ${timeStr}">${timeStr}</span>
                </div>
                ${actionsHtml}
            </div>
        `;
        chatbotMessages.appendChild(messageDiv);
        
        // Add event listeners for action buttons
        addActionListeners(messageDiv, text);
        
        // Add quick replies for bot messages
        if (role === 'bot') {
            const responseType = detectResponseType(text);
            addQuickReplies(messageDiv, responseType);
        }
        
        if (scroll) {
            chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
        }
    }
    
    function addCardToDOM(cardData) {
        const div = document.createElement('div');
        div.innerHTML = cardData.html;
        chatbotMessages.appendChild(div.firstElementChild);
    }

    function addMessage(text, role, attachments = []) {
        addMessageToDOM(text, role, attachments);
    }
    
    // Add course card
    function addCourseCard(course) {
        const cardDiv = document.createElement('div');
        cardDiv.className = 'chatbot-course-card';
        cardDiv.innerHTML = `
            <img src="${course.image || 'https://via.placeholder.com/280x120'}" alt="${course.title}" class="chatbot-course-image">
            <div class="chatbot-course-content">
                <div class="chatbot-course-title">${escapeHtml(course.title)}</div>
                <div class="chatbot-course-meta">
                    <span class="chatbot-course-price">$${course.price || 'Free'}</span>
                    <span class="chatbot-course-level">${course.level || 'All Levels'}</span>
                </div>
                <div class="chatbot-course-actions">
                    <button class="chatbot-course-btn primary" data-action="enroll" data-course-id="${course.id}">Enroll Now</button>
                    <button class="chatbot-course-btn secondary" data-action="view" data-course-id="${course.id}">View Details</button>
                </div>
            </div>
        `;
        chatbotMessages.appendChild(cardDiv);
        chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
    }
    
    // Add instructor card
    function addInstructorCard(instructor) {
        const cardDiv = document.createElement('div');
        cardDiv.className = 'chatbot-instructor-card';
        cardDiv.innerHTML = `
            <img src="${instructor.avatar || 'https://via.placeholder.com/60'}" alt="${instructor.name}" class="chatbot-instructor-avatar">
            <div class="chatbot-instructor-info">
                <div class="chatbot-instructor-name">${escapeHtml(instructor.name)}</div>
                <div class="chatbot-instructor-specialty">${escapeHtml(instructor.specialty || 'Instructor')}</div>
                <div class="chatbot-instructor-rating">
                    <i class="fas fa-star"></i>
                    <span>${instructor.rating || '4.8'}</span>
                    <span style="color: #6c757d; margin-left: 5px;">(${instructor.students || '100'} students)</span>
                </div>
            </div>
        `;
        chatbotMessages.appendChild(cardDiv);
        chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
    }
    
    // Add tutoring session card
    function addSessionCard(session) {
        const cardDiv = document.createElement('div');
        cardDiv.className = 'chatbot-course-card';
        
        const timeInfo = session.availableFrom && session.availableTo ? 
            `<span style="color: #6c757d; font-size: 12px;"><i class="fas fa-clock"></i> ${session.availableFrom} - ${session.availableTo}</span>` : '';
        
        cardDiv.innerHTML = `
            <div class="chatbot-course-content" style="border-left: 4px solid #667eea; padding-left: 12px;">
                <div class="chatbot-course-title">${escapeHtml(session.title)}</div>
                <div style="font-size: 12px; color: #6c757d; margin-bottom: 6px;">
                    <i class="fas fa-user-tie"></i> ${escapeHtml(session.instructor)} | 
                    <i class="fas fa-tag"></i> ${escapeHtml(session.category)}
                </div>
                <div style="font-size: 12px; margin-bottom: 8px;">${escapeHtml(session.description || 'No description available')}</div>
                <div class="chatbot-course-meta">
                    <span class="chatbot-course-price">$${session.price || 'N/A'}/hr</span>
                    <span class="chatbot-course-level">${session.level || 'All Levels'}</span>
                </div>
                <div style="margin-bottom: 8px;">
                    <span style="color: #28a745; font-size: 12px;"><i class="fas fa-calendar"></i> ${session.startDate}</span>
                    ${timeInfo}
                </div>
                <div class="chatbot-course-actions">
                    <button class="chatbot-course-btn primary" onclick="window.open('${session.url}', '_blank')">Book Now</button>
                    <button class="chatbot-course-btn secondary" onclick="window.open('${session.url}', '_blank')">View Details</button>
                </div>
            </div>
        `;
        chatbotMessages.appendChild(cardDiv);
        chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
    }

    function showTyping() {
        const typingDiv = document.createElement('div');
        typingDiv.id = 'chatbot-typing';
        typingDiv.className = 'chatbot-message chatbot-message-bot';
        typingDiv.innerHTML = `
            <div class="chatbot-avatar">
                <i class="fas fa-robot"></i>
            </div>
            <div class="chatbot-bubble chatbot-typing">
                <span></span>
                <span></span>
                <span></span>
            </div>
        `;
        chatbotMessages.appendChild(typingDiv);
        chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
    }

    function removeTyping() {
        const typing = document.getElementById('chatbot-typing');
        if (typing) {
            typing.remove();
        }
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
})();
</script>
