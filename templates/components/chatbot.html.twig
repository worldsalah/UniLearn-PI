    function handleQuickReply(action, text) {
        // Map actions to messages
        const actionMessages = {
            'yes': 'Yes, please.',
            'no': 'No, thanks.',
            'tell-more': 'Can you tell me more about that?',
            'show-examples': 'Can you show me some examples?',
            'thanks': 'Thank you!',
            'show-more': 'Show me more options.',
            'filter-price': 'Filter by lowest price.',
            'filter-rating': 'Filter by highest rating.',
            'show-related': 'Show me related content.'
        };
        
        const message = actionMessages[action] || text;
        chatbotInput.value = message;
        sendMessage();
    }
    
    // Detect response type from message content
    function detectResponseType(message) {
        if (message.includes('?')) return 'question';
        if (message.includes('course') || message.includes('Course')) return 'courses';
        if (message.includes('instructor') || message.includes('Instructor')) return 'instructors';
        return 'info';
    }
    
    // Search in conversation
    let searchResults = [];
    let currentSearchIndex = -1;
    
    chatbotSearch.addEventListener('click', () => {
        chatbotSearchBar.classList.toggle('active');
        if (chatbotSearchBar.classList.contains('active')) {
            chatbotSearchInput.focus();
        } else {
            clearSearch();
        }
    });
    
    chatbotSearchCloseBtn.addEventListener('click', () => {
        chatbotSearchBar.classList.remove('active');
        clearSearch();
    });
    
    chatbotSearchInput.addEventListener('input', (e) => {
        performSearch(e.target.value);
    });
    
    chatbotSearchPrev.addEventListener('click', () => {
        navigateSearch(-1);
    });
    
    chatbotSearchNext.addEventListener('click', () => {
        navigateSearch(1);
    });
    
    function performSearch(query) {
        clearSearch();
        
        if (!query.trim()) {
            chatbotSearchCount.textContent = '';
            return;
        }
        
        const messages = chatbotMessages.querySelectorAll('.chatbot-bubble p');
        const regex = new RegExp(`(${escapeRegex(query)})`, 'gi');
        
        searchResults = [];
        
        messages.forEach((p, index) => {
            const text = p.textContent;
            if (text.toLowerCase().includes(query.toLowerCase())) {
                searchResults.push({ element: p, messageDiv: p.closest('.chatbot-message') });
                
                // Highlight matches
                p.innerHTML = text.replace(regex, '<span class="message-highlight">$1</span>');
            }
        });
        
        if (searchResults.length > 0) {
            currentSearchIndex = 0;
            updateSearchCount();
            scrollToSearchResult();
        } else {
            chatbotSearchCount.textContent = 'No results';
        }
    }
    
    function clearSearch() {
        const highlights = chatbotMessages.querySelectorAll('.message-highlight');
        highlights.forEach(h => {
            h.outerHTML = h.textContent;
        });
        searchResults = [];
        currentSearchIndex = -1;
    }
    
    function navigateSearch(direction) {
        if (searchResults.length === 0) return;
        
        currentSearchIndex += direction;
        if (currentSearchIndex < 0) currentSearchIndex = searchResults.length - 1;
        if (currentSearchIndex >= searchResults.length) currentSearchIndex = 0;
        
        updateSearchCount();
        scrollToSearchResult();
    }
    
    function updateSearchCount() {
        if (searchResults.length > 0) {
            chatbotSearchCount.textContent = `${currentSearchIndex + 1}/${searchResults.length}`;
        }
    }
    
    function scrollToSearchResult() {
        if (searchResults[currentSearchIndex]) {
            const result = searchResults[currentSearchIndex];
            result.messageDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
            
            // Update current highlight
            const highlights = chatbotMessages.querySelectorAll('.message-highlight');
            highlights.forEach(h => h.classList.remove('current'));
            const currentHighlights = result.element.querySelectorAll('.message-highlight');
            currentHighlights.forEach(h => h.classList.add('current'));
        }
    }
    
    function escapeRegex(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }
    
    // Message actions
    function addActionListeners(messageDiv, originalText) {
        const copyBtn = messageDiv.querySelector('.message-action-btn.copy');
        const deleteBtn = messageDiv.querySelector('.message-action-btn.delete');
        const regenerateBtn = messageDiv.querySelector('.message-action-btn.regenerate');
        
        if (copyBtn) {
            copyBtn.addEventListener('click', () => {
                navigator.clipboard.writeText(originalText).then(() => {
                    const originalContent = copyBtn.innerHTML;
                    copyBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                    setTimeout(() => {
                        copyBtn.innerHTML = originalContent;
                    }, 2000);
                });
            });
        }
        
        if (deleteBtn) {
            deleteBtn.addEventListener('click', () => {
                if (confirm('Delete this message?')) {
                    messageDiv.remove();
                    saveConversation();
                }
            });
        }
        
        if (regenerateBtn) {
            regenerateBtn.addEventListener('click', async () => {
                // Find the last user message
                const allMessages = chatbotMessages.querySelectorAll('.chatbot-message');
                let lastUserMessage = null;
                
                for (let i = allMessages.length - 1; i >= 0; i--) {
                    if (allMessages[i].classList.contains('chatbot-message-user')) {
                        const p = allMessages[i].querySelector('.chatbot-bubble p');
                        if (p) {
                            lastUserMessage = p.textContent;
                            break;
                        }
                    }
                }
                
                if (lastUserMessage) {
                    // Remove current bot message
                    messageDiv.remove();
                    
                    // Show typing indicator
                    showTyping();
                    
                    // Resend the last user message
                    try {
                        const response = await fetch('/chatbot/message', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: JSON.stringify({
                                message: lastUserMessage,
                                context: context,
                                language: currentLanguage,
                                personality: userPreferences.personality
                            })
                        });
                        
                        const data = await response.json();
                        removeTyping();
                        
                        if (data.success) {
                            addMessage(data.message, 'bot');
                            context.push({ role: 'user', content: lastUserMessage });
                            context.push({ role: 'assistant', content: data.message });
                            saveConversation();
                        }
                    } catch (error) {
                        removeTyping();
                        addMessage('Sorry, could not regenerate response.', 'bot');
                    }
                }
            });
        }
    }
    
