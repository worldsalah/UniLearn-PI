        if (confirm('Clear all conversation history?')) {
            clearConversation();
        }
    });
    
    // Export conversation
    chatbotExport.addEventListener('click', () => {
        showExportMenu();
    });
    
    function showExportMenu() {
        const choice = prompt('Export as:\n1. TXT (Plain Text)\n2. JSON (Full data)\n3. Copy to Clipboard\n\nEnter 1, 2, or 3:');
        
        if (choice === '1') {
            exportAsTxt();
        } else if (choice === '2') {
            exportAsJson();
        } else if (choice === '3') {
            copyToClipboard();
        }
    }
    
    function exportAsTxt() {
        const messages = [];
        chatbotMessages.querySelectorAll('.chatbot-message').forEach(msgDiv => {
            const isUser = msgDiv.classList.contains('chatbot-message-user');
            const bubble = msgDiv.querySelector('.chatbot-bubble p');
            if (bubble) {
                const role = isUser ? 'You' : 'UniLearn Assistant';
                messages.push(`[${role}]: ${bubble.textContent}`);
            }
        });
        
        const content = `UniLearn Chatbot Conversation\nExported: ${new Date().toLocaleString()}\n${'='.repeat(50)}\n\n${messages.join('\n\n')}`;
        
        downloadFile(content, 'unilearn-conversation.txt', 'text/plain');
    }
    
    function exportAsJson() {
        const saved = localStorage.getItem(STORAGE_KEY);
        const data = saved ? JSON.parse(saved) : { messages: [], context: [] };
        
        const exportData = {
            exportedAt: new Date().toISOString(),
            language: currentLanguage,
            messages: data.messages || [],
            context: data.context || []
        };
        
        downloadFile(JSON.stringify(exportData, null, 2), 'unilearn-conversation.json', 'application/json');
    }
    
    function copyToClipboard() {
        const messages = [];
        chatbotMessages.querySelectorAll('.chatbot-message').forEach(msgDiv => {
            const isUser = msgDiv.classList.contains('chatbot-message-user');
            const bubble = msgDiv.querySelector('.chatbot-bubble p');
            if (bubble) {
                const role = isUser ? 'You' : 'Assistant';
                messages.push(`**${role}**: ${bubble.textContent}`);
            }
        });
        
        const content = messages.join('\n\n');
        
        navigator.clipboard.writeText(content).then(() => {
            // Show feedback
            const originalIcon = chatbotExport.innerHTML;
            chatbotExport.innerHTML = '<i class="fas fa-check"></i>';
            chatbotExport.style.color = '#28a745';
            setTimeout(() => {
                chatbotExport.innerHTML = originalIcon;
                chatbotExport.style.color = '';
            }, 2000);
        }).catch(err => {
            alert('Failed to copy to clipboard');
        });
    }
    
    function downloadFile(content, filename, mimeType) {
        const blob = new Blob([content], { type: mimeType });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }
    
    // Browser notifications
    let notificationsEnabled = localStorage.getItem('chatbot_notifications') === 'true';
    
    // Update notification button state
    function updateNotificationButton() {
        if (notificationsEnabled && Notification.permission === 'granted') {
            chatbotNotifications.innerHTML = '<i class="fas fa-bell"></i>';
            chatbotNotifications.style.color = '#667eea';
        } else {
            chatbotNotifications.innerHTML = '<i class="fas fa-bell-slash"></i>';
            chatbotNotifications.style.color = '';
        }
    }
    
    updateNotificationButton();
    
    chatbotNotifications.addEventListener('click', async () => {
        if (!('Notification' in window)) {
            alert('This browser does not support notifications');
            return;
        }
        
        if (Notification.permission === 'granted') {
            notificationsEnabled = !notificationsEnabled;
            localStorage.setItem('chatbot_notifications', notificationsEnabled);
            updateNotificationButton();
            if (notificationsEnabled) {
                showNotification('Notifications Enabled', 'You will receive notifications for new messages');
            }
        } else if (Notification.permission !== 'denied') {
            const permission = await Notification.requestPermission();
            if (permission === 'granted') {
                notificationsEnabled = true;
                localStorage.setItem('chatbot_notifications', 'true');
                updateNotificationButton();
                showNotification('Notifications Enabled', 'You will receive notifications for new messages');
            }
        } else {
            alert('Notifications are blocked. Please enable them in your browser settings.');
        }
    });
    
    function showNotification(title, body, icon = '/assets/images/logo.svg') {
        if (!notificationsEnabled || Notification.permission !== 'granted') return;
        
        const notification = new Notification(title, {
            body: body,
            icon: icon,
            badge: icon,
            tag: 'unilearn-chatbot'
        });
        
        notification.onclick = () => {
            window.focus();
            notification.close();
            if (!isOpen) {
                chatbotToggle.click();
            }
        };
        
        setTimeout(() => notification.close(), 5000);
    }
    
    // Show notification when bot responds and chat is closed
    function notifyBotResponse(message) {
