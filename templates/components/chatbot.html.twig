    // Quick reply buttons
    function addQuickReplies(messageDiv, responseType) {
        const quickRepliesDiv = document.createElement('div');
        quickRepliesDiv.className = 'quick-replies';
        
        let buttons = [];
        
        // Determine which quick replies to show based on response type
        if (responseType === 'question') {
            buttons = [
                { text: 'Yes', class: 'yes', action: 'yes' },
                { text: 'No', class: 'no', action: 'no' },
                { text: 'Tell me more', class: 'tell-more', action: 'tell-more' }
            ];
        } else if (responseType === 'info') {
            buttons = [
                { text: 'Tell me more', class: 'tell-more', action: 'tell-more' },
                { text: 'Show examples', class: '', action: 'show-examples' },
                { text: 'Thanks!', class: 'yes', action: 'thanks' }
            ];
        } else if (responseType === 'courses') {
            buttons = [
                { text: 'Show more', class: '', action: 'show-more' },
                { text: 'Filter by price', class: '', action: 'filter-price' },
                { text: 'Filter by rating', class: '', action: 'filter-rating' }
            ];
        } else {
            buttons = [
                { text: 'Tell me more', class: 'tell-more', action: 'tell-more' },
                { text: 'Show related', class: '', action: 'show-related' },
                { text: 'Thanks!', class: 'yes', action: 'thanks' }
            ];
        }
        
        buttons.forEach(btn => {
            const button = document.createElement('button');
            button.className = `quick-reply-btn ${btn.class}`;
            button.textContent = btn.text;
            button.dataset.action = btn.action;
            button.addEventListener('click', () => handleQuickReply(btn.action, btn.text));
            quickRepliesDiv.appendChild(button);
        });
        
        const bubble = messageDiv.querySelector('.chatbot-bubble');
        if (bubble) {
            bubble.appendChild(quickRepliesDiv);
        }
