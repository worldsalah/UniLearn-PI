    // File attachment
    chatbotAttachBtn.addEventListener('click', () => {
        chatbotFileInput.click();
    });
    
    chatbotFileInput.addEventListener('change', (e) => {
        const files = Array.from(e.target.files);
        files.forEach(file => addAttachment(file));
        chatbotFileInput.value = ''; // Reset input
    });
    
    // Add attachment to preview
    function addAttachment(file) {
        const maxSize = 10 * 1024 * 1024; // 10MB
        if (file.size > maxSize) {
            addMessage(`⚠️ File "${file.name}" is too large. Max size is 10MB.`, 'bot');
            return;
        }
        
        const attachment = {
            id: Date.now() + Math.random(),
            file: file,
            name: file.name,
            size: file.size,
            type: file.type
        };
        
        attachments.push(attachment);
        renderAttachmentPreview(attachment);
    }
    
    // Render attachment preview
    function renderAttachmentPreview(attachment) {
        const isImage = attachment.type.startsWith('image/');
        const previewItem = document.createElement('div');
        previewItem.className = 'attachment-preview-item' + (isImage ? ' image-preview' : '');
        previewItem.dataset.id = attachment.id;
        
        if (isImage) {
            const reader = new FileReader();
            reader.onload = (e) => {
                previewItem.innerHTML = `
                    <img src="${e.target.result}" alt="${attachment.name}">
                    <button class="remove-attachment" data-id="${attachment.id}">
                        <i class="fas fa-times"></i>
                    </button>
                `;
            };
            reader.readAsDataURL(attachment.file);
        } else {
            const icon = getFileIcon(attachment.type);
            previewItem.innerHTML = `
                <i class="fas ${icon}"></i>
                <span class="file-name">${attachment.name}</span>
                <button class="remove-attachment" data-id="${attachment.id}">
                    <i class="fas fa-times"></i>
                </button>
            `;
        }
        
        chatbotAttachmentsPreview.appendChild(previewItem);
    }
    
    // Get file icon based on type
    function getFileIcon(mimeType) {
        if (mimeType.includes('pdf')) return 'fa-file-pdf';
        if (mimeType.includes('word') || mimeType.includes('document')) return 'fa-file-word';
        if (mimeType.includes('text')) return 'fa-file-alt';
        if (mimeType.includes('image')) return 'fa-file-image';
        return 'fa-file';
    }
    
    // Remove attachment
    chatbotAttachmentsPreview.addEventListener('click', (e) => {
        const removeBtn = e.target.closest('.remove-attachment');
        if (removeBtn) {
            const id = parseFloat(removeBtn.dataset.id);
            attachments = attachments.filter(a => a.id !== id);
            const previewItem = removeBtn.closest('.attachment-preview-item');
            if (previewItem) previewItem.remove();
        }
    });
    
    // Format file size
    function formatFileSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }
    
    // Stop speaking button
    chatbotStopSpeech.addEventListener('click', () => {
        if (synthesis) {
            synthesis.cancel();
            hideStopButton();
        }
    });
    
    // Show stop button when speaking
    function showStopButton() {
        chatbotStopSpeech.style.display = 'flex';
        chatbotSend.style.display = 'none';
