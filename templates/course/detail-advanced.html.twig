{% extends 'front_base.html.twig' %}

{% block title %}{{ course.title }} - Course Details{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* Enhanced Course Detail Styles */
html, body {
    background-color: #ffffff !important;
}

.container {
    padding-top: 2rem;
    padding-bottom: 3rem;
}

.course-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-radius: 20px;
    padding: 3rem;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(102, 126, 234, 0.3);
}

.course-header::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 300px;
    height: 300px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    animation: float 6s ease-in-out infinite;
}

.course-header::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -5%;
    width: 200px;
    height: 200px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    animation: float 8s ease-in-out infinite reverse;
}

@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
}

.course-thumbnail {
    width: 100%;
    height: 250px;
    object-fit: cover;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    transition: transform 0.3s ease;
}

.course-thumbnail:hover {
    transform: scale(1.05);
}

.course-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: #ffffff;
    line-height: 1.2;
}

.course-header .course-meta {
    opacity: 0.95;
}

.course-header .meta-item {
    color: rgba(255, 255, 255, 0.92);
}

.course-header .meta-item i {
    color: rgba(255, 255, 255, 0.92);
}

.course-meta {
    display: flex;
    gap: 2rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
}

.meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #64748b;
    font-weight: 500;
}

.meta-item i {
    color: #667eea;
}

.course-description {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #475569;
    margin-bottom: 2rem;
}

.course-requirements {
    background: #f8fafc;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    border: 1px solid #eef2f7;
}

.course-outcomes {
    background: #f0fdf4;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    border: 1px solid #dcfce7;
}

.section-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #1a202c;
}

.requirement-list, .outcome-list {
    list-style: none;
    padding: 0;
}

.requirement-list li, .outcome-list li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
}

.requirement-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #667eea;
    font-weight: bold;
}

.outcome-list li::before {
    content: '🎯';
    position: absolute;
    left: 0;
}

.enrollment-card {
    background: white;
    border-radius: 15px;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    position: sticky;
    top: 2rem;
    border: 1px solid #eef2f7;
}

.price-display {
    font-size: 2.5rem;
    font-weight: 700;
    color: #10b981;
    margin-bottom: 1rem;
}

.price-display.free {
    color: #059669;
}

.enrollment-btn {
    width: 100%;
    padding: 1rem;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 10px;
    border: none;
    transition: all 0.3s ease;
}

.enrollment-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
}

.course-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e8f0;
}

.stat-item {
    text-align: center;
}

.stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a202c;
}

.stat-label {
    color: #64748b;
    font-size: 0.9rem;
}

.recommended-books {
    margin-top: 3rem;
}

.book-card {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
    height: 100%;
    border: 1px solid #eef2f7;
}

.book-card:hover {
    transform: translateY(-5px);
}

.book-thumbnail {
    width: 100px;
    height: 140px;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
}

.book-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #1a202c;
    margin-bottom: 0.5rem;
    line-height: 1.4;
}

.book-authors {
    color: #64748b;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
}

.book-description {
    color: #475569;
    font-size: 0.9rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.book-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #e2e8f0;
}

.book-pages {
    color: #64748b;
    font-size: 0.8rem;
}

.book-link {
    color: #667eea;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.3s ease;
}

.book-link:hover {
    color: #5a67d8;
}

@media (max-width: 768px) {
    .course-header {
        padding: 2rem;
    }
    
    .course-title {
        font-size: 2rem;
    }
    
    .course-meta {
        gap: 1rem;
    }
    
    .enrollment-card {
        position: static;
        margin-top: 2rem;
    }
}
</style>
{% endblock %}

{% block content %}
<!-- Flash Messages -->
{% for message in app.flashes('error') %}
    <div data-flash-type="error" 
         data-flash-title="Access Denied" 
         data-flash-message="{{ message }}"
         style="display: none;">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('success') %}
    <div data-flash-type="success" 
         data-flash-title="Success" 
         data-flash-message="{{ message }}"
         style="display: none;">
        {{ message }}
    </div>
{% endfor %}

<div class="container">
    <!-- Course Header -->
    <div class="course-header">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="course-title-wrapper">
                    <h1 class="course-title">{{ course.title }}</h1>
                    <div class="course-meta">
                        <div class="meta-item">
                            <i class="fas fa-layer-group"></i>
                            <span>{{ course.level|default('Beginner') }}</span>
                        </div>
                        <div class="meta-item">
                            <i class="fas fa-clock"></i>
                            <span>{{ course.duration ? course.duration ~ ' hours' : 'Self-paced' }}</span>
                        </div>
                        <div class="meta-item">
                            <i class="fas fa-language"></i>
                            <span>{{ course.language|default('English')|upper }}</span>
                        </div>
                        <div class="meta-item">
                            <i class="fas fa-user"></i>
                            <span>{{ course.user.fullName|default('Instructor') }}</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                {% if course.thumbnailUrl %}
                    <img src="{{ asset('uploads/courses/' ~ course.thumbnailUrl) }}" class="course-thumbnail" alt="{{ course.title }}">
                {% else %}
                    <div class="course-thumbnail d-flex align-items-center justify-content-center bg-primary">
                        <i class="fas fa-book fa-4x text-white"></i>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Course Description -->
            <section class="course-description">
                <h2 class="section-title">About This Course</h2>
                <p>{{ course.shortDescription|default('No description available.') }}</p>
            </section>

            <!-- Course Requirements -->
            {% if course.requirements %}
            <section class="course-requirements">
                <h3 class="section-title">Prerequisites</h3>
                <ul class="requirement-list">
                    {% for requirement in course.requirements|split('\n') %}
                        <li>{{ requirement|trim }}</li>
                    {% endfor %}
                </ul>
            </section>
            {% endif %}

            <!-- Course Outcomes -->
            {% if course.learningOutcomes %}
            <section class="course-outcomes">
                <h3 class="section-title">What You'll Learn</h3>
                <ul class="outcome-list">
                    {% for outcome in course.learningOutcomes|split('\n') %}
                        <li>{{ outcome|trim }}</li>
                    {% endfor %}
                </ul>
            </section>
            {% endif %}

            <!-- Target Audience -->
            {% if course.targetAudience %}
            <section class="course-requirements">
                <h3 class="section-title">Target Audience</h3>
                <p>{{ course.targetAudience }}</p>
            </section>
            {% endif %}

            <!-- Recommended Books -->
            {% if recommendedBooks|length > 0 %}
            <section class="recommended-books">
                <h3 class="section-title">Recommended Books</h3>
                <div class="row">
                    {% for book in recommendedBooks %}
                        <div class="col-md-6 mb-4">
                            <div class="book-card">
                                <div class="row">
                                    <div class="col-4">
                                        {% if book.thumbnail %}
                                            <img src="{{ book.thumbnail }}" class="book-thumbnail" alt="{{ book.title }}">
                                        {% else %}
                                            <div class="book-thumbnail d-flex align-items-center justify-content-center bg-light">
                                                <i class="fas fa-book fa-2x text-muted"></i>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="col-8">
                                        <h4 class="book-title">{{ book.title }}</h4>
                                        <p class="book-authors">{{ book.authors|default('Unknown Author') }}</p>
                                        <p class="book-description">{{ book.description|default('No description available.') }}</p>
                                        <div class="book-meta">
                                            {% if book.pageCount %}
                                                <span class="book-pages">{{ book.pageCount }} pages</span>
                                            {% endif %}
                                            {% if book.previewLink %}
                                                <a href="{{ book.previewLink }}" class="book-link" target="_blank">Preview →</a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>
            {% endif %}
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="enrollment-card">
                <!-- Price -->
                <div class="price-display {{ course.price > 0 ? '' : 'free' }}">
                    {% if course.price > 0 %}
                        ${{ course.price }}
                    {% else %}
                        FREE
                    {% endif %}
                </div>

                <!-- Enrollment Status -->
                {% if app.user %}
                    {% if isEnrolled %}
                        {% if isComplete and hasCertificate %}
                            {# Course complete and has certificate - show View Certificate #}
                            <a href="{{ path('quiz_certificate', {'id': certificate.quizResult.id}) }}" class="btn btn-success enrollment-btn">
                                <i class="fas fa-certificate me-2"></i>View Certificate
                            </a>
                        {% else %}
                            <a href="{{ path('app_my_courses') }}" class="btn btn-primary enrollment-btn">
                                <i class="fas fa-play me-2"></i>
                                {{ hasCompletedAnyLesson ? 'Continue Learning' : 'Start Learning' }}
                            </a>
                        {% endif %}
                    {% else %}
                        {% if enrollmentForm %}
                            {{ form_start(enrollmentForm, {'action': path('app_course_enroll', {'id': course.id})}) }}
                            <button type="submit" class="btn btn-primary enrollment-btn">
                                <i class="fas fa-plus-circle me-2"></i>
                                Enroll Now
                            </button>
                            {{ form_end(enrollmentForm) }}
                        {% endif %}
                    {% endif %}
                {% else %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Please log in to enroll
                    </div>
                    <a href="{{ path('app_login') }}" class="btn btn-primary enrollment-btn">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        Login to Enroll
                    </a>
                {% endif %}

                <!-- Course Stats -->
                <div class="course-stats">
                    <div class="stat-item">
                        <div class="stat-value">{{ course.chapters|default([])|length }}</div>
                        <div class="stat-label">Chapters</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">{{ course.quizzes|default([])|length }}</div>
                        <div class="stat-label">Quizzes</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">{{ course.duration ? course.duration : '∞' }}</div>
                        <div class="stat-label">Hours</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">{{ course.level|default('Beginner') }}</div>
                        <div class="stat-label">Level</div>
                    </div>
                </div>

                <!-- Course Category -->
                {% if course.category %}
                <div class="mt-3">
                    <span class="badge bg-primary bg-opacity-10 text-primary p-2">
                        <i class="fas fa-folder me-1"></i>
                        {{ course.category.name }}
                    </span>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Course Level Test Modal -->
<div class="modal fade" id="courseLevelTestModal" tabindex="-1" aria-labelledby="courseLevelTestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 text-center pb-0">
                <h5 class="modal-title w-100" id="courseLevelTestModalLabel">
                    <i class="fas fa-clipboard-check text-primary mb-3 d-block fs-1"></i>
                    Testez votre niveau dans ce cours
                </h5>
            </div>
            <div class="modal-body text-center px-4 pb-4">
                <p class="lead mb-4">
                    Avant de commencer ce cours, évaluez votre niveau actuel pour une meilleure expérience d'apprentissage.
                </p>
                
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-primary btn-lg" id="startCourseTestBtn">
                        <i class="fas fa-play-circle me-2"></i>
                        Commencer le test
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="skipCourseTestBtn">
                        <i class="fas fa-forward me-2"></i>
                        Passer et continuer
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Handle course level test modal
    const startTestBtn = document.getElementById('startCourseTestBtn');
    const skipTestBtn = document.getElementById('skipCourseTestBtn');
    const courseTestModal = new bootstrap.Modal(document.getElementById('courseLevelTestModal'));
    
    // Show modal when page loads (optional - remove if you want to trigger it differently)
    // setTimeout(() => {
    //     courseTestModal.show();
    // }, 1000);
    
    // Handle start test button
    if (startTestBtn) {
        startTestBtn.addEventListener('click', function() {
            // Redirect to course test page or show test interface
            window.location.href = '{{ path('app_course_test', {'id': course.id}) }}';
        });
    }
    
    // Handle skip test button
    if (skipTestBtn) {
        skipTestBtn.addEventListener('click', function() {
            courseTestModal.hide();
            // Continue with course enrollment or start learning
            {% if isEnrolled %}
                window.location.href = '{{ path('app_course_dashboard', {'id': course.id}) }}';
            {% else %}
                // Show enrollment form or scroll to enrollment section
                document.querySelector('.enrollment-card').scrollIntoView({ behavior: 'smooth' });
            {% endif %}
        });
    }
    
    // Handle modal close events
    document.getElementById('courseLevelTestModal').addEventListener('hidden.bs.modal', function () {
        // Optional: Show a reminder or take other action when modal is closed
        console.log('Course level test modal closed');
    });
});
</script>
{% endblock %}
