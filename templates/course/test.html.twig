{% extends 'base.html.twig' %}

{% block title %}Test - {{ course.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        html, body {
            background-color: #ffffff !important;
        }
        
        body {
            background: #ffffff !important;
        }
        
        .container, .main-content, #content, [role="main"] {
            background-color: #ffffff !important;
        }
        
        .test-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 3rem 2rem;
            background-color: #ffffff;
            min-height: 100vh;
        }
        
        .test-header {
            text-align: center;
            margin-bottom: 3rem;
            padding: 2rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        }
        
        .test-header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        
        .test-header h2 {
            font-size: 1.5rem;
            font-weight: 400;
            opacity: 0.9;
            margin-bottom: 0;
        }
        
        .test-content {
            background: white;
            padding: 2.5rem;
            border-radius: 12px;
            margin-bottom: 2rem;
            border: 1px solid #eef2f7;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        }
        
        .test-content h3 {
            color: #1a202c;
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
        }
        
        .test-content p {
            color: #475569;
            line-height: 1.8;
            font-size: 1.1rem;
        }
        
        .course-details {
            background: #f8fafc;
            border-radius: 10px;
            padding: 1.5rem;
            margin-top: 2rem;
            border: 1px solid #eef2f7;
        }
        
        .course-details ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        
        .course-details li {
            padding: 0.75rem 0;
            border-bottom: 1px solid #e2e8f0;
            color: #475569;
        }
        
        .course-details li:last-child {
            border-bottom: none;
        }
        
        .course-details strong {
            color: #1a202c;
            font-weight: 600;
        }
        
        .btn-back {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 1rem 2rem;
            text-decoration: none;
            border-radius: 8px;
            display: inline-block;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }
        
        .btn-back:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
            color: white;
        }
        
        .action-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }
        
        .btn-start {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            padding: 1rem 2rem;
            text-decoration: none;
            border-radius: 8px;
            display: inline-block;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
        }
        
        .btn-start:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4);
            color: white;
        }
        
        .test-info-card {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            padding: 1.5rem;
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
            border-radius: 10px;
            border-left: 4px solid #10b981;
            margin-bottom: 2rem;
        }
        
        .test-info-icon {
            font-size: 2.5rem;
            color: #10b981;
        }
        
        .test-info-text h4 {
            color: #1a202c;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }
        
        .test-info-text p {
            color: #475569;
            margin: 0;
            font-size: 0.95rem;
        }
    </style>
{% endblock %}

{% block content %}
<div class="test-container">
    <div class="test-header">
        <h1><i class="fas fa-clipboard-check me-3"></i>Course Test</h1>
        <h2>{{ course.title }}</h2>
    </div>
    
    <div class="test-info-card">
        <div class="test-info-icon">
            <i class="fas fa-info-circle"></i>
        </div>
        <div class="test-info-text">
            <h4>Test Your Knowledge</h4>
            <p>Complete this test to assess your understanding of the course material and earn your certificate.</p>
        </div>
    </div>
    
    <div class="test-content">
        <h3><i class="fas fa-graduation-cap me-2"></i>Ready to Begin?</h3>
        <p>This test will evaluate your knowledge of the course content. Make sure you have reviewed all lessons before starting. You will need to achieve a passing score to receive your certificate.</p>
        
        <div class="course-details">
            <ul>
                <li><strong><i class="fas fa-book me-2"></i>Title:</strong> {{ course.title }}</li>
                <li><strong><i class="fas fa-align-left me-2"></i>Description:</strong> {{ course.shortDescription|default('No description available') }}</li>
                <li><strong><i class="fas fa-signal me-2"></i>Level:</strong> {{ course.level|default('All Levels') }}</li>
                <li><strong><i class="fas fa-clock me-2"></i>Duration:</strong> {{ course.duration|default('Self-paced') }} hours</li>
            </ul>
        </div>
    </div>
    
    <div class="action-buttons">
        <a href="{{ path('app_my_courses') }}" class="btn-back">
            <i class="fas fa-arrow-left me-2"></i>Back to My Courses
        </a>
        <a href="{{ path('app_course_show', {'id': course.id}) }}" class="btn-start">
            <i class="fas fa-book me-2"></i>Back to Course
        </a>
    </div>
</div>
{% endblock %}
