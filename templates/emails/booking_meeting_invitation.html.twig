<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; background-color: #f5f5f5; margin: 0; padding: 0; }
        .container { max-width: 600px; margin: 40px auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.1); }
        .header { background: linear-gradient(135deg, #28a745, #20c997); padding: 30px; text-align: center; }
        .header h1 { color: #ffffff; margin: 0; font-size: 28px; }
        .content { padding: 40px 30px; }
        .footer { padding: 20px 30px; text-align: center; background: #f8f9fa; border-top: 1px solid #eee; }
        .footer p { color: #999; font-size: 13px; margin: 0; }
        .details-table { width: 100%; border-collapse: collapse; margin: 20px 0; }
        .details-table td { padding: 10px 0; border-bottom: 1px solid #eee; }
        .details-table td:first-child { color: #666; width: 40%; font-weight: 600; }
        .details-table td:last-child { color: #333; }
        .status-badge { background: #28a745; color: white; padding: 5px 15px; border-radius: 20px; font-size: 12px; text-transform: uppercase; }
        .btn { display: inline-block; background: linear-gradient(135deg, #28a745, #20c997); color: #ffffff !important; text-decoration: none; padding: 15px 40px; border-radius: 30px; font-size: 18px; font-weight: 600; margin: 20px 0; box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3); }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🎓 UniLearn Sessions</h1>
        </div>
        <div class="content">
    <div style="text-align: center; margin-bottom: 30px;">
        <h1 style="color: #28a745; margin: 0; font-size: 28px;">🎬 Your Session is Ready!</h1>
        <p style="color: #666; margin: 10px 0 0 0; font-size: 16px;">Join your video conference with {{ instructorName }}</p>
    </div>

    <div style="background: #f8f9fa; border-radius: 10px; padding: 25px; margin-bottom: 25px;">
        <h2 style="color: #333; margin: 0 0 20px 0; font-size: 20px; border-bottom: 2px solid #28a745; padding-bottom: 10px;">
            📚 Session Details
        </h2>
        
        <table style="width: 100%; border-collapse: collapse;">
            <tr>
                <td style="padding: 10px 0; color: #666; width: 40%;"><strong>Session:</strong></td>
                <td style="padding: 10px 0; color: #333;">{{ session.name }}</td>
            </tr>
            <tr>
                <td style="padding: 10px 0; color: #666;"><strong>Instructor:</strong></td>
                <td style="padding: 10px 0; color: #333;">{{ instructorName }}</td>
            </tr>
            <tr>
                <td style="padding: 10px 0; color: #666;"><strong>Date:</strong></td>
                <td style="padding: 10px 0; color: #333;">{{ booking.preferredDate|date('l, F j, Y') }}</td>
            </tr>
            <tr>
                <td style="padding: 10px 0; color: #666;"><strong>Time:</strong></td>
                <td style="padding: 10px 0; color: #333;">{{ booking.startTime ? booking.startTime|date('H:i') : 'TBD' }}</td>
            </tr>
            <tr>
                <td style="padding: 10px 0; color: #666;"><strong>Duration:</strong></td>
                <td style="padding: 10px 0; color: #333;">{{ booking.durationMinutes }} minutes</td>
            </tr>
            <tr>
                <td style="padding: 10px 0; color: #666;"><strong>Status:</strong></td>
                <td style="padding: 10px 0;">
                    <span style="background: #28a745; color: white; padding: 5px 15px; border-radius: 20px; font-size: 12px; text-transform: uppercase;">
                        {{ booking.status|upper }}
                    </span>
                </td>
            </tr>
        </table>
    </div>

    <div style="text-align: center; margin: 30px 0;">
        <p style="color: #333; font-size: 16px; margin-bottom: 20px;">
            Click the button below to join your video conference session:
        </p>
        
        <a href="{{ meetingUrl }}" style="display: inline-block; background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; padding: 15px 40px; border-radius: 30px; text-decoration: none; font-size: 18px; font-weight: bold; box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);">
            🎥 Join Meeting Now
        </a>
        
        <p style="color: #999; font-size: 12px; margin-top: 15px;">
            Or copy this link: <a href="{{ meetingUrl }}" style="color: #28a745;">{{ meetingUrl }}</a>
        </p>
    </div>

    <div style="background: #fff3cd; border-left: 4px solid #ffc107; padding: 15px; border-radius: 5px; margin: 25px 0;">
        <h3 style="color: #856404; margin: 0 0 10px 0; font-size: 16px;">⚠️ Important Reminders</h3>
        <ul style="margin: 0; padding-left: 20px; color: #856404; font-size: 14px;">
            <li>Make sure you have a stable internet connection</li>
            <li>Test your microphone and camera before the session</li>
            <li>Join the meeting a few minutes early</li>
            <li>Find a quiet place for the session</li>
        </ul>
    </div>

    <div style="background: #e7f3ff; border-radius: 10px; padding: 20px; margin-top: 25px;">
        <h3 style="color: #0056b3; margin: 0 0 10px 0; font-size: 16px;">📱 Need Help?</h3>
        <p style="color: #666; margin: 0; font-size: 14px;">
            If you have any questions or need to reschedule, please contact your instructor or visit our support center.
        </p>
    </div>
        </div>
        <div class="footer">
            <p>&copy; {{ "now"|date("Y") }} UniLearn. All rights reserved.</p>
            <p style="margin-top: 5px;">This email was sent to {{ booking.userEmail }}</p>
        </div>
    </div>
</body>
</html>
