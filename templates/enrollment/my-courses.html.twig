{% extends 'front_base.html.twig' %}

{% block title %}My Courses - UniLearn{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
html, body {
    background-color: #ffffff !important;
}

.my-courses {
    padding: 2rem 0;
    background-color: #ffffff;
}

.course-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    overflow: hidden;
    transition: all 0.3s ease;
    height: 100%;
}

.course-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 15px rgba(0,0,0,0.15);
}

.course-image {
    height: 200px;
    background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 3rem;
}

.course-content {
    padding: 1.5rem;
}

.course-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 0.5rem;
    line-height: 1.4;
}

.course-meta {
    color: #6c757d;
    font-size: 0.875rem;
    margin-bottom: 1rem;
}

.progress-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.progress-bar-custom {
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(90deg, #28a745 0%, #20c997 100%);
}

.course-actions {
    display: flex;
    gap: 0.5rem;
}

.action-btn {
    flex: 1;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    text-align: center;
    font-size: 0.875rem;
    transition: all 0.3s ease;
    border: 1px solid transparent;
}

.continue-btn {
    background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
    color: white;
}

.continue-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,123,255,0.3);
}

.certificate-btn {
    background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    color: white;
}

.certificate-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(40,167,69,0.3);
}

.quiz-btn {
    background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%);
    color: #212529;
}

.quiz-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(255,193,7,0.3);
}

.dashboard-btn {
    background: transparent;
    color: #007bff;
    border-color: #007bff;
}

.dashboard-btn:hover {
    background: #007bff;
    color: white;
}

.enrollment-date {
    font-size: 0.75rem;
    color: #6c757d;
}

.empty-state {
    text-align: center;
    padding: 4rem 2rem;
}

.empty-state i {
    font-size: 4rem;
    color: #6c757d;
    margin-bottom: 1rem;
}
</style>
{% endblock %}

{% block content %}
<!-- Flash Messages -->
{% for message in app.flashes('error') %}
    <div data-flash-type="error" 
         data-flash-title="Access Denied" 
         data-flash-message="{{ message }}"
         style="display: none;">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('success') %}
    <div data-flash-type="success" 
         data-flash-title="Success" 
         data-flash-message="{{ message }}"
         style="display: none;">
        {{ message }}
    </div>
{% endfor %}

<div class="container my-courses">
    <div class="row">
        <div class="col-12">
            <h1 class="h2 mb-4">My Courses</h1>
            
            {% if enrollmentData|length > 0 %}
                <div class="row">
                    {% for data in enrollmentData %}
                        {% set enrollment = data.enrollment %}
                        {% set isComplete = data.isComplete %}
                        {% set hasCertificate = data.hasCertificate %}
                        {% set canTakeQuiz = data.canTakeQuiz %}
                        {% set firstQuiz = data.firstQuiz %}
                        {% set certificate = data.certificate %}
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="course-card">
                                <!-- Course Image/Placeholder -->
                                <div class="course-image">
                                    <i class="fas fa-graduation-cap"></i>
                                </div>
                                
                                <!-- Course Content -->
                                <div class="course-content">
                                    <h3 class="course-title">{{ enrollment.course.title }}</h3>
                                    
                                    <div class="course-meta">
                                        <div class="d-flex align-items-center gap-3">
                                            <span>
                                                <i class="fas fa-clock me-1"></i>
                                                {{ enrollment.course.duration|default('Self-paced') }}
                                            </span>
                                            <span>
                                                <i class="fas fa-signal me-1"></i>
                                                {{ enrollment.course.level|default('All Levels') }}
                                            </span>
                                        </div>
                                    </div>
                                    
                                    <!-- Progress -->
                                    <div class="progress-info">
                                        <span class="fw-semibold">Progress</span>
                                        <span class="fw-bold">{{ enrollment.progress|round }}%</span>
                                    </div>
                                    <div class="progress mb-3">
                                        <div class="progress-bar progress-bar-custom" style="width: {{ enrollment.progress }}%"></div>
                                    </div>
                                    
                                    <!-- Actions -->
                                    <div class="course-actions">
                                        {% if isComplete and hasCertificate %}
                                            {# Course complete and has certificate - show View Certificate #}
                                            <a href="{{ path('quiz_certificate', {'id': certificate.quizResult.id}) }}" class="action-btn certificate-btn">
                                                <i class="fas fa-certificate me-1"></i>View Certificate
                                            </a>
                                        {% elseif (isComplete or enrollment.progress >= 100) and canTakeQuiz and not hasCertificate %}
                                            {# Course complete/progress 100%, has quiz but no certificate - show Take Quiz #}
                                            <a href="{{ path('app_quiz_take', {'id': firstQuiz.id}) }}" class="action-btn quiz-btn">
                                                <i class="fas fa-question-circle me-1"></i>Take Quiz
                                            </a>
                                        {% elseif isComplete and enrollment.progress >= 100 and not hasCertificate %}
                                            {# Course complete and progress 100%, no quiz - show Take Test #}
                                            <a href="{{ path('app_course_test', {'id': enrollment.course.id}) }}" class="action-btn quiz-btn">
                                                <i class="fas fa-clipboard-check me-1"></i>Take Test
                                            </a>
                                        {% else %}
                                            {# Course not complete - show Continue #}
                                            <a href="{{ path('app_course_dashboard', {'id': enrollment.course.id}) }}" class="action-btn continue-btn">
                                                <i class="fas fa-play me-1"></i>Continue
                                            </a>
                                        {% endif %}
                                        <a href="{{ path('app_course_show', {'id': enrollment.course.id}) }}" class="action-btn dashboard-btn">
                                            <i class="fas fa-info-circle me-1"></i>Details
                                        </a>
                                    </div>
                                    
                                    <!-- Enrollment Date -->
                                    <div class="enrollment-date">
                                        <i class="fas fa-calendar me-1"></i>
                                        Enrolled on {{ enrollment.enrolledAt|date('M d, Y') }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <i class="fas fa-book-open"></i>
                    <h3 class="h4 mb-3">No Courses Yet</h3>
                    <p class="text-muted">You haven't enrolled in any courses yet. Start your learning journey by exploring our course catalog.</p>
                    <a href="{{ path('app_course_grid') }}" class="btn btn-primary mt-3">
                        <i class="fas fa-search me-2"></i>Browse Courses
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<!-- Include Footer -->
{% include 'components/footer.html.twig' %}
{% endblock %}
