{% extends 'front_base.html.twig' %}

{% block title %}Mes Badges{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-medal me-2"></i>Mes Badges
                    </h5>
                </div>
                <div class="card-body">
                    {% if badges|length > 0 %}
                        <div class="row">
                            {% for badge in badges %}
                                <div class="col-md-6 col-lg-4 mb-4">
                                    <div class="card border-0 bg-light h-100">
                                        <div class="card-body text-center">
                                            <div class="badge-icon mb-3">
                                                {% if badge.badge.icon %}
                                                    <i class="{{ badge.badge.icon }} fa-3x" 
                                                       style="color: {{ badge.badge.color }};"></i>
                                                {% else %}
                                                    <i class="fas fa-award fa-3x" 
                                                       style="color: {{ badge.badge.color }};"></i>
                                                {% endif %}
                                            </div>
                                            <h5 class="card-title">{{ badge.badge.name }}</h5>
                                            <p class="card-text">{{ badge.badge.description }}</p>
                                            <div class="mt-auto">
                                                <span class="badge bg-secondary">
                                                    <i class="fas fa-star me-1"></i>
                                                    {{ badge.badge.pointsRequired }} XP requis
                                                </span>
                                                <br>
                                                <small class="text-muted mt-2 d-block">
                                                    <i class="fas fa-calendar me-1"></i>
                                                    Obtenu le {{ badge.earnedAt|date('d/m/Y') }}
                                                </small>
                                                {% if badge.earnedReason %}
                                                    <small class="text-info d-block">
                                                        <i class="fas fa-info-circle me-1"></i>
                                                        {{ badge.earnedReason }}
                                                    </small>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        
                        <!-- Stats Summary -->
                        <div class="row mt-4">
                            <div class="col-md-4">
                                <div class="card border-0 bg-primary text-white">
                                    <div class="card-body text-center">
                                        <h3>{{ badges|length }}</h3>
                                        <p class="mb-0">Badges obtenus</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-0 bg-success text-white">
                                    <div class="card-body text-center">
                                        <h3>{{ stats.total_points }}</h3>
                                        <p class="mb-0">XP Total</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-0 bg-warning text-dark">
                                    <div class="card-body text-center">
                                        <h3>#{{ stats.rank }}</h3>
                                        <p class="mb-0">Rang actuel</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center py-5">
                            <i class="fas fa-lock fa-4x text-muted mb-4"></i>
                            <h4>Pas encore de badges</h4>
                            <p class="text-muted mb-4">
                                Continuez à apprendre et à participer pour débloquer vos premiers badges.<br>
                                Chaque accomplissement vous rapproche de nouvelles récompenses !
                            </p>
                            <a href="{{ path('app_course_grid') }}" class="btn btn-primary">
                                <i class="fas fa-graduation-cap me-2"></i>Commencer à apprendre
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
