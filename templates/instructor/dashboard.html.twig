								<div class="col-sm-6 col-md-4">
									<div class="metric-card">
										<span class="badge text-bg-dark">Average</span>
										<h4 class="my-2">${{ earningsData.average|number_format(2) }}</h4>
										<p class="mb-0 text-muted">Monthly average earnings</p>
									</div>
								</div>
							</div>
							<!-- Chart START -->
							<div class="col-md-12 mt-4">
								<div class="chart-container">
									<div id="ChartEarning" style="height:300px;"></div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<!-- Chart END -->

			</div>
			<!-- Main content END -->
		</div>
	</div>
</section>
<!-- =======================
Page content END -->

</main>
<!-- **************** MAIN CONTENT END **************** -->

{% endblock %}

{% block javascripts %}
<script type="module">
import ApexCharts from 'apexcharts';

// Chart data from backend
const chartData = {{ earningsData.chartData|json_encode()|raw }};
const chartLabels = {{ earningsData.chartLabels|json_encode()|raw }};
const studentChartData = {{ earningsData.studentChartData|json_encode()|raw }};

document.addEventListener("DOMContentLoaded", function() {
    var options = {
        series: [{
            name: 'Earnings ($)',
            type: 'area',
            data: chartData
        }, {
            name: 'Students',
            type: 'line',
            data: studentChartData
        }],
        chart: {
            height: 350,
            type: 'line',
            toolbar: {
                show: false
            },
            stacked: false,
        },
        stroke: {
            curve: 'smooth',
            width: [0, 3],
        },
        fill: {
            type: ['gradient', 'solid'],
            gradient: {
                shade: 'dark',
                type: 'vertical',
                shadeIntensity: 0.5,
                opacityFrom: 0.7,
                opacityTo: 0.1,
            }
        },
        dataLabels: {
            enabled: false
        },
        markers: {
            size: [0, 5],
            colors: ['#4CAF50', '#2196F3'],
            strokeColors: '#fff',
            strokeWidth: 2,
        },
        colors: ['#4CAF50', '#2196F3'],
        xaxis: {
            categories: chartLabels,
            labels: {
                style: {
                    fontSize: '12px'
                }
            }
        },
        yaxis: [{
            title: {
                text: 'Earnings ($)',
                style: {
                    color: '#4CAF50',
                }
            },
            labels: {
                style: {
                    colors: '#4CAF50',
                },
                formatter: function(value) {
                    return '$' + value;
                }
            }
        }, {
            opposite: true,
            title: {
                text: 'Students',
                style: {
                    color: '#2196F3',
                }
            },
            labels: {
                style: {
                    colors: '#2196F3',
                }
            }
        }],
        tooltip: {
            shared: true,
            intersect: false,
            y: {
                formatter: function(y, { seriesIndex }) {
                    if (seriesIndex === 0) {
                        return '$' + y.toFixed(2);
                    }
                    return y + ' students';
                }
            }
        },
        legend: {
            position: 'top',
            horizontalAlign: 'right'
        },
        grid: {
            borderColor: '#f1f1f1',
        }
    };

    var chart = new ApexCharts(document.querySelector("#ChartEarning"), options);
    chart.render();
});
</script>

