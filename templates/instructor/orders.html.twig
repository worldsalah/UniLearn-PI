{% extends 'front_base.html.twig' %}

{% block title %}My Orders - UniLearn{% endblock %}

{% block stylesheets %}
<style>
.instructor-gradient {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    position: relative;
    overflow: hidden;
}
.instructor-gradient::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: url('{{ asset('assets/images/pattern/04.png') }}') no-repeat center center;
    background-size: cover;
    opacity: 0.1;
}
.order-card {
    background: white;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    overflow: hidden;
    border: none;
    transition: all 0.3s ease;
}
.order-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}
.stat-card {
    background: white;
    border-radius: 16px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    border: none;
    border-top: 4px solid;
    transition: all 0.3s ease;
}
.stat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(0,0,0,0.12);
}
.stat-card.primary { border-top-color: #667eea; }
.stat-card.success { border-top-color: #10b981; }
.stat-card.warning { border-top-color: #f59e0b; }
.stat-card.info { border-top-color: #06b6d4; }
.nav-tabs-custom .nav-link {
    border: none;
    border-radius: 12px;
    padding: 12px 24px;
    font-weight: 600;
    color: #6b7280;
    transition: all 0.3s ease;
}
.nav-tabs-custom .nav-link.active {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}
.nav-tabs-custom .nav-link:hover:not(.active) {
    background: rgba(102, 126, 234, 0.1);
    color: #667eea;
}
.order-item {
    background: #f8fafc;
    border-radius: 12px;
    padding: 1rem;
    margin-bottom: 1rem;
    transition: all 0.2s ease;
}
.order-item:hover {
    background: #f1f5f9;
}
.status-badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
}
.status-pending { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
.status-completed { background: rgba(16, 185, 129, 0.15); color: #10b981; }
.status-cancelled { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
.status-processing { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
.section-title {
    color: #667eea;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
</style>
{% endblock %}

{% block content %}

<!-- **************** MAIN CONTENT START **************** -->
<main class="bg-white">

<!-- =======================
Hero Section START -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="text-center mb-4">
                    <div class="mb-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <i class="fas fa-shopping-bag fa-3x text-primary"></i>
                        </div>
                    </div>
                    <h1 class="display-5 fw-bold text-primary mb-3">Order Management</h1>
                    <p class="lead text-muted">Track your purchases, sales, and job postings</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- =======================
Hero Section END -->

<!-- =======================
Stats Section START -->
<section class="py-4 bg-white">
    <div class="container">
        <div class="row g-4 mb-5">
            <div class="col-md-6 col-lg-3">
                <div class="stat-card primary h-100 p-4 text-center">
                    <div class="mb-3">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background: rgba(102,126,234,0.15);">
                            <i class="fas fa-shopping-cart text-primary"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-0" style="color: #667eea;">{{ stats.totalBuyerOrders }}</h3>
                    <p class="text-muted mb-0 small">Purchases</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="stat-card success h-100 p-4 text-center">
                    <div class="mb-3">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background: rgba(16,185,129,0.15);">
                            <i class="fas fa-hand-holding-usd text-success"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-0 text-success">{{ stats.totalSellerOrders }}</h3>
                    <p class="text-muted mb-0 small">Sales</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="stat-card warning h-100 p-4 text-center">
                    <div class="mb-3">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background: rgba(245,158,11,0.15);">
                            <i class="fas fa-briefcase text-warning"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-0 text-warning">{{ stats.totalJobs }}</h3>
                    <p class="text-muted mb-0 small">Jobs Posted</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="stat-card info h-100 p-4 text-center">
                    <div class="mb-3">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background: rgba(6,182,212,0.15);">
                            <i class="fas fa-dollar-sign text-info"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-0 text-info">${{ stats.totalEarned|number_format(2) }}</h3>
                    <p class="text-muted mb-0 small">Total Earned</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- =======================
Stats Section END -->

<!-- =======================
Orders Content START -->
<section class="py-4 bg-white">
    <div class="container">
        <!-- Nav tabs -->
        <ul class="nav nav-tabs nav-tabs-custom mb-4 justify-content-center" id="orderTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="purchases-tab" data-bs-toggle="tab" data-bs-target="#purchases" type="button" role="tab">
                    <i class="fas fa-shopping-cart me-2"></i>My Purchases
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="sales-tab" data-bs-toggle="tab" data-bs-target="#sales" type="button" role="tab">
                    <i class="fas fa-hand-holding-usd me-2"></i>My Sales
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="jobs-tab" data-bs-toggle="tab" data-bs-target="#jobs" type="button" role="tab">
                    <i class="fas fa-briefcase me-2"></i>My Jobs
                </button>
            </li>
        </ul>

        <!-- Tab content -->
        <div class="tab-content" id="orderTabsContent">
            <!-- Purchases Tab -->
            <div class="tab-pane fade show active" id="purchases" role="tabpanel">
                <div class="card order-card">
                    <div class="card-header bg-transparent border-0 py-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold"><i class="fas fa-shopping-cart text-primary me-2"></i>Orders I've Made</h5>
                            <span class="badge bg-primary rounded-pill">{{ buyerOrders|length }} orders</span>
                        </div>
                    </div>
                    <div class="card-body">
                        {% if buyerOrders|length > 0 %}
                            {% for order in buyerOrders %}
                                <div class="order-item">
                                    <div class="row align-items-center">
                                        <div class="col-md-2">
                                            {% if order.product and order.product.image %}
                                                <img src="{{ vich_uploader_asset(order.product, 'imageFile') }}" class="rounded-3" width="60" height="60" alt="{{ order.product.title }}" style="object-fit: cover;">
                                            {% else %}
                                                <div class="bg-primary bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                    <i class="fas fa-box text-primary"></i>
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="col-md-4">
                                            <h6 class="mb-1 fw-bold">{{ order.product ? order.product.title : 'N/A' }}</h6>
                                            <p class="text-muted mb-0 small">Order #{{ order.id }}</p>
                                        </div>
                                        <div class="col-md-2">
                                            <span class="fw-bold text-primary">${{ order.totalPrice|number_format(2) }}</span>
                                        </div>
                                        <div class="col-md-2">
                                            <span class="status-badge status-{{ order.status }}">{{ order.status|title }}</span>
                                        </div>
                                        <div class="col-md-2 text-end">
                                            <small class="text-muted">{{ order.createdAt ? order.createdAt|date('M d, Y') : 'N/A' }}</small>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="text-center py-5">
                                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                    <i class="fas fa-shopping-cart text-muted fa-2x"></i>
                                </div>
                                <h5 class="text-muted">No purchases yet</h5>
                                <p class="text-muted mb-3">Start shopping to see your orders here</p>
                                <a href="{{ path('app_marketplace_shop') }}" class="btn btn-primary rounded-pill">
                                    <i class="fas fa-store me-2"></i>Browse Marketplace
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Sales Tab -->
            <div class="tab-pane fade" id="sales" role="tabpanel">
                <div class="card order-card">
                    <div class="card-header bg-transparent border-0 py-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold"><i class="fas fa-hand-holding-usd text-success me-2"></i>Orders for My Products</h5>
                            <span class="badge bg-success rounded-pill">{{ sellerOrders|length }} orders</span>
                        </div>
                    </div>
                    <div class="card-body">
                        {% if sellerOrders|length > 0 %}
                            {% for order in sellerOrders %}
                                <div class="order-item">
                                    <div class="row align-items-center">
                                        <div class="col-md-2">
                                            {% if order.product and order.product.image %}
                                                <img src="{{ vich_uploader_asset(order.product, 'imageFile') }}" class="rounded-3" width="60" height="60" alt="{{ order.product.title }}" style="object-fit: cover;">
                                            {% else %}
                                                <div class="bg-success bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                    <i class="fas fa-box text-success"></i>
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="col-md-3">
                                            <h6 class="mb-1 fw-bold">{{ order.product ? order.product.title : 'N/A' }}</h6>
                                            <p class="text-muted mb-0 small">Order #{{ order.id }}</p>
                                        </div>
                                        <div class="col-md-2">
                                            <p class="mb-0 small text-muted">Buyer:</p>
                                            <p class="mb-0 fw-bold">{{ order.buyer ? order.buyer.fullName : 'N/A' }}</p>
                                        </div>
                                        <div class="col-md-2">
                                            <span class="fw-bold text-success">${{ order.totalPrice|number_format(2) }}</span>
                                        </div>
                                        <div class="col-md-2">
                                            <span class="status-badge status-{{ order.status }}">{{ order.status|title }}</span>
                                        </div>
                                        <div class="col-md-1 text-end">
                                            <small class="text-muted">{{ order.createdAt ? order.createdAt|date('M d') : 'N/A' }}</small>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="text-center py-5">
                                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                    <i class="fas fa-hand-holding-usd text-muted fa-2x"></i>
                                </div>
                                <h5 class="text-muted">No sales yet</h5>
                                <p class="text-muted mb-3">Add products to start receiving orders</p>
                                <a href="{{ path('app_product_new') }}" class="btn btn-success rounded-pill">
                                    <i class="fas fa-plus me-2"></i>Add Product
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Jobs Tab -->
            <div class="tab-pane fade" id="jobs" role="tabpanel">
                <div class="card order-card">
                    <div class="card-header bg-transparent border-0 py-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold"><i class="fas fa-briefcase text-warning me-2"></i>Jobs I've Posted</h5>
                            <span class="badge bg-warning rounded-pill">{{ postedJobs|length }} jobs</span>
                        </div>
                    </div>
                    <div class="card-body">
                        {% if postedJobs|length > 0 %}
                            {% for job in postedJobs %}
                                <div class="order-item">
                                    <div class="row align-items-center">
                                        <div class="col-md-1">
                                            <div class="bg-warning bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                <i class="fas fa-briefcase text-warning"></i>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <h6 class="mb-1 fw-bold">{{ job.title }}</h6>
                                            <p class="text-muted mb-0 small">{{ job.description|slice(0, 50) }}...</p>
                                        </div>
                                        <div class="col-md-2">
                                            <span class="fw-bold text-warning">${{ job.budget|number_format(2) }}</span>
                                        </div>
                                        <div class="col-md-2">
                                            <span class="status-badge status-{{ job.status }}">{{ job.status|title }}</span>
                                        </div>
                                        <div class="col-md-2">
                                            <small class="text-muted">{{ job.createdAt ? job.createdAt|date('M d, Y') : 'N/A' }}</small>
                                        </div>
                                        <div class="col-md-1 text-end">
                                            <a href="{{ path('app_job_show', {'id': job.id}) }}" class="btn btn-sm btn-outline-primary rounded-pill">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="text-center py-5">
                                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                    <i class="fas fa-briefcase text-muted fa-2x"></i>
                                </div>
                                <h5 class="text-muted">No jobs posted yet</h5>
                                <p class="text-muted mb-3">Post a job to find freelancers</p>
                                <a href="{{ path('app_job_new') }}" class="btn btn-warning rounded-pill text-white">
                                    <i class="fas fa-plus me-2"></i>Post a Job
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- =======================
Orders Content END -->

</main>
<!-- **************** MAIN CONTENT END **************** -->

{% endblock %}
