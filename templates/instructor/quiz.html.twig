    // Hide progress, show results
    document.getElementById('translationProgress').style.display = 'none';
    document.getElementById('translationResults').style.display = 'block';
    document.getElementById('saveAllTranslationsBtn').style.display = 'inline-block';
    
    // Update success message
    const successAlert = document.querySelector('#translationResults .alert');
    successAlert.innerHTML = `
        <i class="bi bi-check-circle me-2"></i>
        <strong>Translation Complete!</strong> Successfully translated ${translatedCount} of ${totalQuestions} questions to French.
    `;
    
    // Show translated questions summary
