function resetTranslateAllProgress() {
    document.getElementById('progressBar').style.width = '0%';
    document.getElementById('progressText').textContent = '0%';
    document.getElementById('progressStatus').textContent = 'Starting translation...';
    document.getElementById('translationResults').style.display = 'none';
    document.getElementById('saveAllTranslationsBtn').style.display = 'none';
    document.getElementById('translatedQuestionsList').innerHTML = '';
}

async function startBatchTranslation(quizId) {
    try {
        console.log('Starting batch translation for quiz ID:', quizId);
        
        // Get all questions for this quiz
        const response = await fetch(`/quiz/${quizId}/data`);
        console.log('Response status:', response.status);
        
        const data = await response.json();
        console.log('Response data:', data);
        
        if (!data.success || !data.quiz || !data.quiz.questions) {
            console.error('Invalid response structure:', data);
            showNotification('Failed to load quiz questions: ' + (data.message || 'Invalid response structure'), 'danger');
            document.getElementById('progressStatus').textContent = 'Failed to load quiz questions. Please try again.';
            return;
        }
        
        const questions = data.quiz.questions;
        const totalQuestions = questions.length;
        console.log('Found questions:', totalQuestions);
        
        if (totalQuestions === 0) {
            showNotification('No questions found in this quiz', 'warning');
            document.getElementById('progressStatus').textContent = 'No questions to translate.';
            return;
        }
        
        let translatedCount = 0;
        
        // Update progress status
        document.getElementById('progressStatus').textContent = `Translating 0 of ${totalQuestions} questions...`;
        
        // Translate each question
        for (let i = 0; i < questions.length; i++) {
            const question = questions[i];
            console.log('Translating question:', question.id, question.question.substring(0, 50) + '...');
            
            try {
                // Update progress
                const progress = Math.round(((i + 1) / totalQuestions) * 100);
                document.getElementById('progressBar').style.width = progress + '%';
                document.getElementById('progressText').textContent = progress + '%';
                document.getElementById('progressStatus').textContent = `Translating ${i + 1} of ${totalQuestions} questions...`;
                
                // Translate this question
                const translationResponse = await fetch('/quiz/translate-question', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        question_id: question.id,
                        target_language: 'French'
                    })
                });
                
                const translationData = await translationResponse.json();
                console.log('Translation response for question', question.id, ':', translationData);
                
                if (translationData.success) {
                    window.allTranslations.push({
                        original_question: question,
                        translated_data: translationData.translated_question
                    });
                    translatedCount++;
                    console.log('Successfully translated question:', question.id);
                } else {
                    console.error('Failed to translate question:', question.id, translationData.message);
                }
                
                // Small delay to show progress
                await new Promise(resolve => setTimeout(resolve, 100));
                
            } catch (error) {
                console.error('Error translating question:', question.id, error);
            }
        }
        
        console.log('Translation complete. Translated:', translatedCount, 'of', totalQuestions);
        
        // Show results
        showTranslationResults(translatedCount, totalQuestions);
        
    } catch (error) {
        console.error('Error in batch translation:', error);
        showNotification('Batch translation failed: ' + error.message, 'danger');
        document.getElementById('progressStatus').textContent = 'Translation failed: ' + error.message + '. Please try again.';
    }
}

