<!-- AI Question Generation Modal -->
<div class="modal fade" id="generateQuestionsModal" tabindex="-1" aria-labelledby="generateQuestionsModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header bg-success text-white">
				<h5 class="modal-title" id="generateQuestionsModalLabel">
					<i class="bi bi-magic me-2"></i>AI Question Generator
				</h5>
				<button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal" aria-label="Close">
					<i class="bi bi-x-lg"></i>
				</button>
			</div>
			<div class="modal-body">
				<form id="generateQuestionsForm">
					<div class="row">
						<div class="col-md-6">
							<div class="mb-3">
								<label for="genQuizSelect" class="form-label">Select Quiz</label>
								<select class="form-control" id="genQuizSelect" name="quiz_id" required>
									<option value="">Choose a quiz...</option>
									{% if quizzes is defined %}
										{% for quiz in quizzes %}
											<option value="{{ quiz.id }}">{{ quiz.title }} ({{ quiz.questions|length }} questions)</option>
										{% endfor %}
									{% endif %}
								</select>
							</div>
						</div>
						<div class="col-md-6">
							<div class="mb-3">
								<label for="genQuestionCount" class="form-label">Number of Questions</label>
								<input type="number" class="form-control" id="genQuestionCount" name="question_count" value="5" min="1" max="20" required>
								<small class="text-muted">Generate 1-20 questions</small>
							</div>
						</div>
					</div>
