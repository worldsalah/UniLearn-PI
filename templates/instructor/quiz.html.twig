function translateQuestion() {
    const form = document.getElementById('translateQuestionForm');
    const formData = new FormData(form);
    const data = {
        question_id: formData.get('question_id'),
        target_language: formData.get('target_language')
    };

    // Validate required fields
    if (!data.question_id || !data.target_language) {
        showNotification('Please select a question and target language', 'warning');
        return;
    }

    // Show loading state
    const translateBtn = event.target;
    const originalText = translateBtn.innerHTML;
    translateBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Translating...';
    translateBtn.disabled = true;

    fetch('/quiz/translate-question', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(data)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Display translated question
            displayTranslatedQuestion(data.translated_question);
            
            // Store translated data for saving
            window.currentTranslation = {
                question_id: data.original_question.id,
                translated_data: data.translated_question
            };
            
            showNotification('Question translated successfully!', 'success');
        } else {
            showNotification('Translation Error: ' + data.message, 'danger');
            
            // Show fallback if available
            if (data.fallback_translation) {
                displayTranslatedQuestion(data.fallback_translation);
                showNotification('Using fallback translation', 'warning');
            }
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showNotification('An error occurred while translating question', 'danger');
    })
    .finally(() => {
        // Restore button state
        translateBtn.innerHTML = originalText;
        translateBtn.disabled = false;
    });
}

// Auto-translate function for French translation
function translateQuestionAuto(targetLanguage = 'French') {
    // Get the question ID from the current translation context
    const questionId = window.currentTranslationQuestionId;
    
    if (!questionId) {
        showNotification('No question selected', 'warning');
        return;
    }

    const data = {
        question_id: questionId,
        target_language: targetLanguage
    };

    // Show loading state
    const translationLoading = document.getElementById('translationLoading');
    const translationResult = document.getElementById('translationResult');
    
    if (translationLoading) {
        translationLoading.style.display = 'block';
    }
    if (translationResult) {
        translationResult.style.display = 'none';
    }

    fetch('/quiz/translate-question', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(data)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Display translated question
            displayTranslatedQuestion(data.translated_question);
            
            // Store translated data for saving
            window.currentTranslation = {
                question_id: data.original_question.id,
                translated_data: data.translated_question
            };
            
            showNotification('Question automatically translated to French!', 'success');
        } else {
            showNotification('Translation Error: ' + data.message, 'danger');
            
            // Show fallback if available
            if (data.fallback_translation) {
                displayTranslatedQuestion(data.fallback_translation);
                showNotification('Using fallback translation', 'warning');
            }
        }
    })
    .catch(error => {
        console.error('Translation error:', error);
        showNotification('Auto-translation failed. Please try manually.', 'danger');
        
        // Hide loading and show error state
        if (translationLoading) {
            translationLoading.style.display = 'none';
        }
    })
    .finally(() => {
        // Always hide loading and show result after processing
        if (translationLoading) {
            translationLoading.style.display = 'none';
        }
        if (translationResult) {
            translationResult.style.display = 'block';
        }
    });
}

