                            <h6 class="text-info">French Translations</h6>
                            <ul class="small">
                                ${window.allTranslations.slice(0, 3).map(t => `<li>${t.translated_data.question.substring(0, 50)}...</li>`).join('')}
                                ${window.allTranslations.length > 3 ? '<li>... and more</li>' : ''}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `;
    
    showNotification(`Successfully translated ${translatedCount} questions to French!`, 'success');
}

function saveAllTranslations() {
    if (!window.allTranslations || window.allTranslations.length === 0) {
        showNotification('No translations to save', 'warning');
        return;
    }
    
    const saveBtn = document.getElementById('saveAllTranslationsBtn');
    const originalText = saveBtn.innerHTML;
    saveBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Saving...';
    saveBtn.disabled = true;
    
    // Save each translation
    let savedCount = 0;
    const totalTranslations = window.allTranslations.length;
    
    window.allTranslations.forEach(async (translation, index) => {
        try {
            const response = await fetch('/quiz/save-translated-question', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    question_id: translation.original_question.id,
                    translated_data: translation.translated_data
                })
            });
            
            const result = await response.json();
            if (result.success) {
                savedCount++;
            }
        } catch (error) {
            console.error('Error saving translation:', error);
        }
        
        // Check if this was the last one
        if (index === totalTranslations - 1) {
            saveBtn.innerHTML = originalText;
            saveBtn.disabled = false;
            
            if (savedCount > 0) {
                showNotification(`Successfully saved ${savedCount} translations!`, 'success');
                
                // Close modal and refresh page after a delay
                setTimeout(() => {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('translateAllQuestionsModal'));
                    modal.hide();
                    setTimeout(() => location.reload(), 1000);
                }, 1500);
            } else {
                showNotification('Failed to save translations', 'danger');
            }
        }
    });
}

function displayTranslatedQuestion(translatedData) {
    // Hide loading, show result
    const translationLoading = document.getElementById('translationLoading');
    const translationResult = document.getElementById('translationResult');
    const saveTranslatedBtn = document.getElementById('saveTranslatedBtn');
    
    if (translationLoading) {
        translationLoading.style.display = 'none';
    }
    if (translationResult) {
        translationResult.style.display = 'block';
    }
    if (saveTranslatedBtn) {
        saveTranslatedBtn.style.display = 'inline-block';
    }
    
    // Populate translated content (check if elements exist)
    const translatedQuestionText = document.getElementById('translatedQuestionText');
    const translatedOptionA = document.getElementById('translatedOptionA');
    const translatedOptionB = document.getElementById('translatedOptionB');
    const translatedOptionC = document.getElementById('translatedOptionC');
    const translatedOptionD = document.getElementById('translatedOptionD');
    const translatedCorrectOption = document.getElementById('translatedCorrectOption');
    
    if (translatedQuestionText) {
        translatedQuestionText.textContent = translatedData.question;
    }
    if (translatedOptionA) {
        translatedOptionA.textContent = translatedData.option_a;
    }
    if (translatedOptionB) {
        translatedOptionB.textContent = translatedData.option_b;
    }
    if (translatedOptionC) {
        translatedOptionC.textContent = translatedData.option_c;
    }
    if (translatedOptionD) {
        translatedOptionD.textContent = translatedData.option_d;
    }
    if (translatedCorrectOption) {
        translatedCorrectOption.textContent = translatedData.correct_option;
    }
    
    // targetLanguageDisplay was removed, so we don't try to access it anymore
}

function saveTranslatedQuestion() {
    if (!window.currentTranslation) {
        showNotification('No translation data available to save', 'warning');
        return;
    }

    const saveBtn = event.target;
    const originalText = saveBtn.innerHTML;
    saveBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Saving...';
    saveBtn.disabled = true;

    fetch('/quiz/save-translated-question', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(window.currentTranslation)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showNotification('Translated question saved successfully!', 'success');
            
            // Close modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('translateQuestionModal'));
            modal.hide();
            
            // Reload page to show updated question
            setTimeout(() => location.reload(), 1500);
        } else {
            showNotification('Error: ' + data.message, 'danger');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showNotification('An error occurred while saving translated question', 'danger');
    })
    .finally(() => {
        // Restore button state
        saveBtn.innerHTML = originalText;
        saveBtn.disabled = false;
    });
}

// Enhanced question editing with AI translation
function editQuestionWithAI(questionId, questionText) {
    // First show the regular edit modal
    editQuestion(questionId, questionText);
    
    // Add AI translation button to the modal
    setTimeout(() => {
        const modalFooter = document.querySelector('#editQuestionModal .modal-footer');
        if (modalFooter && !modalFooter.querySelector('.ai-translate-btn')) {
            const aiTranslateBtn = document.createElement('button');
            aiTranslateBtn.type = 'button';
            aiTranslateBtn.className = 'btn btn-outline-info ai-translate-btn';
            aiTranslateBtn.innerHTML = '<i class="bi bi-translate me-1"></i> AI Translate';
            aiTranslateBtn.onclick = () => {
                const questionData = {
                    question: document.getElementById('editQuestionText').value,
                    options: {
                        A: document.querySelector('input[name="editOption1"]').value,
                        B: document.querySelector('input[name="editOption2"]').value,
                        C: document.querySelector('input[name="editOption3"]').value,
                        D: document.querySelector('input[name="editOption4"]').value
                    },
                    correct_option: document.querySelector('input[name="editCorrectOption"]:checked')?.value || 'A'
                };
                showTranslateQuestionModal(questionId, questionData);
            };
            
            modalFooter.insertBefore(aiTranslateBtn, modalFooter.firstChild);
        }
    }, 500);
}
</script>
