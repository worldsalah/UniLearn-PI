{% extends 'front_base.html.twig' %}

{% block title %}Marketplace Dashboard - Unilearn{% endblock %}

{% block content %}
<!-- **************** MAIN CONTENT START **************** -->
<main class="bg-white">

<!-- =======================
Hero Section START -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="text-center mb-4">
                    <div class="mb-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <i class="fas fa-tachometer-alt fa-3x text-primary"></i>
                        </div>
                    </div>
                    <h1 class="display-5 fw-bold text-primary mb-3">Marketplace Dashboard</h1>
                    <p class="lead text-muted">Manage your products, jobs, and orders</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- =======================
Hero Section END -->

<!-- =======================
Dashboard START -->
<section class="py-5 bg-white">
    <div class="container">
        <!-- Flash messages -->
        {% for type, messages in app.session.flashbag.all() %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show rounded-3" role="alert">
                    <i class="fas fa-{% if type == 'success' %}check-circle{% elseif type == 'error' %}exclamation-circle{% else %}info-circle{% endif %} me-2"></i>
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Stats Cards -->
        <div class="row g-4 mb-5">
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-lg h-100" style="border-radius: 20px; border-top: 4px solid #667eea !important;">
                    <div class="card-body p-4 text-center">
                        <div class="mb-3">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: linear-gradient(135deg, rgba(102,126,234,0.15) 0%, rgba(118,75,162,0.15) 100%);">
                                <i class="fas fa-box fa-2x" style="color: #667eea;"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1" style="color: #667eea;">{{ stats.totalProducts }}</h3>
                        <p class="text-muted mb-0">Total Products</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-lg h-100" style="border-radius: 20px; border-top: 4px solid #764ba2 !important;">
                    <div class="card-body p-4 text-center">
                        <div class="mb-3">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: linear-gradient(135deg, rgba(118,75,162,0.15) 0%, rgba(240,147,251,0.15) 100%);">
                                <i class="fas fa-briefcase fa-2x" style="color: #764ba2;"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1" style="color: #764ba2;">{{ stats.totalJobs }}</h3>
                        <p class="text-muted mb-0">Total Jobs</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-lg h-100" style="border-radius: 20px; border-top: 4px solid #667eea !important;">
                    <div class="card-body p-4 text-center">
                        <div class="mb-3">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: linear-gradient(135deg, rgba(102,126,234,0.15) 0%, rgba(118,75,162,0.15) 100%);">
                                <i class="fas fa-shopping-cart fa-2x" style="color: #667eea;"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1" style="color: #667eea;">{{ stats.totalOrders }}</h3>
                        <p class="text-muted mb-0">Total Orders</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-lg h-100" style="border-radius: 20px; border-top: 4px solid #10b981 !important;">
                    <div class="card-body p-4 text-center">
                        <div class="mb-3">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: rgba(16,185,129,0.15);">
                                <i class="fas fa-dollar-sign fa-2x text-success"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1 text-success">${{ stats.totalRevenue|number_format(2, '.', ',') }}</h3>
                        <p class="text-muted mb-0">Total Revenue</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="row g-4">
            <!-- Recent Products -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-lg h-100" style="border-radius: 20px;">
                    <div class="card-body p-4">
                        <h5 class="card-title fw-bold mb-4">
                            <i class="fas fa-box text-primary me-2"></i>Recent Products
                        </h5>
                        {% if products|length > 0 %}
                            {% for product in products %}
                                <div class="d-flex align-items-center mb-3 p-2 rounded-3 bg-light">
                                    <div class="flex-shrink-0">
                                        {% if product.image %}
                                            <img src="{{ vich_uploader_asset(product, 'imageFile') }}" class="rounded-3" width="50" height="50" alt="{{ product.title }}" style="object-fit: cover;">
                                        {% else %}
                                            <div class="bg-primary bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                <i class="fas fa-box text-primary"></i>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-1 fw-bold">{{ product.title }}</h6>
                                        <p class="text-muted mb-0 small">${{ product.price|number_format(2) }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="text-center py-4">
                                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                    <i class="fas fa-box text-muted"></i>
                                </div>
                                <p class="text-muted mb-0">No products yet.</p>
                            </div>
                        {% endif %}
                        <div class="mt-3">
                            <a href="{{ path('app_marketplace_index') }}" class="btn btn-outline-primary rounded-pill w-100">
                                <i class="fas fa-eye me-2"></i>View All Products
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Jobs -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-lg h-100" style="border-radius: 20px;">
                    <div class="card-body p-4">
                        <h5 class="card-title fw-bold mb-4">
                            <i class="fas fa-briefcase text-primary me-2"></i>Recent Jobs
                        </h5>
                        {% if jobs|length > 0 %}
                            {% for job in jobs %}
                                <div class="mb-3 p-3 rounded-3 bg-light">
                                    <h6 class="mb-1 fw-bold">{{ job.title }}</h6>
                                    <div class="d-flex gap-2">
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill">${{ job.budget }}</span>
                                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill">{{ job.status }}</span>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="text-center py-4">
                                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                    <i class="fas fa-briefcase text-muted"></i>
                                </div>
                                <p class="text-muted mb-0">No jobs posted yet.</p>
                            </div>
                        {% endif %}
                        <div class="mt-3">
                            <a href="{{ path('app_marketplace_index') }}" class="btn btn-outline-primary rounded-pill w-100">
                                <i class="fas fa-eye me-2"></i>View All Jobs
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Orders -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-lg h-100" style="border-radius: 20px;">
                    <div class="card-body p-4">
                        <h5 class="card-title fw-bold mb-4">
                            <i class="fas fa-shopping-cart text-primary me-2"></i>Recent Orders
                        </h5>
                        {% if orders|length > 0 %}
                            {% for order in orders %}
                                <div class="mb-3 p-3 rounded-3 bg-light">
                                    <h6 class="mb-1 fw-bold">{{ order.product.title }}</h6>
                                    <div class="d-flex gap-2">
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill">${{ order.totalPrice|number_format(2) }}</span>
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill">{{ order.status }}</span>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="text-center py-4">
                                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                    <i class="fas fa-shopping-cart text-muted"></i>
                                </div>
                                <p class="text-muted mb-0">No orders yet.</p>
                            </div>
                        {% endif %}
                        <div class="mt-3">
                            <a href="{{ path('app_instructor_orders') }}" class="btn btn-outline-primary rounded-pill w-100">
                                <i class="fas fa-eye me-2"></i>View All Orders
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row g-4 mt-4">
            <div class="col-12">
                <div class="card border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="card-body p-4">
                        <h5 class="card-title fw-bold mb-4">
                            <i class="fas fa-bolt text-primary me-2"></i>Quick Actions
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <a href="{{ path('app_product_new') }}" class="btn btn-primary w-100 rounded-pill py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">
                                    <i class="fas fa-plus me-2"></i>Add Product
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a href="{{ path('app_job_new') }}" class="btn btn-success w-100 rounded-pill py-3">
                                    <i class="fas fa-briefcase me-2"></i>Post Job
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a href="{{ path('api_quiz_analytics') }}" class="btn btn-info w-100 rounded-pill py-3 text-white">
                                    <i class="fas fa-chart-line me-2"></i>View Analytics
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- =======================
Dashboard END -->

</main>
<!-- **************** MAIN CONTENT END **************** -->

{% endblock %}
