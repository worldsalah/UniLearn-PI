												<i class="bi bi-cart-plus me-1"></i>Order
											</a>
										</div>
									</div>
								</div>
							</div>
							{% else %}
							<div class="col-12">
								<div class="card border-0 shadow-lg text-center py-5" style="border-radius: 20px;">
									<div class="card-body">
										<div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
											<i class="fas fa-clipboard-list fa-3x text-success"></i>
										</div>
										<h4>No Job Requests Found</h4>
										<p class="text-muted mb-4">Create the first job request!</p>
										<a href="#" class="btn btn-success btn-lg px-5">
											<i class="fas fa-plus me-2"></i>Create Job Request
										</a>
									</div>
