{% extends 'front_base.html.twig' %}

{% block title %}Marketplace - Services & Jobs - Unilearn Marketplace{% endblock %}

{% block content %}

<!-- =======================
Hero Section START -->
<section class="py-5 bg-white">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-lg-10">
				<div class="text-center mb-5">
					<div class="mb-4">
						<div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
							<i class="fas fa-store fa-3x text-primary"></i>
						</div>
					</div>
					<h1 class="display-4 fw-bold text-primary mb-3">UniLearn Marketplace</h1>
					<p class="lead text-muted">Find the perfect services, post job requests, and grow your business.</p>
					<div class="d-flex justify-content-center gap-3 flex-wrap mt-4">
						<span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
							<i class="fas fa-briefcase me-1"></i>Services
						</span>
						<span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
							<i class="fas fa-clipboard-list me-1"></i>Job Requests
						</span>
						<span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">
							<i class="fas fa-shopping-cart me-1"></i>Easy Orders
						</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- =======================
Hero Section END -->

<!-- =======================
Navigation Tabs START -->
<section class="py-3 bg-white border-bottom">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-lg-10">
				<ul class="nav nav-pills nav-fill gap-2" id="marketplaceTabs" role="tablist">
					<li class="nav-item" role="presentation">
						<button class="nav-link active rounded-pill" id="services-tab" data-bs-toggle="tab" data-bs-target="#services" type="button" role="tab">
							<i class="bi bi-briefcase me-2"></i>Services
						</button>
					</li>
					<li class="nav-item" role="presentation">
						<button class="nav-link rounded-pill" id="job-requests-tab" data-bs-toggle="tab" data-bs-target="#job-requests" type="button" role="tab">
							<i class="bi bi-clipboard-data me-2"></i>Job Requests
						</button>
					</li>
					<li class="nav-item" role="presentation">
						<button class="nav-link rounded-pill" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders" type="button" role="tab">
							<i class="bi bi-cart3 me-2"></i>Orders
						</button>
					</li>
					<li class="nav-item" role="presentation">
						<button class="nav-link rounded-pill" id="documentation-tab" data-bs-toggle="tab" data-bs-target="#documentation" type="button" role="tab">
							<i class="bi bi-book me-2"></i>Documentation
						</button>
					</li>
				</ul>
			</div>
		</div>
	</div>
</section>
<!-- =======================
Navigation Tabs END -->

<!-- =======================
Tab Content START -->
<section class="py-5 bg-white">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-lg-10">
				<div class="tab-content" id="marketplaceTabContent">

					<!-- Services Tab -->
					<div class="tab-pane fade show active" id="services" role="tabpanel">
						<div class="card border-0 shadow-lg mb-4" style="border-radius: 20px;">
							<div class="card-body p-4">
								<div class="row align-items-center">
									<div class="col-md-4">
										<h5 class="fw-bold mb-0"><i class="fas fa-briefcase text-primary me-2"></i>All Services</h5>
									</div>
									<div class="col-md-8">
										<div class="row g-2">
											<div class="col-md-4">
												<div class="input-group">
													<span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
													<input type="text" class="form-control border-start-0" id="services-search" placeholder="Search services...">
												</div>
											</div>
											<div class="col-md-3">
												<select class="form-select" id="services-sort">
													<option value="default">Sort by</option>
													<option value="price-low">Price: Low to High</option>
													<option value="price-high">Price: High to Low</option>
													<option value="name-asc">Name: A to Z</option>
													<option value="name-desc">Name: Z to A</option>
												</select>
											</div>
											<div class="col-md-3">
												<!-- Currency Selector -->
												<div class="dropdown">
													<button class="btn btn-outline-secondary w-100 dropdown-toggle" type="button" id="shopCurrencyDropdown" data-bs-toggle="dropdown">
														<i class="fas fa-coins me-1"></i>
														<span id="shopCurrentCurrency">USD</span>
													</button>
													<ul class="dropdown-menu" id="shopCurrencyMenu">
														<li><a class="dropdown-item shop-currency-option" href="#" data-currency="USD">🇺🇸 USD - US Dollar</a></li>
														<li><a class="dropdown-item shop-currency-option" href="#" data-currency="EUR">🇪🇺 EUR - Euro</a></li>
														<li><a class="dropdown-item shop-currency-option" href="#" data-currency="GBP">🇬🇧 GBP - British Pound</a></li>
														<li><a class="dropdown-item shop-currency-option" href="#" data-currency="JPY">🇯🇵 JPY - Japanese Yen</a></li>
														<li><a class="dropdown-item shop-currency-option" href="#" data-currency="CAD">🇨🇦 CAD - Canadian Dollar</a></li>
														<li><a class="dropdown-item shop-currency-option" href="#" data-currency="AUD">🇦🇺 AUD - Australian Dollar</a></li>
														<li><a class="dropdown-item shop-currency-option" href="#" data-currency="CHF">🇨🇭 CHF - Swiss Franc</a></li>
														<li><a class="dropdown-item shop-currency-option" href="#" data-currency="CNY">🇨🇳 CNY - Chinese Yuan</a></li>
														<li><a class="dropdown-item shop-currency-option" href="#" data-currency="INR">🇮🇳 INR - Indian Rupee</a></li>
													</ul>
												</div>
											</div>
											<div class="col-md-2 text-md-end">
												<a href="{{ path('app_product_new_public') }}" class="btn btn-success w-100">
													<i class="bi bi-plus-circle me-1"></i>New
												</a>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>

						<div class="row g-4" id="services-container">
							{% for product in products %}
							<div class="col-sm-6 col-lg-4 col-xl-3 service-item" data-title="{{ product.title|lower }}" data-price="{{ product.price }}">
								<div class="card border-0 shadow-lg h-100 service-card" style="border-radius: 20px; transition: all 0.3s ease;">
									<div class="position-relative">
										{% set productImage = product.image ? asset('uploads/products/' ~ product.image) : null %}
										{% if productImage %}
											<img src="{{ productImage }}" class="card-img-top" alt="service image" style="height: 180px; object-fit: cover; border-radius: 20px 20px 0 0;">
										{% else %}
											<div class="card-img-top d-flex align-items-center justify-content-center bg-primary bg-opacity-10" style="height: 180px; border-radius: 20px 20px 0 0;">
												<i class="fas fa-image fa-3x text-primary opacity-25"></i>
											</div>
										{% endif %}
										<div class="position-absolute top-0 end-0 m-3">
											<div class="bg-white rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
												<i class="fas fa-briefcase text-primary"></i>
											</div>
										</div>
									</div>
									<div class="card-body px-4 pt-4">
										<div class="d-flex justify-content-between align-items-center mb-2">
											<span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">{{ product.category.name|default('General') }}</span>
											<span class="text-warning"><i class="fas fa-star me-1"></i>4.5</span>
										</div>
										<h5 class="card-title fw-bold">{{ product.title }}</h5>
										<p class="text-muted small mb-0">By {{ product.freelancer.email|default('Unknown')|split('@')[0] }}</p>
									</div>
									<div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
										<div class="d-flex justify-content-between align-items-center mb-3">
											<span class="h4 text-success fw-bold mb-0 shop-product-price" data-usd-price="{{ product.price }}">${{ product.price }}</span>
											<div class="currency-prices small text-muted" id="shop-price-{{ product.id }}">
												<span class="eur-price">€{{ (product.price * 0.85)|number_format(2) }}</span>
												<span class="gbp-price">£{{ (product.price * 0.73)|number_format(2) }}</span>
											</div>
										</div>
										<div class="d-flex gap-2 flex-wrap">
											<a href="{{ path('app_product_show', {slug: product.slug }) }}" class="btn btn-sm btn-primary flex-grow-1">
												<i class="bi bi-eye me-1"></i>View
											</a>
											<button class="btn btn-sm btn-success flex-grow-1" onclick="addToCart({{ product.id }}, this)">
												<i class="bi bi-cart-plus me-1"></i>Order
											</button>
										</div>
									</div>
								</div>
							</div>
							{% else %}
							<div class="col-12">
								<div class="card border-0 shadow-lg text-center py-5" style="border-radius: 20px;">
									<div class="card-body">
										<div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
											<i class="fas fa-briefcase fa-3x text-primary"></i>
										</div>
										<h4>No Services Found</h4>
										<p class="text-muted mb-4">Be the first to offer a service!</p>
										<a href="{{ path('app_product_new') }}" class="btn btn-primary btn-lg px-5">
											<i class="fas fa-plus me-2"></i>Create First Service
										</a>
									</div>
								</div>
							</div>
							{% endfor %}
						</div>
					</div>

					<!-- Job Requests Tab -->
					<div class="tab-pane fade" id="job-requests" role="tabpanel">
						<div class="card border-0 shadow-lg mb-4" style="border-radius: 20px;">
							<div class="card-body p-4">
								<div class="row align-items-center">
									<div class="col-md-4">
										<h5 class="fw-bold mb-0"><i class="fas fa-clipboard-list text-success me-2"></i>All Job Requests</h5>
									</div>
									<div class="col-md-8">
										<div class="row g-2">
											<div class="col-md-5">
												<div class="input-group">
													<span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
													<input type="text" class="form-control border-start-0" id="jobs-search" placeholder="Search jobs...">
												</div>
											</div>
											<div class="col-md-4">
												<select class="form-select" id="jobs-sort">
													<option value="default">Sort by</option>
													<option value="price-low">Budget: Low to High</option>
													<option value="price-high">Budget: High to Low</option>
													<option value="name-asc">Title: A to Z</option>
													<option value="name-desc">Title: Z to A</option>
												</select>
											</div>
											<div class="col-md-3 text-md-end">
												<a href="{{ path('app_job_new_public') }}" class="btn btn-success w-100">
													<i class="bi bi-plus-circle me-1"></i>New
												</a>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>

						<div class="row g-4" id="jobs-container">
							{% for job in jobs %}
							<div class="col-sm-6 col-lg-4 col-xl-3 job-item" data-title="{{ job.title|lower }}" data-budget="{{ job.budget ?? 0 }}">
								<div class="card border-0 shadow-lg h-100 job-card" style="border-radius: 20px; transition: all 0.3s ease;">
									<div class="position-relative">
										<div class="card-img-top d-flex align-items-center justify-content-center bg-success bg-opacity-10" style="height: 180px; border-radius: 20px 20px 0 0;">
											<i class="fas fa-clipboard-list fa-3x text-success"></i>
										</div>
										{% if job.status == 'open' %}
											<div class="position-absolute top-0 start-0 m-3">
												<span class="badge bg-success rounded-pill px-3 py-2"><i class="fas fa-door-open me-1"></i>Open</span>
											</div>
										{% elseif job.status == 'assigned' %}
											<div class="position-absolute top-0 start-0 m-3">
												<span class="badge bg-warning rounded-pill px-3 py-2"><i class="fas fa-spinner me-1"></i>In Progress</span>
											</div>
										{% else %}
											<div class="position-absolute top-0 start-0 m-3">
												<span class="badge bg-secondary rounded-pill px-3 py-2"><i class="fas fa-check me-1"></i>Closed</span>
											</div>
										{% endif %}
									</div>
									<div class="card-body px-4 pt-4">
										<h5 class="card-title fw-bold">{{ job.title }}</h5>
										<p class="card-text text-muted small text-truncate">{{ job.description|slice(0, 80) }}...</p>
									</div>
									<div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
										<div class="d-flex justify-content-between align-items-center mb-3">
											<span class="badge bg-light text-dark rounded-pill px-3 py-2">{{ job.status|upper }}</span>
											<span class="h4 text-success fw-bold mb-0">${{ job.budget ?? 0 }}</span>
										</div>
										<div class="d-flex gap-2">
											<a href="{{ path('app_job_show', {id: job.id}) }}" class="btn btn-sm btn-info flex-grow-1">
