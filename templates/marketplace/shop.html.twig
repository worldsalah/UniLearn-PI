								<p class="text-muted mb-4">View and manage your orders in the shopping cart.</p>
								<a href="{{ path('app_cart') }}" class="btn btn-warning btn-lg px-5 text-white">
									<i class="bi bi-cart3 me-2"></i>Go to Cart
