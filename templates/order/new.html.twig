{% extends 'front_base.html.twig' %}

{% block title %}Order Service - {{ product.title }}{% endblock %}

{% block content %}
<!-- =======================
Hero Section START -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="text-center mb-4">
                    <div class="mb-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <i class="fas fa-shopping-cart fa-3x text-primary"></i>
                        </div>
                    </div>
                    <h1 class="display-5 fw-bold text-primary mb-3">Complete Your Order</h1>
                    <p class="lead text-muted">Review and confirm your service order</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- =======================
Hero Section END -->

<!-- =======================
Order Form START -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <!-- Order Summary -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-lg h-100" style="border-radius: 20px;">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4">
                            <i class="fas fa-receipt text-primary me-2"></i>Order Summary
                        </h4>
                        
                        <!-- Service Image -->
                        {% if product.image %}
                        <div class="mb-4">
                            <img src="{{ vich_uploader_asset(product, 'imageFile') }}" class="img-fluid rounded-3" alt="{{ product.title }}" style="border-radius: 15px;">
                        </div>
                        {% endif %}
                        
                        <!-- Service Info -->
                        <div class="bg-light rounded-3 p-3 mb-4">
                            <h5 class="fw-bold mb-2">{{ product.title }}</h5>
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 mb-3">
                                <i class="fas fa-folder me-1"></i>{{ product.category.name }}
                            </span>
                            <div class="d-flex align-items-center mt-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                    <span class="fw-bold text-white">{{ product.freelancer.name|slice(0, 1)|upper }}</span>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0">{{ product.freelancer.name }}</h6>
                                    <p class="text-muted small mb-0">Professional Service Provider</p>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Pricing -->
                        <div class="border-top pt-4">
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Service Price</span>
                                <span class="fw-bold">${{ product.price|number_format(2) }}</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Service Fee</span>
                                <span class="fw-bold text-success">$0.00</span>
                            </div>
                            <div class="d-flex justify-content-between pt-3 border-top">
                                <span class="fw-bold h5 mb-0">Total</span>
                                <span class="h5 text-primary mb-0">${{ product.price|number_format(2) }}</span>
                            </div>
                        </div>
                        
                        <!-- Delivery Info -->
                        <div class="mt-4 p-3 rounded-3" style="background: linear-gradient(135deg, rgba(102,126,234,0.1) 0%, rgba(118,75,162,0.1) 100%);">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="fas fa-truck text-primary"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0">Estimated Delivery</h6>
                                    <p class="text-muted small mb-0">3-5 Business Days</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Order Form -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4">
                            <i class="fas fa-clipboard-list text-primary me-2"></i>Order Details
                        </h4>
                        
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                        
                        <!-- Total Price -->
                        <div class="mb-4">
                            {{ form_label(form.totalPrice, 'Total Amount', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 rounded-pill-left" style="border-radius: 20px 0 0 20px;">$</span>
                                {{ form_widget(form.totalPrice, {'attr': {'class': 'form-control border-0 bg-light', 'value': product.price, 'readonly': 'readonly', 'style': 'border-radius: 0 20px 20px 0;'}}) }}
                            </div>
                            {{ form_errors(form.totalPrice) }}
                        </div>
                        
                        <!-- Status -->
                        <div class="mb-4">
                            {{ form_label(form.status, 'Order Status', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.status, {'attr': {'class': 'form-select border-0 bg-light', 'style': 'border-radius: 20px; padding: 12px 20px;'}}) }}
                            {{ form_errors(form.status) }}
                        </div>
                        
                        <!-- Features -->
                        <div class="mb-4">
                            <h6 class="fw-bold mb-3"><i class="fas fa-check-circle text-success me-2"></i>What's Included:</h6>
                            <ul class="list-unstyled">
                                <li class="mb-3 d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="fas fa-check text-success small"></i>
                                    </div>
                                    <span>Professional delivery</span>
                                </li>
                                <li class="mb-3 d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="fas fa-check text-success small"></i>
                                    </div>
                                    <span>Quality assurance</span>
                                </li>
                                <li class="mb-3 d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="fas fa-check text-success small"></i>
                                    </div>
                                    <span>Support included</span>
                                </li>
                                <li class="mb-3 d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="fas fa-check text-success small"></i>
                                    </div>
                                    <span>Money-back guarantee</span>
                                </li>
                            </ul>
                        </div>
                        
                        <!-- Buttons -->
                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">
                                <i class="fas fa-check me-2"></i>Place Order
                            </button>
                            <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="btn btn-outline-secondary btn-lg rounded-pill py-3">
                                <i class="fas fa-arrow-left me-2"></i>Back to Service
                            </a>
                        </div>
                        
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- =======================
Order Form END -->

{% endblock %}
