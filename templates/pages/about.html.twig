{% extends 'front_base.html.twig' %}

{% block title %}About Us - UniLearn{% endblock %}

{% block content %}
<!-- Hero Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="text-center mb-5">
                    <div class="mb-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <i class="fas fa-graduation-cap fa-3x text-primary"></i>
                        </div>
                    </div>
                    <h1 class="display-4 fw-bold text-primary mb-3">About UniLearn</h1>
                    <p class="lead text-muted">Empowering learners worldwide through quality education</p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap mt-4">
                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                            <i class="fas fa-globe me-1"></i>Global Platform
                        </span>
                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                            <i class="fas fa-award me-1"></i>Quality Content
                        </span>
                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">
                            <i class="fas fa-heart me-1"></i>Student Focused
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-lg stat-card" style="border-radius: 20px; transition: all 0.3s ease;">
                    <div class="card-body text-center p-5">
                        <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 80px; height: 80px; box-shadow: 0 10px 30px rgba(13, 110, 253, 0.3);">
                            <i class="fas fa-users fa-2x text-white"></i>
                        </div>
                        <h3 class="display-4 fw-bold text-primary mb-2">50K+</h3>
                        <p class="text-muted mb-0 fw-bold">Active Students</p>
                        <p class="text-muted small">Learning from around the world</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-lg stat-card" style="border-radius: 20px; transition: all 0.3s ease;">
                    <div class="card-body text-center p-5">
                        <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 80px; height: 80px; box-shadow: 0 10px 30px rgba(25, 135, 84, 0.3);">
                            <i class="fas fa-book fa-2x text-white"></i>
                        </div>
                        <h3 class="display-4 fw-bold text-success mb-2">500+</h3>
                        <p class="text-muted mb-0 fw-bold">Online Courses</p>
                        <p class="text-muted small">Across multiple categories</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-lg stat-card" style="border-radius: 20px; transition: all 0.3s ease;">
                    <div class="card-body text-center p-5">
                        <div class="bg-warning bg-gradient rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 80px; height: 80px; box-shadow: 0 10px 30px rgba(255, 193, 7, 0.3);">
                            <i class="fas fa-chalkboard-teacher fa-2x text-white"></i>
                        </div>
                        <h3 class="display-4 fw-bold text-warning mb-2">100+</h3>
                        <p class="text-muted mb-0 fw-bold">Expert Instructors</p>
                        <p class="text-muted small">Industry professionals</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mission Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="card-body p-5">
                        <div class="row align-items-center">
                            <div class="col-lg-5 text-center mb-4 mb-lg-0">
                                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 150px; height: 150px;">
                                    <i class="fas fa-bullseye fa-4x text-primary"></i>
                                </div>
                            </div>
                            <div class="col-lg-7">
                                <h2 class="h3 fw-bold mb-4">Our Mission</h2>
                                <p class="lead text-muted">At UniLearn, we believe that education should be accessible to everyone, everywhere. Our mission is to democratize learning by providing a platform where anyone can acquire new skills, advance their career, and achieve their personal goals.</p>
                                <div class="d-flex align-items-center mt-4">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    <span class="text-muted">Affordable education for all</span>
                                </div>
                                <div class="d-flex align-items-center mt-2">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    <span class="text-muted">Learn anytime, anywhere</span>
                                </div>
                                <div class="d-flex align-items-center mt-2">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    <span class="text-muted">Industry-recognized certificates</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Vision Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="card-body p-5">
                        <div class="row align-items-center">
                            <div class="col-lg-7 order-2 order-lg-1">
                                <h2 class="h3 fw-bold mb-4">Our Vision</h2>
                                <p class="lead text-muted mb-4">We envision a world where geographical boundaries, financial constraints, and time limitations no longer prevent anyone from accessing quality education. Through innovative technology and a commitment to excellence, we're building the future of online learning.</p>
                                
                                <h3 class="h5 fw-bold mb-4">What Sets Us Apart</h3>
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-start">
                                            <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; min-width: 40px;">
                                                <i class="fas fa-user-tie text-success"></i>
                                            </div>
                                            <div>
                                                <h4 class="h6 fw-bold mb-1">Expert-Led Content</h4>
                                                <p class="text-muted small mb-0">Courses by industry professionals</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-start">
                                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; min-width: 40px;">
                                                <i class="fas fa-clock text-primary"></i>
                                            </div>
                                            <div>
                                                <h4 class="h6 fw-bold mb-1">Flexible Learning</h4>
                                                <p class="text-muted small mb-0">Learn at your own pace</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-start">
                                            <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; min-width: 40px;">
                                                <i class="fas fa-laptop-code text-warning"></i>
                                            </div>
                                            <div>
                                                <h4 class="h6 fw-bold mb-1">Interactive Experience</h4>
                                                <p class="text-muted small mb-0">Quizzes, projects & exercises</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-start">
                                            <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; min-width: 40px;">
                                                <i class="fas fa-certificate text-info"></i>
                                            </div>
                                            <div>
                                                <h4 class="h6 fw-bold mb-1">Certified Credentials</h4>
                                                <p class="text-muted small mb-0">Recognized by employers</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5 order-1 order-lg-2 text-center mb-4 mb-lg-0">
                                <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 150px; height: 150px;">
                                    <i class="fas fa-eye fa-4x text-warning"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <div class="card border-0 shadow-lg bg-primary bg-gradient text-white" style="border-radius: 20px;">
                    <div class="card-body p-5">
                        <h2 class="h3 fw-bold mb-3">Ready to Start Your Learning Journey?</h2>
                        <p class="lead opacity-75 mb-4">Join thousands of students already learning on UniLearn</p>
                        <div class="d-flex justify-content-center gap-3 flex-wrap">
                            <a href="{{ path('app_course_grid') }}" class="btn btn-light btn-lg px-5">
                                <i class="fas fa-rocket me-2"></i>Browse Courses
                            </a>
                            {% if not app.user %}
                            <a href="{{ path('app_register') }}" class="btn btn-outline-light btn-lg px-5">
                                <i class="fas fa-user-plus me-2"></i>Sign Up Free
                            </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
.stat-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15) !important;
}
</style>
{% endblock %}
