{% extends 'front_base.html.twig' %}

{% block title %}Help Center - UniLearn{% endblock %}

{% block content %}
<section class="py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="text-center mb-5">
                    <h1 class="display-5 fw-bold text-primary mb-3">
                        <i class="fas fa-life-ring me-2"></i>Help Center
                    </h1>
                    <p class="lead text-muted">Find answers to your questions and get the support you need</p>
                    
                    <div class="input-group input-group-lg mt-4">
                        <input type="text" class="form-control" placeholder="Search for help..." id="helpSearch">
                        <button class="btn btn-primary" type="button" id="helpSearchBtn">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                    <div id="searchResults" class="mt-3 text-start" style="display: none;"></div>
                </div>
            </div>
        </div>
        
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm hover-card">
                    <div class="card-body text-center p-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                            <i class="fas fa-rocket fa-2x text-primary"></i>
                        </div>
                        <h3 class="h5 fw-bold">Getting Started</h3>
                        <p class="text-muted small mb-3">Learn the basics of using UniLearn</p>
                        <a href="#getting-started-section" class="btn btn-outline-primary btn-sm">Explore</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm hover-card">
                    <div class="card-body text-center p-4">
                        <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                            <i class="fas fa-user-graduate fa-2x text-success"></i>
                        </div>
                        <h3 class="h5 fw-bold">Student Guide</h3>
                        <p class="text-muted small mb-3">Tips for effective learning</p>
                        <a href="#student-guide-section" class="btn btn-outline-success btn-sm">Learn More</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm hover-card">
                    <div class="card-body text-center p-4">
                        <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                            <i class="fas fa-chalkboard-teacher fa-2x text-warning"></i>
                        </div>
                        <h3 class="h5 fw-bold">Instructor Guide</h3>
                        <p class="text-muted small mb-3">Create and manage your courses</p>
                        <a href="#instructor-guide-section" class="btn btn-outline-warning btn-sm">View Guide</a>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Getting Started Section -->
        <div id="getting-started-section" class="card shadow-sm border-0 mb-4">
            <div class="card-body p-5">
                <h2 class="h4 fw-bold mb-4"><i class="fas fa-rocket text-primary me-2"></i>Getting Started</h2>
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h4 class="h6 fw-bold"><i class="fas fa-user-plus text-primary me-2"></i>Create an Account</h4>
                            <p class="text-muted small mb-2">Sign up for free and start your learning journey</p>
                            <a href="{{ path('app_register') }}" class="btn btn-sm btn-primary">Sign Up Now</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h4 class="h6 fw-bold"><i class="fas fa-sign-in-alt text-success me-2"></i>Sign In</h4>
                            <p class="text-muted small mb-2">Already have an account? Log in here</p>
                            <a href="{{ path('app_login') }}" class="btn btn-sm btn-success">Sign In</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h4 class="h6 fw-bold"><i class="fas fa-book text-info me-2"></i>Browse Courses</h4>
                            <p class="text-muted small mb-2">Explore our catalog of courses</p>
                            <a href="{{ path('app_course_grid') }}" class="btn btn-sm btn-info text-white">Browse</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h4 class="h6 fw-bold"><i class="fas fa-tags text-warning me-2"></i>Course Categories</h4>
                            <p class="text-muted small mb-2">Find courses by category</p>
                            <a href="{{ path('app_categories') }}" class="btn btn-sm btn-warning">Explore</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Student Guide Section -->
        <div id="student-guide-section" class="card shadow-sm border-0 mb-4">
            <div class="card-body p-5">
                <h2 class="h4 fw-bold mb-4"><i class="fas fa-user-graduate text-success me-2"></i>Student Guide</h2>
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h4 class="h6 fw-bold"><i class="fas fa-graduation-cap text-primary me-2"></i>My Dashboard</h4>
                            <p class="text-muted small mb-2">Access your student dashboard</p>
                            <a href="{{ path('app_student_dashboard') }}" class="btn btn-sm btn-primary">Go to Dashboard</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h4 class="h6 fw-bold"><i class="fas fa-book-open text-success me-2"></i>My Courses</h4>
                            <p class="text-muted small mb-2">View your enrolled courses</p>
                            <a href="{{ path('app_student_courses') }}" class="btn btn-sm btn-success">View Courses</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h4 class="h6 fw-bold"><i class="fas fa-certificate text-warning me-2"></i>My Certificates</h4>
                            <p class="text-muted small mb-2">View and download your certificates</p>
                            <a href="{{ path('app_student_certificates') }}" class="btn btn-sm btn-warning">View Certificates</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h4 class="h6 fw-bold"><i class="fas fa-cog text-info me-2"></i>Account Settings</h4>
                            <p class="text-muted small mb-2">Manage your profile and preferences</p>
                            <a href="{{ path('app_student_settings') }}" class="btn btn-sm btn-info text-white">Settings</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Instructor Guide Section -->
        <div id="instructor-guide-section" class="card shadow-sm border-0 mb-4">
            <div class="card-body p-5">
                <h2 class="h4 fw-bold mb-4"><i class="fas fa-chalkboard-teacher text-warning me-2"></i>Instructor Guide</h2>
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h4 class="h6 fw-bold"><i class="fas fa-tachometer-alt text-primary me-2"></i>Instructor Dashboard</h4>
                            <p class="text-muted small mb-2">Manage your courses and students</p>
                            <a href="{{ path('app_instructor_dashboard') }}" class="btn btn-sm btn-primary">Go to Dashboard</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h4 class="h6 fw-bold"><i class="fas fa-plus-circle text-success me-2"></i>Create a Course</h4>
                            <p class="text-muted small mb-2">Start creating your new course</p>
                            <a href="{{ path('app_course_create') }}" class="btn btn-sm btn-success">Create Course</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h4 class="h6 fw-bold"><i class="fas fa-list text-info me-2"></i>Manage Courses</h4>
                            <p class="text-muted small mb-2">Edit and manage your existing courses</p>
                            <a href="{{ path('app_instructor_manage_courses') }}" class="btn btn-sm btn-info text-white">Manage</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h4 class="h6 fw-bold"><i class="fas fa-users text-warning me-2"></i>My Students</h4>
                            <p class="text-muted small mb-2">View students enrolled in your courses</p>
                            <a href="{{ path('app_instructor_students') }}" class="btn btn-sm btn-warning">View Students</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Popular Articles Section -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-5">
                <h2 class="h4 fw-bold mb-4"><i class="fas fa-star text-warning me-2"></i>Popular Articles</h2>
                <div class="list-group list-group-flush" id="articlesList">
                    <a href="#article-1" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center article-link" data-article="1">
                        <span><i class="fas fa-file-alt text-muted me-2"></i>How to create an account</span>
                        <i class="fas fa-chevron-right text-muted"></i>
                    </a>
                    <a href="#article-2" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center article-link" data-article="2">
                        <span><i class="fas fa-file-alt text-muted me-2"></i>Enrolling in your first course</span>
                        <i class="fas fa-chevron-right text-muted"></i>
                    </a>
                    <a href="#article-3" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center article-link" data-article="3">
                        <span><i class="fas fa-file-alt text-muted me-2"></i>How to get a certificate</span>
                        <i class="fas fa-chevron-right text-muted"></i>
                    </a>
                    <a href="#article-4" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center article-link" data-article="4">
                        <span><i class="fas fa-file-alt text-muted me-2"></i>Payment methods accepted</span>
                        <i class="fas fa-chevron-right text-muted"></i>
                    </a>
                    <a href="#article-5" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center article-link" data-article="5">
                        <span><i class="fas fa-file-alt text-muted me-2"></i>Resetting your password</span>
                        <i class="fas fa-chevron-right text-muted"></i>
                    </a>
                </div>
                
                <!-- Article Content -->
                <div id="article-content" class="mt-4" style="display: none;">
                    <div class="card bg-light border-0">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h3 id="article-title" class="h5 fw-bold"></h3>
                                <button class="btn btn-sm btn-outline-secondary" onclick="closeArticle()">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <div id="article-body"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h3 class="h5 fw-bold mb-3"><i class="fas fa-credit-card text-primary me-2"></i>Billing & Payments</h3>
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2"><a href="#article-4" class="text-decoration-none article-link" data-article="4"><i class="fas fa-angle-right me-2"></i>How to purchase a course</a></li>
                            <li class="mb-2"><a href="#article-6" class="text-decoration-none article-link" data-article="6"><i class="fas fa-angle-right me-2"></i>Refund policy</a></li>
                            <li class="mb-2"><a href="{{ path('app_student_dashboard') }}" class="text-decoration-none"><i class="fas fa-angle-right me-2"></i>Update payment method</a></li>
                            <li class="mb-0"><a href="{{ path('app_student_dashboard') }}" class="text-decoration-none"><i class="fas fa-angle-right me-2"></i>View transaction history</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h3 class="h5 fw-bold mb-3"><i class="fas fa-cog text-primary me-2"></i>Account Settings</h3>
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2"><a href="{{ path('app_student_settings') }}" class="text-decoration-none"><i class="fas fa-angle-right me-2"></i>Update profile information</a></li>
                            <li class="mb-2"><a href="#article-5" class="text-decoration-none article-link" data-article="5"><i class="fas fa-angle-right me-2"></i>Change email address</a></li>
                            <li class="mb-2"><a href="{{ path('app_student_settings') }}" class="text-decoration-none"><i class="fas fa-angle-right me-2"></i>Notification preferences</a></li>
                            <li class="mb-0"><a href="{{ path('app_student_settings') }}" class="text-decoration-none text-danger"><i class="fas fa-angle-right me-2"></i>Delete account</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="text-center mt-5">
            <p class="text-muted mb-3">Can't find what you're looking for?</p>
            <a href="{{ path('app_contact_support') }}" class="btn btn-primary">
                <i class="fas fa-envelope me-2"></i>Contact Support
            </a>
            <a href="{{ path('app_faq') }}" class="btn btn-outline-primary ms-2">
                <i class="fas fa-question-circle me-2"></i>View FAQ
            </a>
        </div>
    </div>
</section>

<!-- Article Modal -->
<div class="modal fade" id="articleModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalArticleTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalArticleBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a href="{{ path('app_contact_support') }}" class="btn btn-primary">Need More Help?</a>
            </div>
        </div>
    </div>
</div>

<style>
.hover-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.hover-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
}
.article-link:hover {
    background-color: #f8f9fa;
}
.highlight {
    background-color: #fff3cd;
    padding: 2px 4px;
    border-radius: 3px;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const articles = {
        1: {
            title: 'How to create an account',
            content: `
                <h6>Creating your UniLearn account is quick and easy:</h6>
                <ol>
                    <li class="mb-2">Click the <strong>"Sign Up"</strong> button in the top right corner of the homepage</li>
                    <li class="mb-2">Enter your <strong>email address</strong> and create a secure <strong>password</strong></li>
                    <li class="mb-2">Fill in your basic information (name, etc.)</li>
                    <li class="mb-2">Check your email for a verification link</li>
                    <li class="mb-2">Click the link to verify your account</li>
                    <li class="mb-2">You're ready to start learning!</li>
                </ol>
                <div class="alert alert-info mt-3">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Tip:</strong> Use a strong password with at least 8 characters, including numbers and special characters.
                </div>
                <div class="mt-3">
                    <a href="{{ path('app_register') }}" class="btn btn-primary">Create Account Now</a>
                </div>
            `
        },
        2: {
            title: 'Enrolling in your first course',
            content: `
                <h6>Follow these steps to enroll in a course:</h6>
                <ol>
                    <li class="mb-2">Browse our <a href="{{ path('app_course_grid') }}">course catalog</a> or use the search bar</li>
                    <li class="mb-2">Click on a course that interests you to view details</li>
                    <li class="mb-2">Review the course curriculum, instructor info, and reviews</li>
                    <li class="mb-2">Click the <strong>"Enroll Now"</strong> or <strong>"Add to Cart"</strong> button</li>
                    <li class="mb-2">Complete the payment process (if it's a paid course)</li>
                    <li class="mb-2">Access your course from <a href="{{ path('app_student_courses') }}">My Courses</a></li>
                </ol>
                <div class="alert alert-success mt-3">
                    <i class="fas fa-gift me-2"></i>
                    <strong>Free courses:</strong> Many of our courses are free! Look for the "Free" badge.
                </div>
            `
        },
        3: {
            title: 'How to get a certificate',
            content: `
                <h6>Earning your certificate is simple:</h6>
                <ol>
                    <li class="mb-2">Complete all required lessons in the course</li>
                    <li class="mb-2">Pass any quizzes or assessments (if required)</li>
                    <li class="mb-2">Complete the course with at least 80% progress</li>
                    <li class="mb-2">Go to <a href="{{ path('app_student_certificates') }}">My Certificates</a></li>
                    <li class="mb-2">Download or share your certificate</li>
                </ol>
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Note:</strong> Certificates are only available for completed courses.
                </div>
                <div class="mt-3">
                    <a href="{{ path('app_student_certificates') }}" class="btn btn-warning">View My Certificates</a>
                </div>
            `
        },
        4: {
            title: 'Payment methods accepted',
            content: `
                <h6>We accept the following payment methods:</h6>
                <ul>
                    <li class="mb-2"><i class="fab fa-cc-visa text-primary me-2"></i>Visa</li>
                    <li class="mb-2"><i class="fab fa-cc-mastercard text-danger me-2"></i>MasterCard</li>
                    <li class="mb-2"><i class="fab fa-cc-amex text-info me-2"></i>American Express</li>
                    <li class="mb-2"><i class="fab fa-cc-paypal text-primary me-2"></i>PayPal</li>
                    <li class="mb-2"><i class="fas fa-university text-success me-2"></i>Bank Transfer</li>
                </ul>
                <div class="alert alert-info mt-3">
                    <i class="fas fa-shield-alt me-2"></i>
                    <strong>Secure Payments:</strong> All transactions are encrypted and secure.
                </div>
                <h6 class="mt-4">Installment Plans</h6>
                <p class="text-muted">For courses above $100, we offer 3-month installment plans with 0% interest.</p>
            `
        },
        5: {
            title: 'Resetting your password',
            content: `
                <h6>To reset your password:</h6>
                <ol>
                    <li class="mb-2">Go to the <a href="{{ path('app_login') }}">Sign In</a> page</li>
                    <li class="mb-2">Click <strong>"Forgot Password?"</strong></li>
                    <li class="mb-2">Enter your registered email address</li>
                    <li class="mb-2">Check your email for the reset link</li>
                    <li class="mb-2">Click the link and create a new password</li>
                </ol>
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-clock me-2"></i>
                    <strong>Note:</strong> Password reset links expire after 24 hours.
                </div>
                <div class="mt-3">
                    <a href="{{ path('app_forgot_password') }}" class="btn btn-primary">Reset Password Now</a>
                </div>
            `
        },
        6: {
            title: 'Refund Policy',
            content: `
                <h6>Our 30-Day Money-Back Guarantee:</h6>
                <ul>
                    <li class="mb-2">Full refund within 30 days of purchase</li>
                    <li class="mb-2">Only available if you've completed less than 50% of the course</li>
                    <li class="mb-2">Refunds are processed within 5-7 business days</li>
                    <li class="mb-2">No questions asked for first-time refunds</li>
                </ul>
                <h6 class="mt-4">How to Request a Refund:</h6>
                <ol>
                    <li class="mb-2">Go to your <a href="{{ path('app_student_courses') }}">My Courses</a> page</li>
                    <li class="mb-2">Click on the course you want to refund</li>
                    <li class="mb-2">Select "Request Refund" from the options</li>
                    <li class="mb-2">Fill out the refund form</li>
                    <li class="mb-2">Submit and wait for confirmation</li>
                </ol>
                <div class="alert alert-info mt-3">
                    <i class="fas fa-info-circle me-2"></i>
                    For refund inquiries, <a href="{{ path('app_contact_support') }}">contact support</a>.
                </div>
            `
        }
    };
    
    // Search functionality
    const searchInput = document.getElementById('helpSearch');
    const searchBtn = document.getElementById('helpSearchBtn');
    const searchResults = document.getElementById('searchResults');
    
    function performSearch() {
        const query = searchInput.value.toLowerCase().trim();
        if (query.length < 2) {
            searchResults.style.display = 'none';
            return;
        }
        
        let results = [];
        
        // Search through articles
        Object.keys(articles).forEach(key => {
            const article = articles[key];
            if (article.title.toLowerCase().includes(query) || 
                article.content.toLowerCase().includes(query)) {
                results.push({
                    type: 'article',
                    id: key,
                    title: article.title
                });
            }
        });
        
        // Search through quick links
        const quickLinks = [
            { title: 'Create Account', url: '{{ path("app_register") }}', keywords: ['register', 'sign up', 'create', 'account'] },
            { title: 'Sign In', url: '{{ path("app_login") }}', keywords: ['login', 'sign in', 'log in'] },
            { title: 'Browse Courses', url: '{{ path("app_course_grid") }}', keywords: ['courses', 'browse', 'learn', 'catalog'] },
            { title: 'Student Dashboard', url: '{{ path("app_student_dashboard") }}', keywords: ['dashboard', 'student', 'my courses'] },
            { title: 'Instructor Dashboard', url: '{{ path("app_instructor_dashboard") }}', keywords: ['instructor', 'teach', 'create course'] },
            { title: 'Contact Support', url: '{{ path("app_contact_support") }}', keywords: ['contact', 'support', 'help'] },
            { title: 'FAQ', url: '{{ path("app_faq") }}', keywords: ['faq', 'questions', 'answers'] },
        ];
        
        quickLinks.forEach(link => {
            if (link.title.toLowerCase().includes(query) || 
                link.keywords.some(k => query.includes(k))) {
                results.push({
                    type: 'link',
                    title: link.title,
                    url: link.url
                });
            }
        });
        
        if (results.length === 0) {
            searchResults.innerHTML = `
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    No results found. Try different keywords or <a href="{{ path('app_contact_support') }}">contact support</a>.
                </div>
            `;
        } else {
            let html = '<div class="list-group">';
            results.forEach(result => {
                if (result.type === 'article') {
                    html += `
                        <a href="#" class="list-group-item list-group-item-action article-link" data-article="${result.id}">
                            <i class="fas fa-file-alt text-primary me-2"></i>${result.title}
                            <span class="badge bg-secondary float-end">Article</span>
                        </a>
                    `;
                } else {
                    html += `
                        <a href="${result.url}" class="list-group-item list-group-item-action">
                            <i class="fas fa-link text-success me-2"></i>${result.title}
                            <span class="badge bg-info float-end">Quick Link</span>
                        </a>
                    `;
                }
            });
            html += '</div>';
            searchResults.innerHTML = html;
        }
        
        searchResults.style.display = 'block';
        
        // Re-attach article click handlers
        attachArticleHandlers();
    }
    
    searchBtn.addEventListener('click', performSearch);
    searchInput.addEventListener('keyup', function(e) {
        if (e.key === 'Enter') {
            performSearch();
        } else {
            performSearch();
        }
    });
    
    // Article click handler
    function attachArticleHandlers() {
        document.querySelectorAll('.article-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const articleId = this.dataset.article;
                if (articles[articleId]) {
                    showModal(articles[articleId]);
                }
            });
        });
    }
    
    function showModal(article) {
        const modal = new bootstrap.Modal(document.getElementById('articleModal'));
        document.getElementById('modalArticleTitle').textContent = article.title;
        document.getElementById('modalArticleBody').innerHTML = article.content;
        modal.show();
    }
    
    attachArticleHandlers();
    
    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
            const href = this.getAttribute('href');
            if (href.startsWith('#article-')) {
                return; // Let article handler deal with it
            }
            const target = document.querySelector(href);
            if (target) {
                e.preventDefault();
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        });
    });
});
</script>
{% endblock %}
