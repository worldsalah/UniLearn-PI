{% extends 'front_base.html.twig' %}

{% block title %}{{ product.title }} - Service Details{% endblock %}

{% block stylesheets %}
<style>
.contact-modal-body {
    max-height: 300px;
    overflow-y: auto;
}
</style>
{% endblock %}

{% block content %}
<!-- =======================
Hero Section START -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="text-center mb-4">
                    <div class="mb-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <i class="fas fa-concierge-bell fa-3x text-primary"></i>
                        </div>
                    </div>
                    <h1 class="display-5 fw-bold text-primary mb-3">{{ product.title }}</h1>
                    <p class="lead text-muted">Professional service by {{ product.freelancer.name|default(product.freelancer.email) }}</p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap mt-4">
                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                            <i class="fas fa-tag me-1"></i>{{ product.category.name }}
                        </span>
                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                            <i class="fas fa-dollar-sign me-1"></i>${{ product.price|number_format(2) }}
                        </span>
                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">
                            <i class="fas fa-calendar me-1"></i>{{ product.createdAt|date('d M Y') }}
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- =======================
Hero Section END -->

<!-- =======================
Service Details START -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row g-4">
            <!-- Main content START -->
            <div class="col-lg-8">
                <!-- Service Image Card -->
                {% if product.image %}
                <div class="card border-0 shadow-lg mb-4" style="border-radius: 20px;">
                    <div class="card-body p-0">
                        <img src="{{ vich_uploader_asset(product, 'imageFile') }}" class="img-fluid rounded-top" alt="{{ product.title }}" style="border-radius: 20px;">
                    </div>
                </div>
                {% endif %}
                
                <!-- Service Details Card -->
                <div class="card border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="card-body p-4">
                        <!-- Service Title and Meta -->
                        <div class="d-flex justify-content-between align-items-start mb-4 pb-4 border-bottom">
                            <div>
                                <h2 class="fw-bold mb-3">{{ product.title }}</h2>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                                        <i class="fas fa-folder me-1"></i>{{ product.category.name }}
                                    </span>
                                    <span class="badge bg-light text-dark rounded-pill px-3 py-2">
                                        <i class="fas fa-calendar-alt me-1"></i>{{ product.createdAt|date('d M Y') }}
                                    </span>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="bg-success bg-opacity-10 rounded-3 px-4 py-3">
                                    <span class="h4 text-success mb-0">${{ product.price|number_format(2) }}</span>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Service Description -->
                        <div class="mb-4">
                            <h4 class="fw-bold mb-3">
                                <i class="fas fa-file-alt text-primary me-2"></i>Service Description
                            </h4>
                            <div class="text-muted" style="line-height: 1.8;">
                                {{ product.description|raw }}
                            </div>
                        </div>
                        
                        <!-- Freelancer Info -->
                        <div class="border-top pt-4">
                            <h4 class="fw-bold mb-4">
                                <i class="fas fa-user text-primary me-2"></i>About the Freelancer
                            </h4>
                            <div class="d-flex align-items-center p-3 bg-light rounded-3">
                                <div class="avatar avatar-md me-3">
                                    <div class="avatar-img rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                        <span class="fw-bold text-white fs-4">{{ product.freelancer.name|slice(0, 1)|upper }}</span>
                                    </div>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">{{ product.freelancer.name }}</h6>
                                    <p class="text-muted small mb-0"><i class="fas fa-briefcase me-1"></i>Professional Service Provider</p>
                                </div>
                                <div class="ms-auto">
                                    <button class="btn btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#contactModal">
                                        <i class="fas fa-envelope me-2"></i>Contact
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Sidebar START -->
            <div class="col-lg-4">
                <!-- Order Card -->
                <div class="card border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="card-body p-4">
                        <h5 class="card-title fw-bold mb-4">
                            <i class="fas fa-shopping-cart text-primary me-2"></i>Order This Service
                        </h5>
                        
                        <!-- Price Display -->
                        <div class="bg-light rounded-3 p-4 mb-4 text-center">
                            <span class="text-muted d-block mb-2">Total Price</span>
                            <span class="h3 text-primary mb-0">${{ product.price|number_format(2) }}</span>
                        </div>
                        
                        <!-- Order Button -->
                        <button class="btn btn-primary w-100 mb-3 rounded-pill py-3" data-bs-toggle="modal" data-bs-target="#orderModal" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">
                            <i class="fas fa-shopping-cart me-2"></i>Order Now
                        </button>
                        
                        <!-- Contact Button -->
                        <button class="btn btn-outline-primary w-100 rounded-pill py-3">
                            <i class="fas fa-envelope me-2"></i>Contact Freelancer
                        </button>
                        
                        <!-- Service Features -->
                        <div class="mt-4">
                            <h6 class="fw-bold mb-3"><i class="fas fa-check-circle text-success me-2"></i>Service Includes:</h6>
                            <ul class="list-unstyled">
                                <li class="mb-3 d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="fas fa-check text-success small"></i>
                                    </div>
                                    <span>Professional delivery</span>
                                </li>
                                <li class="mb-3 d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="fas fa-check text-success small"></i>
                                    </div>
                                    <span>Quality assurance</span>
                                </li>
                                <li class="mb-3 d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="fas fa-check text-success small"></i>
                                    </div>
                                    <span>Support included</span>
                                </li>
                                <li class="mb-3 d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="fas fa-check text-success small"></i>
                                    </div>
                                    <span>Timely completion</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- =======================
Service Details END -->

<!-- Order Modal -->
<div class="modal fade" id="orderModal" tabindex="-1" aria-labelledby="orderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: none;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="orderModalLabel">Confirm Your Order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="fas fa-shopping-cart text-primary fa-2x"></i>
                    </div>
                    <h6 class="fw-bold">{{ product.title }}</h6>
                    <p class="text-muted small">by {{ product.freelancer.name }}</p>
                </div>
                <div class="bg-light rounded-3 p-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Service Price:</span>
                        <span>${{ product.price|number_format(2) }}</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold pt-2 border-top">
                        <span>Total:</span>
                        <span class="text-primary">${{ product.price|number_format(2) }}</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <a href="{{ path('app_order_new', {'id': product.id}) }}" class="btn btn-primary rounded-pill px-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; text-decoration: none;">
                    <i class="fas fa-check me-2"></i>Confirm Order
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Contact Modal -->
<div class="modal fade" id="contactModal" tabindex="-1" aria-labelledby="contactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: none;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="contactModalLabel">Contact Freelancer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="fas fa-envelope text-primary fa-2x"></i>
                    </div>
                    <h6 class="fw-bold">{{ product.freelancer.name }}</h6>
                    <p class="text-muted small">{{ product.freelancer.email }}</p>
                </div>
                <form id="contactForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Subject</label>
                        <input type="text" class="form-control rounded-3" placeholder="Enter subject" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Message</label>
                        <textarea class="form-control rounded-3" rows="4" placeholder="Write your message here..." required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="sendContactMessage()" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">
                    <i class="fas fa-paper-plane me-2"></i>Send Message
                </button>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function sendContactMessage() {
    // Show success message
    const modal = bootstrap.Modal.getInstance(document.getElementById('contactModal'));
    modal.hide();
    
    // Show toast notification
    const toast = document.createElement('div');
    toast.className = 'position-fixed bottom-0 end-0 p-3';
    toast.style.zIndex = '9999';
    toast.innerHTML = `
        <div class="toast show" role="alert">
            <div class="toast-header bg-success text-white">
                <i class="fas fa-check-circle me-2"></i>
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">
                Message sent successfully to {{ product.freelancer.name|e('js') }}!
            </div>
        </div>
    `;
    document.body.appendChild(toast);
    
    setTimeout(() => toast.remove(), 5000);
}
</script>
{% endblock %}
