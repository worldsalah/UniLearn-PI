{% extends 'front_base.html.twig' %}

{% block title %}Student Dashboard - Unilearn{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.bg-gradient-gold {
    background: linear-gradient(135deg, #FFD700, #FFA500);
}

.certificate-card {
    transition: all 0.3s ease;
    border-radius: 15px;
    overflow: hidden;
}

.certificate-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

.certificate-icon {
    box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
    transition: all 0.3s ease;
}

.certificate-card:hover .certificate-icon {
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(255, 215, 0, 0.4);
}

.achievement-item {
    transition: all 0.3s ease;
    border: 1px solid transparent;
}

.achievement-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    border-color: rgba(0,123,255,0.1);
}

.achievement-icon {
    transition: all 0.3s ease;
}

.achievement-item:hover .achievement-icon {
    transform: scale(1.05);
}

.hover-lift {
    cursor: default;
}

.card-hover-shadow {
    transition: all 0.3s ease;
}

.card-hover-shadow:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.15);
}

.timeline {
    position: relative;
    padding-left: 30px;
}

.timeline::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #e9ecef;
}

.timeline-item {
    position: relative;
    margin-bottom: 20px;
}

.timeline-point {
    position: absolute;
    left: -25px;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid white;
}

.timeline-content {
    background: #f8f9fa;
    padding: 15px;
    border-radius: 8px;
    border-left: 3px solid #007bff;
}

.course-card {
    transition: all 0.3s ease;
    border-radius: 12px;
    overflow: hidden;
}

.course-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
}

.course-card img {
    transition: transform 0.3s ease;
}

.course-card:hover img {
    transform: scale(1.05);
}

.course-card .progress-bar {
    transition: width 0.3s ease;
}

@media (max-width: 768px) {
    .certificate-card {
        margin-bottom: 1rem;
    }
    
    .achievement-item {
        margin-bottom: 1rem;
    }
}
</style>
{% endblock %}

{% block content %}
<!-- **************** MAIN CONTENT START **************** -->
<main>

<!-- =======================
Student Dashboard START -->
<section class="pt-4">
    <div class="container">
        <div class="row">
            <!-- Left sidebar START -->
            <div class="col-lg-3">
                <!-- User profile START -->
                <div class="card shadow mb-4">
                    <div class="card-body text-center p-4">
                        <div class="avatar avatar-xl mb-3">
                            {% if user.profileImage %}
                                <img class="avatar-img rounded-circle" src="{{ asset('uploads/profile/' ~ user.profileImage) }}" alt="{{ user.fullName }}">
                            {% else %}
                                <div class="avatar-img rounded-circle bg-primary d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                    <span class="text-white fs-4 fw-bold">{{ user.fullName|first|upper }}</span>
                                </div>
                            {% endif %}
                        </div>
                        <h5 class="mb-1">{{ user.fullName }}</h5>
                        <p class="mb-2">{{ user.email }}</p>
                        <div class="d-flex justify-content-center gap-2">
                            <a href="#" class="btn btn-sm btn-primary">Edit Profile</a>
                        </div>
                    </div>
                </div>
                <!-- User profile END -->

                <!-- Gamification Widget START -->
                <div class="card shadow mb-4">
                    <div class="card-body p-3">
                        <h6 class="mb-3">
                            <i class="fas fa-trophy text-warning me-2"></i>
                            My Progress
                        </h6>
                        <div class="text-center mb-3">
                            <div class="badge bg-primary fs-6 mb-2">
                                <i class="fas fa-star me-1"></i>
                                <span id="total-xp">{{ stats.total_points }}</span> XP
                            </div>
                            <small class="text-muted">Total Points</small>
                        </div>
                        <div class="progress mb-3" style="height: 8px;">
                            <div class="progress-bar progress-bar-animated" id="level-progress" style="width: {{ progress.progress }}%; background: linear-gradient(90deg, #6366f1 0%, #8b5cf6 100%);"></div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <small class="text-muted">Level: <span id="current-level">{{ stats.current_level.name|default('Beginner') }}</span></small>
                            <small class="text-muted">Rank: #<span id="user-rank">{{ stats.rank }}</span></small>
                        </div>
                        <div class="d-grid gap-2">
                            <a href="{{ path('app_gamification_profile') }}" class="btn btn-sm btn-primary">
                                <i class="fas fa-trophy me-1"></i>View Profile
                            </a>
                        </div>
                    </div>
                </div>
                <!-- Gamification Widget END -->

                <!-- Navigation menu START -->
                <div class="card shadow">
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            <a href="{{ path('app_student_dashboard') }}" class="list-group-item list-group-item-action active">
                                <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                            </a>
                            <a href="{{ path('app_student_courses') }}" class="list-group-item list-group-item-action">
                                <i class="fas fa-book me-2"></i>My Courses
                            </a>
                            <a href="{{ path('app_student_certificates') }}" class="list-group-item list-group-item-action">
                                <i class="fas fa-certificate me-2"></i>Certificates
                            </a>
                            <a href="{{ path('app_student_quiz_analysis') }}" class="list-group-item list-group-item-action">
                                <i class="fas fa-brain me-2"></i>AI Quiz Analysis
                            </a>
                            <a href="/student-ai-roadmap" class="list-group-item list-group-item-action" onclick="console.log('AI Recommendations clicked'); window.location.href='/student-ai-roadmap'; return false;">
                                <i class="fas fa-lightbulb me-2"></i>AI Recommendations
                            </a>
                            <a href="{{ path('app_gamification_profile') }}" class="list-group-item list-group-item-action">
                                <i class="fas fa-trophy me-2"></i>My Gamification
                            </a>
                            <a href="{{ path('app_student_settings') }}" class="list-group-item list-group-item-action">
                                <i class="fas fa-cog me-2"></i>Settings
                            </a>
                        </div>
                    </div>
                </div>
                <!-- Navigation menu END -->
            </div>

            <!-- Main content START -->
            <div class="col-lg-9">
                <!-- Welcome header START -->
                <div class="card shadow mb-4">
                    <div class="card-body p-4">
                        <h3 class="mb-1">Welcome back, {{ user.firstName|default(user.fullName) }}!</h3>
                        <p class="mb-0">Continue learning and track your progress.</p>
                    </div>
                </div>
                <!-- Welcome header END -->

                <!-- Stats START -->
