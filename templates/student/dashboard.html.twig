{% block javascripts %}
<script>
// Real-time progress updates for student dashboard
class DashboardProgressUpdater {
    constructor() {
        this.updateInterval = null;
        this.init();
    }

    init() {
        // Start real-time updates
        this.startRealTimeUpdates();
        
        // Initial update
        this.updateProgressData();
    }

    startRealTimeUpdates() {
        // Update every 5 seconds
        this.updateInterval = setInterval(() => {
            this.updateProgressData();
        }, 5000);
    }

    updateProgressData() {
        fetch('/gamification/api/stats')
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    console.error('Error fetching stats:', data.error);
                    return;
                }
                
                const stats = data.stats;
                const progress = data.progress;
                
                // Update XP display
                this.animateValue('total-xp', stats.total_points);
                
                // Update level
                const levelElement = document.getElementById('current-level');
                if (levelElement && levelElement.textContent !== stats.current_level.name) {
                    this.animateTextChange(levelElement, stats.current_level.name);
                }
                
                // Update rank
                this.animateValue('user-rank', stats.rank);
                
                // Update progress bar
                const progressBar = document.getElementById('level-progress');
                if (progressBar) {
                    const currentWidth = parseFloat(progressBar.style.width);
                    const newWidth = progress.progress;
                    
                    if (currentWidth !== newWidth) {
                        progressBar.style.width = newWidth + '%';
                        progressBar.setAttribute('aria-valuenow', Math.round(newWidth));
                        
                        // Add pulse effect for significant changes
                        if (Math.abs(newWidth - currentWidth) > 5) {
                            this.addPulseEffect(progressBar);
                        }
                    }
                }
            })
            .catch(error => {
                console.error('Error updating progress:', error);
            });
    }

    animateValue(elementId, newValue) {
        const element = document.getElementById(elementId);
        if (!element) return;
        
        const currentValue = parseInt(element.textContent.replace(/[^0-9]/g, '')) || 0;
        const targetValue = typeof newValue === 'string' ? parseInt(newValue.replace(/[^0-9]/g, '')) : newValue;
        
        if (currentValue === targetValue) return;
        
        const duration = 600;
        const startTime = performance.now();
        
        const animate = (currentTime) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            
            // Easing function
            const easeOutQuart = 1 - Math.pow(1 - progress, 4);
            const current = Math.floor(currentValue + (targetValue - currentValue) * easeOutQuart);
            
            element.textContent = current;
            
            if (progress < 1) {
                requestAnimationFrame(animate);
            } else {
                element.textContent = newValue;
            }
        };
        
        requestAnimationFrame(animate);
    }

    animateTextChange(element, newText) {
        element.style.opacity = '0';
        element.style.transform = 'scale(0.9)';
        
        setTimeout(() => {
            element.textContent = newText;
            element.style.opacity = '1';
            element.style.transform = 'scale(1)';
        }, 200);
    }

    addPulseEffect(element) {
        element.classList.add('progress-pulse');
        setTimeout(() => {
            element.classList.remove('progress-pulse');
        }, 1500);
    }

    destroy() {
        if (this.updateInterval) {
            clearInterval(this.updateInterval);
        }
    }
}

// Initialize the dashboard progress updater
let dashboardProgressUpdater;

document.addEventListener('DOMContentLoaded', () => {
    dashboardProgressUpdater = new DashboardProgressUpdater();
});

// Clean up on page unload
window.addEventListener('beforeunload', () => {
    if (dashboardProgressUpdater) {
        dashboardProgressUpdater.destroy();
    }
});
</script>

<style>
.progress-pulse {
    animation: dashboardProgressPulse 1.5s cubic-bezier(0.4, 0, 0.6, 1);
}

@keyframes dashboardProgressPulse {
    0% {
        box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.4);
    }
    70% {
        box-shadow: 0 0 0 8px rgba(99, 102, 241, 0);
    }
    100% {
        box-shadow: 0 0 0 0 rgba(99, 102, 241, 0);
    }
}

#total-xp,
#current-level,
#user-rank {
    transition: all 0.3s ease;
}

.progress-bar-animated {
    background-image: linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.15) 25%,
        transparent 25%,
        transparent 50%,
        rgba(255, 255, 255, 0.15) 50%,
        rgba(255, 255, 255, 0.15) 75%,
        transparent 75%,
        transparent
    );
    background-size: 40px 40px;
    animation: progress-bar-stripes 2s linear infinite;
}

@keyframes progress-bar-stripes {
    0% {
        background-position: 40px 0;
    }
    100% {
        background-position: 0 0;
    }
}
</style>
{% endblock %}
{% endblock %}
