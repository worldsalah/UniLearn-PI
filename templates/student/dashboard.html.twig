                                </div>
                                <h4 class="mb-0">{{ totalCertificates }}</h4>
                                <p class="mb-0 small text-muted">Certificates</p>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Stats END -->

                <!-- Continue learning START -->
                {% if enrolledCourses|length > 0 %}
                <div class="card shadow mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="mb-0">Continue Learning</h5>
                            <a href="{{ path('app_student_courses') }}" class="btn btn-sm btn-primary">View All</a>
                        </div>
                        
                        <div class="row g-4">
                            {% for courseData in enrolledCourses|slice(0, 2) %}
                            <div class="col-md-6">
                                <div class="card border-0 course-card hover-lift">
                                    <div class="card-body">
                                        <div class="d-flex align-items-start">
                                            {% if courseData.thumbnailUrl %}
                                                <img src="{{ asset('uploads/courses/' ~ courseData.thumbnailUrl) }}" class="rounded me-3" width="80" alt="{{ courseData.title }}">
                                            {% else %}
                                                <div class="rounded bg-primary d-flex align-items-center justify-content-center me-3" style="width: 80px; height: 80px;">
                                                    <i class="fas fa-book text-white fs-4"></i>
                                                </div>
                                            {% endif %}
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1 fw-semibold">{{ courseData.title }}</h6>
                                                <p class="mb-2 small text-muted">by {{ courseData.instructor ? courseData.instructor.getFullName() : 'Instructor' }}</p>
                                                <div class="progress mb-2" style="height: 8px;">
                                                    <div class="progress-bar bg-primary" style="width: {{ courseData.progress|default(0) }}%"></div>
                                                </div>
                                                <div class="d-flex justify-content-between">
                                                    <small class="text-muted">{{ courseData.progress|default(0) }}% Complete</small>
                                                    <small class="text-muted">
                                                        {% if courseData.progress == 100 %}
                                                            <span class="text-success">Completed</span>
                                                        {% elseif courseData.progress > 0 %}
                                                            <span class="text-primary">In Progress</span>
                                                        {% else %}
                                                            <span class="text-muted">Not Started</span>
                                                        {% endif %}
                                                    </small>
                                                </div>
                                                <a href="{{ path('app_course_show', {'id': courseData.id}) }}" class="btn btn-sm btn-primary mt-2">
                                                    {% if courseData.progress == 100 %}
                                                        <i class="fas fa-redo me-1"></i>Review
                                                    {% elseif courseData.progress > 0 %}
                                                        <i class="fas fa-play me-1"></i>Continue
                                                    {% else %}
                                                        <i class="fas fa-play me-1"></i>Start
                                                    {% endif %}
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                {% endif %}
                <!-- Continue learning END -->

                <!-- Recent Certificates START -->
                {% if certificates|length > 0 %}
                <div class="card shadow mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="mb-0">Recent Certificates</h5>
                            <a href="{{ path('app_student_certificates') }}" class="btn btn-sm btn-primary">View All</a>
                        </div>
                        
                        <div class="row g-3">
                            {% for certificate in certificates %}
                            <div class="col-md-4">
                                <div class="certificate-card border-0 shadow-sm h-100">
                                    <div class="card-body p-3">
                                        <div class="text-center mb-3">
                                            <div class="certificate-icon bg-gradient-gold text-white rounded-circle mb-2 mx-auto d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                <i class="fas fa-award fa-2x"></i>
                                            </div>
                                            <h6 class="mb-1 fw-bold">{{ certificate.course.title }}</h6>
                                            <p class="mb-2 small text-muted">{{ certificate.generatedAt|date('M d, Y') }}</p>
                                            <div class="d-flex justify-content-center gap-2 mb-2">
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check me-1"></i>Completed
                                                </span>
                                                {% if certificate.quizResult %}
                                                <span class="badge bg-primary">
                                                    {{ certificate.quizResult.percentage|round }}%
                                                </span>
                                                {% endif %}
                                            </div>
                                            <div class="d-grid">
                                                <a href="#" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-download me-1"></i>Download
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                {% endif %}
                <!-- Recent Certificates END -->

                <!-- Achievements START -->
                <div class="card shadow mb-4">
                    <div class="card-body p-4">
                        <h5 class="mb-4">Recent Achievements</h5>
                        
                        <div class="row g-3">
                            <div class="col-6 col-md-3">
                                <div class="achievement-item text-center p-3 rounded-3 bg-light hover-lift">
                                    <div class="achievement-icon bg-warning bg-opacity-10 text-warning rounded-circle mb-2 mx-auto d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                        <i class="fas fa-trophy fa-lg"></i>
                                    </div>
                                    <h6 class="mb-1 fw-semibold">First Course</h6>
                                    <p class="mb-0 small text-muted">Completed your first course</p>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="achievement-item text-center p-3 rounded-3 bg-light hover-lift">
                                    <div class="achievement-icon bg-primary bg-opacity-10 text-primary rounded-circle mb-2 mx-auto d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                        <i class="fas fa-fire fa-lg"></i>
                                    </div>
                                    <h6 class="mb-1 fw-semibold">7-Day Streak</h6>
                                    <p class="mb-0 small text-muted">Learned for 7 days straight</p>
                                </div>
                            </div>
                            {% if completedCourses >= 2 %}
                            <div class="col-6 col-md-3">
                                <div class="achievement-item text-center p-3 rounded-3 bg-light hover-lift">
                                    <div class="achievement-icon bg-success bg-opacity-10 text-success rounded-circle mb-2 mx-auto d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                        <i class="fas fa-graduation-cap fa-lg"></i>
                                    </div>
                                    <h6 class="mb-1 fw-semibold">Knowledge Seeker</h6>
                                    <p class="mb-0 small text-muted">Completed 2+ courses</p>
                                </div>
                            </div>
                            {% endif %}
                            {% if totalEnrollments > 0 %}
                            <div class="col-6 col-md-3">
                                <div class="achievement-item text-center p-3 rounded-3 bg-light hover-lift">
                                    <div class="achievement-icon bg-info bg-opacity-10 text-info rounded-circle mb-2 mx-auto d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                        <i class="fas fa-star fa-lg"></i>
                                    </div>
                                    <h6 class="mb-1 fw-semibold">New Student</h6>
                                    <p class="mb-0 small text-muted">Started your journey</p>
                                </div>
                            </div>
                            {% else %}
                            <div class="col-12">
                                <div class="text-center py-4">
                                    <i class="fas fa-award fa-3x text-muted mb-3"></i>
                                    <h5 class="text-muted">No achievements yet</h5>
                                    <p class="text-muted">Start learning to unlock achievements!</p>
                                </div>
                            </div>
                            {% endif %}
