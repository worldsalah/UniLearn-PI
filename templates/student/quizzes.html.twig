{% extends 'front_base.html.twig' %}

{% block title %}Available Quizzes - Unilearn{% endblock %}

{% block content %}
<!-- **************** MAIN CONTENT START **************** -->
<main>

<!-- =======================
Student Quizzes START -->
<section class="pt-4">
    <div class="container">
        <div class="row">
            <!-- Left sidebar START -->
            <div class="col-lg-3">
                <!-- User profile START -->
                <div class="card shadow mb-4">
                    <div class="card-body text-center p-4">
                        <div class="avatar avatar-xl mb-3">
                            {% if user.profileImage %}
                                <img class="avatar-img rounded-circle" src="{{ asset('uploads/profile/' ~ user.profileImage) }}" alt="{{ user.fullName }}">
                            {% else %}
                                <div class="avatar-img rounded-circle bg-primary d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                    <span class="text-white fs-4 fw-bold">{{ user.fullName|first|upper }}</span>
                                </div>
                            {% endif %}
                        </div>
                        <h5 class="mb-1">{{ user.fullName }}</h5>
                        <p class="mb-2">{{ user.email }}</p>
                        <div class="d-flex justify-content-center gap-2">
                            <a href="#" class="btn btn-sm btn-primary">Edit Profile</a>
                        </div>
                    </div>
                </div>
                <!-- User profile END -->

                <!-- Gamification Widget START -->
                <div class="card shadow mb-4">
                    <div class="card-body p-3">
                        <h6 class="mb-3">
                            <i class="fas fa-trophy text-warning me-2"></i>
                            My Progress
                        </h6>
                        <div class="text-center mb-3">
                            <div class="badge bg-primary fs-6 mb-2">
                                <i class="fas fa-star me-1"></i>
                                <span id="total-xp">0</span> XP
                            </div>
                            <small class="text-muted">Total Points</small>
                        </div>
                        <div class="progress mb-3" style="height: 8px;">
                            <div class="progress-bar" id="level-progress" style="width: 0%; background-color: #6366f1;"></div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <small class="text-muted">Level: <span id="current-level">Beginner</span></small>
                            <small class="text-muted">Rank: #<span id="user-rank">--</span></small>
                        </div>
                        <div class="d-grid gap-2">
                            <a href="{{ path('app_gamification_profile') }}" class="btn btn-sm btn-primary">
                                <i class="fas fa-trophy me-1"></i>View Profile
                            </a>
                            <a href="{{ path('app_gamification_leaderboard') }}" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-crown me-1"></i>Leaderboard
                            </a>
                        </div>
                    </div>
                </div>
                <!-- Gamification Widget END -->

                <!-- Navigation menu START -->
                <div class="card shadow">
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            <a href="{{ path('app_student_dashboard') }}" class="list-group-item list-group-item-action">
                                <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                            </a>
                            <a href="{{ path('app_student_courses') }}" class="list-group-item list-group-item-action">
                                <i class="fas fa-book me-2"></i>My Courses
                            </a>
                            <a href="{{ path('app_student_certificates') }}" class="list-group-item list-group-item-action">
                                <i class="fas fa-certificate me-2"></i>Certificates
                            </a>
                            <a href="{{ path('app_student_quiz_analysis') }}" class="list-group-item list-group-item-action">
                                <i class="fas fa-brain me-2"></i>AI Quiz Analysis
                            </a>
                            <a href="{{ path('app_student_quizzes') }}" class="list-group-item list-group-item-action active">
                                <i class="fas fa-question-circle me-2"></i>Available Quizzes
                            </a>
                            <a href="{{ path('app_student_ai_roadmap') }}" class="list-group-item list-group-item-action">
                                <i class="fas fa-lightbulb me-2"></i>AI Recommendations
                            </a>
                            <a href="{{ path('app_gamification_profile') }}" class="list-group-item list-group-item-action">
                                <i class="fas fa-trophy me-2"></i>My Gamification
                            </a>
                            <a href="{{ path('app_gamification_leaderboard') }}" class="list-group-item list-group-item-action">
                                <i class="fas fa-crown me-2"></i>Leaderboard
                            </a>
                            <a href="{{ path('app_student_settings') }}" class="list-group-item list-group-item-action">
                                <i class="fas fa-cog me-2"></i>Settings
                            </a>
                        </div>
                    </div>
                </div>
                <!-- Navigation menu END -->
            </div>

            <!-- Main content START -->
            <div class="col-lg-9">
                <!-- Page header START -->
                <div class="card shadow mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h3 class="mb-1">Available Quizzes</h3>
                                <p class="mb-0">Test your knowledge with our interactive quizzes</p>
                            </div>
                            <div class="text-end">
                                <div class="badge bg-primary fs-6">{{ totalQuizzes }}</div>
                                <small class="text-muted d-block">Total Quizzes</small>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Page header END -->

                <!-- Quizzes list START -->
                {% if quizzes|length > 0 %}
                    <div class="row g-4">
                        {% for quiz in quizzes %}
                            <div class="col-md-6 col-lg-4">
                                <div class="card border-0 shadow h-100 card-hover-shadow">
                                    <div class="card-body p-4">
                                        <div class="text-center mb-3">
                                            <div class="icon-lg bg-primary bg-opacity-10 text-primary rounded-circle mx-auto">
                                                <i class="fas fa-question-circle fa-2x"></i>
                                            </div>
                                        </div>
                                        
                                        <h5 class="card-title text-center mb-3">{{ quiz.title }}</h5>
                                        
                                        <div class="mb-3">
                                            <span class="badge bg-info">
                                                {% if quiz.course %}
                                                    {{ quiz.course.title }}
                                                {% else %}
                                                    General Quiz
                                                {% endif %}
                                            </span>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-muted">
                                                    <i class="fas fa-list me-1"></i>
                                                    {{ quiz.questions|length }} Questions
                                                </small>
                                                <small class="text-muted">
                                                    <i class="fas fa-clock me-1"></i>
                                                    No time limit
                                                </small>
                                            </div>
                                        </div>
                                        
                                        <div class="text-center">
                                            {% if quiz.questions|length > 0 %}
                                                <a href="{{ path('quiz_take', {'id': quiz.id}) }}" class="btn btn-primary">
                                                    <i class="fas fa-play me-2"></i>Start Quiz
                                                </a>
                                            {% else %}
                                                <button class="btn btn-primary" disabled>
                                                    <i class="fas fa-play me-2"></i>No Questions
                                                </button>
                                                <small class="text-muted d-block mt-2">Quiz has no questions yet</small>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="card shadow">
                        <div class="card-body text-center py-5">
                            <div class="icon-xl bg-muted bg-opacity-10 text-muted rounded-circle mb-3 mx-auto">
                                <i class="fas fa-question-circle fa-3x"></i>
                            </div>
                            <h4 class="mb-3">No Quizzes Available</h4>
                            <p class="text-muted mb-4">
                                There are no quizzes available at the moment. 
                                {% if user.enrollments|length == 0 %}
                                    Enroll in some courses to unlock course-specific quizzes.
                                {% else %}
                                    Check back later for new quizzes.
                                {% endif %}
                            </p>
                            <a href="{{ path('app_student_courses') }}" class="btn btn-primary">
                                <i class="fas fa-book me-2"></i>Browse Courses
                            </a>
                        </div>
                    </div>
                {% endif %}
                <!-- Quizzes list END -->
            </div>
            <!-- Main content END -->
        </div>
    </div>
</section>
<!-- =======================
Student Quizzes END -->

</main>
<!-- **************** MAIN CONTENT END **************** -->

<!-- Gamification JavaScript -->
<script>
// Load gamification data on page
document.addEventListener('DOMContentLoaded', function() {
    // Load user gamification stats
    fetch('/gamification/api/stats')
        .then(response => {
            if (!response.ok) {
                throw new Error('Gamification service not available');
            }
            return response.json();
        })
        .then(data => {
            if (data.stats && data.progress) {
                // Update widget
                updateWidget(data.stats, data.progress);
            }
        })
        .catch(error => {
            console.log('Gamification data not available:', error.message);
            // Set default values
            setDefaultValues();
        });
    
    function updateWidget(stats, progress) {
        // Update XP
        const xpElement = document.getElementById('total-xp');
        if (xpElement) {
            xpElement.textContent = stats.total_points || 0;
        }
        
        // Update level
        const levelElement = document.getElementById('current-level');
        if (levelElement && stats.current_level) {
            levelElement.textContent = stats.current_level.name || 'Beginner';
        }
        
        // Update rank
        const rankElement = document.getElementById('user-rank');
        if (rankElement) {
            rankElement.textContent = stats.rank || '--';
        }
        
        // Update progress bar
        const progressBar = document.getElementById('level-progress');
        if (progressBar && progress) {
            progressBar.style.width = progress.progress + '%';
            progressBar.style.backgroundColor = stats.current_level?.color || '#6366f1';
        }
        
        // Animate the widget
        animateWidget();
    }
    
    function setDefaultValues() {
        document.getElementById('total-xp').textContent = '0';
        document.getElementById('current-level').textContent = 'Beginner';
        document.getElementById('user-rank').textContent = '--';
        document.getElementById('level-progress').style.width = '0%';
    }
    
    function animateWidget() {
        const widget = document.querySelector('.card.shadow.mb-4');
        if (widget) {
            widget.style.opacity = '0';
            widget.style.transform = 'translateY(20px)';
            
            setTimeout(() => {
                widget.style.transition = 'all 0.5s ease';
                widget.style.opacity = '1';
                widget.style.transform = 'translateY(0)';
            }, 100);
        }
        
        // Animate XP counter
        const xpElement = document.getElementById('total-xp');
        if (xpElement) {
            const targetValue = parseInt(xpElement.textContent);
            let currentValue = 0;
            const increment = targetValue / 50;
            
            const timer = setInterval(() => {
                currentValue += increment;
                if (currentValue >= targetValue) {
                    currentValue = targetValue;
                    clearInterval(timer);
                }
                xpElement.textContent = Math.round(currentValue);
            }, 20);
        }
    }
});
</script>

<style>
.card-hover-shadow {
    transition: all 0.3s ease;
}

.card-hover-shadow:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
}

.icon-lg {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
}

.icon-xl {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
}
</style>

{% include 'components/footer.html.twig' %}
{% endblock %}
