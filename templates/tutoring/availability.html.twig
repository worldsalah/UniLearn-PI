{% extends 'front_base.html.twig' %}

{% block title %}Set Availability - UniLearn{% endblock %}

{% block content %}
<!-- **************** MAIN CONTENT START **************** -->
<main>
    <!-- =======================
    Page Banner START -->
    <section class="bg-primary py-5" style="background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8 mx-auto text-center">
                    <h1 class="text-white display-6">Set Your Weekly Availability</h1>
                    <p class="text-white opacity-75 mb-0">Students can book sessions during your available hours</p>
                </div>
            </div>
        </div>
    </section>
    <!-- Page Banner END -->

    <!-- =======================
    Availability Form START -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row g-4">
                <!-- Profile Info Card -->
                <div class="col-lg-4">
                    <div class="card border shadow-sm h-100">
                        <div class="card-header bg-white">
                            <h5 class="mb-0"><i class="fas fa-user-graduate text-primary me-2"></i>Your Teaching Profile</h5>
                        </div>
                        <div class="card-body">
                            <form id="profileForm">
                                <!-- Subjects/Categories -->
                                <div class="mb-3">
                                    <label class="form-label">Subjects You Teach <span class="text-danger">*</span></label>
                                    <select name="subjects" id="subjectsSelect" multiple class="form-select">
                                        {% for category in categories %}
                                        <option value="{{ category.name }}" {% if profile and category.name in profile.subjects %}selected{% endif %}>
                                            {{ category.name }}
                                        </option>
                                        {% endfor %}
                                    </select>
                                    <small class="text-muted">Select all subjects you can teach</small>
                                </div>
                                
                                <!-- Hourly Rate -->
                                <div class="mb-3">
                                    <label class="form-label">Hourly Rate ($) <span class="text-danger">*</span></label>
                                    <input type="number" name="hourlyRate" id="hourlyRate" class="form-control" 
                                           placeholder="45" min="1" step="0.01"
                                           value="{{ profile ? profile.hourlyRate : '' }}">
                                </div>
                                
                                <!-- Experience Years -->
                                <div class="mb-3">
                                    <label class="form-label">Years of Experience</label>
                                    <input type="number" name="experienceYears" id="experienceYears" class="form-control" 
                                           placeholder="5" min="0"
                                           value="{{ profile ? profile.experienceYears : '' }}">
                                </div>
                                
                                <!-- Education -->
                                <div class="mb-3">
                                    <label class="form-label">Education</label>
                                    <input type="text" name="education" id="education" class="form-control" 
                                           placeholder="e.g., PhD in Mathematics from MIT"
                                           value="{{ profile ? profile.education : '' }}">
                                </div>
                                
                                <!-- Teaching Description -->
                                <div class="mb-3">
                                    <label class="form-label">What will students learn?</label>
                                    <textarea name="bio" id="bio" class="form-control" rows="4" 
                                              placeholder="Describe what students will learn in your sessions, your teaching style, and what makes you a great tutor...">{{ profile ? profile.bio : '' }}</textarea>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Availability Schedule -->
                <div class="col-lg-8">
                    <div class="card border shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="fas fa-calendar-alt text-primary me-2"></i>Weekly Schedule</h5>
                            <span class="badge bg-primary bg-opacity-10 text-primary">Click days to add time slots</span>
                        </div>
                        <div class="card-body p-0">
                            <form id="availabilityForm">
                                {% set days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'] %}
                                {% set dayIcons = ['📅', '📅', '📅', '📅', '📅', '🌟', '🌟'] %}
                                
                                {% for day in days %}
                                <div class="border-bottom {% if loop.last %}border-0{% endif %} {% if loop.index is odd %}bg-white{% else %}bg-light{% endif %}">
                                    <div class="p-4">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <div class="d-flex align-items-center">
                                                <input type="checkbox" id="day{{ loop.index0 }}" 
                                                       name="day[{{ loop.index0 }}][enabled]" 
                                                       class="form-check-input me-3" style="width: 1.3em; height: 1.3em;"
                                                       {% set hasAvail = false %}
                                                       {% for avail in availabilities %}
                                                           {% if avail.dayOfWeek == loop.index0 %}
                                                               {% set hasAvail = true %}
                                                           {% endif %}
                                                       {% endfor %}
                                                       {% if hasAvail %}checked{% endif %}>
                                                <label for="day{{ loop.index0 }}" class="form-check-label fw-semibold fs-5 mb-0">
                                                    {{ dayIcons[loop.index0] }} {{ day }}
                                                </label>
                                            </div>
                                            <button type="button" onclick="addSlot({{ loop.index0 }})" 
                                                    class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-plus me-1"></i>Add Time Slot
                                            </button>
                                        </div>

                                        <div id="slots{{ loop.index0 }}" class="ms-4">
                                            {% for avail in availabilities %}
                                                {% if avail.dayOfWeek == loop.index0 %}
                                                <div class="time-slot-row d-flex align-items-center gap-3 mb-2 p-2 bg-white rounded border">
                                                    <input type="hidden" name="day[{{ loop.index0 }}][slots][]" value="{{ avail.id }}">
                                                    <div class="input-group" style="width: 140px;">
                                                        <span class="input-group-text bg-white"><i class="far fa-clock text-muted"></i></span>
                                                        <input type="time" name="day[{{ loop.index0 }}][start][]" 
                                                               value="{{ avail.startTime|date('H:i') }}"
                                                               class="form-control border-start-0">
                                                    </div>
                                                    <span class="text-muted fw-medium">to</span>
                                                    <div class="input-group" style="width: 140px;">
                                                        <span class="input-group-text bg-white"><i class="far fa-clock text-muted"></i></span>
                                                        <input type="time" name="day[{{ loop.index0 }}][end][]" 
                                                               value="{{ avail.endTime|date('H:i') }}"
                                                               class="form-control border-start-0">
                                                    </div>
                                                    <button type="button" onclick="removeSlot(this)" 
                                                            class="btn btn-sm btn-outline-danger border-0">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </div>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                                {% endfor %}
                            </form>
                        </div>
                        
                        <!-- Settings -->
                        <div class="card-footer bg-white border-top">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label mb-1 text-muted"><i class="fas fa-hourglass-half me-1"></i>Session Duration</label>
                                    <select name="sessionDuration" class="form-select">
                                        <option value="30">30 minutes</option>
                                        <option value="45">45 minutes</option>
                                        <option value="60" selected>60 minutes</option>
                                        <option value="90">90 minutes</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label mb-1 text-muted"><i class="fas fa-pause-circle me-1"></i>Buffer Between Sessions</label>
                                    <select name="bufferTime" class="form-select">
                                        <option value="0">No buffer</option>
                                        <option value="5">5 minutes</option>
                                        <option value="10">10 minutes</option>
                                        <option value="15" selected>15 minutes</option>
                                        <option value="30">30 minutes</option>
                                    </select>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <a href="{{ path('tutoring_teacher_dashboard') }}" class="btn btn-outline-secondary me-2">
                                        <i class="fas fa-arrow-left me-1"></i>Back
                                    </a>
                                    <button type="button" onclick="saveAvailability()" class="btn btn-primary">
                                        <i class="fas fa-save me-1"></i>Save Schedule
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Availability Form END -->
</main>
<!-- **************** MAIN CONTENT END **************** -->

<script>
function addSlot(dayIndex) {
    const container = document.getElementById('slots' + dayIndex);
    const slotHtml = `
        <div class="time-slot-row d-flex align-items-center gap-3 mb-2 p-2 bg-white rounded border">
            <div class="input-group" style="width: 140px;">
                <span class="input-group-text bg-white"><i class="far fa-clock text-muted"></i></span>
                <input type="time" name="day[${dayIndex}][start][]" value="09:00" class="form-control border-start-0">
            </div>
            <span class="text-muted fw-medium">to</span>
            <div class="input-group" style="width: 140px;">
                <span class="input-group-text bg-white"><i class="far fa-clock text-muted"></i></span>
                <input type="time" name="day[${dayIndex}][end][]" value="17:00" class="form-control border-start-0">
            </div>
            <button type="button" onclick="removeSlot(this)" class="btn btn-sm btn-outline-danger border-0">
                <i class="fas fa-times"></i>
            </button>
        </div>
    `;
    container.insertAdjacentHTML('beforeend', slotHtml);
}

function removeSlot(btn) {
    btn.closest('.time-slot-row').remove();
}

async function saveAvailability() {
    // Get profile data
    const subjectsSelect = document.getElementById('subjectsSelect');
    const subjects = Array.from(subjectsSelect.selectedOptions).map(opt => opt.value);
    const hourlyRate = document.getElementById('hourlyRate').value;
    const experienceYears = document.getElementById('experienceYears').value;
    const education = document.getElementById('education').value;
    const bio = document.getElementById('bio').value;
    
    // Validate profile
    if (subjects.length === 0) {
        showGlobalNotification('Error', 'Please select at least one subject', 'error', 'fas fa-exclamation-circle');
        return;
    }
    if (!hourlyRate || hourlyRate <= 0) {
        showGlobalNotification('Error', 'Please enter a valid hourly rate', 'error', 'fas fa-exclamation-circle');
        return;
    }
    
    // Get availability data
    const formData = new FormData(document.getElementById('availabilityForm'));
    const availabilities = [];
    
    for (let day = 0; day < 7; day++) {
        const enabled = formData.get(`day[${day}][enabled]`);
        if (enabled) {
            const starts = formData.getAll(`day[${day}][start][]`);
            const ends = formData.getAll(`day[${day}][end][]`);
            
            for (let i = 0; i < starts.length; i++) {
                if (starts[i] && ends[i]) {
                    availabilities.push({
                        dayOfWeek: day,
                        startTime: starts[i],
                        endTime: ends[i]
                    });
                }
            }
        }
    }
    
    try {
        // Save profile first
        const profileResponse = await fetch('/api/teacher/profile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                subjects: subjects,
                hourlyRate: parseFloat(hourlyRate),
                experienceYears: parseInt(experienceYears) || 0,
                education: education,
                bio: bio
            })
        });
        
        const profileData = await profileResponse.json();
        
        if (!profileData.success) {
            showGlobalNotification('Error', profileData.error || 'Failed to save profile', 'error', 'fas fa-exclamation-circle');
            return;
        }
        
        // Then save availability
        const availResponse = await fetch('/api/availability', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ availabilities })
        });
        
        const availData = await availResponse.json();
        
        if (availData.success) {
            showGlobalNotification('Success!', 'Profile and schedule saved successfully!', 'success', 'fas fa-check-circle');
            setTimeout(() => window.location.reload(), 1500);
        } else {
            showGlobalNotification('Error', availData.error || 'Failed to save availability', 'error', 'fas fa-exclamation-circle');
        }
    } catch (error) {
        showGlobalNotification('Error', 'Failed to save. Please try again.', 'error', 'fas fa-exclamation-circle');
    }
}

// Initialize Choices.js for multi-select
document.addEventListener('DOMContentLoaded', function() {
    const subjectsSelect = document.getElementById('subjectsSelect');
    if (subjectsSelect && typeof Choices !== 'undefined') {
        new Choices(subjectsSelect, {
            removeItemButton: true,
            placeholder: true,
            placeholderValue: 'Select subjects you teach...',
            searchEnabled: true,
            searchPlaceholderValue: 'Search subjects...',
            noResultsText: 'No subjects found',
            itemSelectText: 'Press to select',
            allowHTML: true
        });
    }
});
</script>
{% endblock %}
