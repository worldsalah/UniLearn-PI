{% extends 'base.html.twig' %}

{% block title %}My Bookings - UniLearn{% endblock %}

{% block body %}
<div class="bg-gray-50 min-h-screen">
    {# Header #}
    <div class="bg-white shadow">
        <div class="max-w-7xl mx-auto px-4 py-6">
            <h1 class="text-2xl font-bold text-gray-900">My Bookings</h1>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-8">
        {# Tabs #}
        <div class="flex gap-4 mb-6">
            <button class="px-4 py-2 bg-blue-600 text-white rounded-lg">All</button>
            <button class="px-4 py-2 bg-white text-gray-700 rounded-lg hover:bg-gray-50">Upcoming</button>
            <button class="px-4 py-2 bg-white text-gray-700 rounded-lg hover:bg-gray-50">Completed</button>
            <button class="px-4 py-2 bg-white text-gray-700 rounded-lg hover:bg-gray-50">Cancelled</button>
        </div>

        {% if bookings|length > 0 %}
        <div class="space-y-4">
            {% for booking in bookings %}
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div class="flex items-start gap-4">
                        {# Date Box #}
                        <div class="text-center p-3 bg-blue-50 rounded-lg min-w-[80px]">
                            <div class="text-sm text-blue-600 font-medium">{{ booking.timeSlot.date|date('M') }}</div>
                            <div class="text-2xl font-bold text-blue-700">{{ booking.timeSlot.date|date('j') }}</div>
                        </div>

                        <div>
                            <div class="font-semibold text-lg">
                                {% if isTeacher %}
                                    {{ booking.student.firstName }} {{ booking.student.lastName }}
                                {% else %}
                                    {{ booking.teacher.firstName }} {{ booking.teacher.lastName }}
                                {% endif %}
                            </div>
                            <div class="text-gray-600">
                                {{ booking.timeSlot.date|date('l') }} • {{ booking.timeSlot.startTime|date('H:i') }} - {{ booking.timeSlot.endTime|date('H:i') }}
                            </div>
                            {% if booking.notes %}
                            <div class="text-gray-500 text-sm mt-1">{{ booking.notes|slice(0, 50) }}...</div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="flex items-center gap-4">
                        <span class="px-3 py-1 rounded-full text-sm font-medium
                            {{ booking.status == 'confirmed' ? 'bg-green-100 text-green-700' }}
                            {{ booking.status == 'pending' ? 'bg-yellow-100 text-yellow-700' }}
                            {{ booking.status == 'completed' ? 'bg-blue-100 text-blue-700' }}
                            {{ booking.status == 'cancelled' ? 'bg-red-100 text-red-700' }}
                            {{ booking.status == 'no_show' ? 'bg-gray-100 text-gray-700' }}">
                            {{ booking.status|replace({'_': ' '})|capitalize }}
                        </span>
                        
                        <div class="text-right">
                            <div class="font-semibold">${{ booking.price }}</div>
                        </div>

                        <div class="flex gap-2">
                            {% if booking.status == 'pending' and isTeacher %}
                            <button class="px-3 py-1 bg-green-600 text-white rounded text-sm hover:bg-green-700">
                                Confirm
                            </button>
                            {% endif %}
                            
                            {% if booking.status in ['pending', 'confirmed'] %}
                            <button class="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50">
                                {% if isTeacher %}Cancel{% else %}Reschedule{% endif %}
                            </button>
                            {% endif %}

                            {% if booking.status == 'completed' and not isTeacher %}
                            <button class="px-3 py-1 bg-blue-600 text-white rounded text-sm hover:bg-blue-700">
                                Leave Review
                            </button>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="text-center py-16 bg-white rounded-lg shadow">
            <div class="text-6xl mb-4">📅</div>
            <h2 class="text-2xl font-semibold text-gray-700 mb-2">No bookings yet</h2>
            {% if not isTeacher %}
            <p class="text-gray-500 mb-4">Start by finding a tutor and booking your first session</p>
            <a href="{{ path('tutoring_teachers') }}" 
               class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                Find Tutors
            </a>
            {% else %}
            <p class="text-gray-500">Set your availability to start receiving booking requests</p>
            <a href="{{ path('tutoring_availability') }}" 
               class="mt-4 inline-block px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                Set Availability
            </a>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
