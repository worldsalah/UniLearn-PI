{% extends 'base.html.twig' %}

{% block title %}Student Dashboard - UniLearn{% endblock %}

{% block body %}
<div class="bg-gray-50 min-h-screen">
    {# Header #}
    <div class="bg-white shadow">
        <div class="max-w-7xl mx-auto px-4 py-6">
            <h1 class="text-2xl font-bold text-gray-900">Welcome back, {{ app.user.firstName }}!</h1>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-8">
        {# Stats Cards #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="p-3 bg-blue-100 rounded-full">
                        <span class="text-2xl">📚</span>
                    </div>
                    <div class="ml-4">
                        <div class="text-gray-500 text-sm">Total Sessions</div>
                        <div class="text-2xl font-bold">{{ stats.totalBookings }}</div>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="p-3 bg-green-100 rounded-full">
                        <span class="text-2xl">📅</span>
                    </div>
                    <div class="ml-4">
                        <div class="text-gray-500 text-sm">Upcoming</div>
                        <div class="text-2xl font-bold">{{ stats.upcomingSessions }}</div>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="p-3 bg-purple-100 rounded-full">
                        <span class="text-2xl">🎁</span>
                    </div>
                    <div class="ml-4">
                        <div class="text-gray-500 text-sm">Bundle Sessions</div>
                        <div class="text-2xl font-bold">
                            {% set total = 0 %}
                            {% for bundle in bundles %}
                                {% set total = total + bundle.sessionsRemaining %}
                            {% endfor %}
                            {{ total }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            {# Upcoming Sessions #}
            <div class="bg-white rounded-lg shadow">
                <div class="p-6 border-b">
                    <h2 class="text-xl font-semibold">Upcoming Sessions</h2>
                </div>
                <div class="p-6">
                    {% if upcomingBookings|length > 0 %}
                    <div class="space-y-4">
                        {% for booking in upcomingBookings %}
                        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                            <div>
                                <div class="font-medium">{{ booking.teacher.firstName }} {{ booking.teacher.lastName }}</div>
                                <div class="text-gray-500 text-sm">
                                    {{ booking.timeSlot.date|date('M j, Y') }} at {{ booking.timeSlot.startTime|date('H:i') }}
                                </div>
                                <span class="inline-block mt-1 px-2 py-1 text-xs rounded-full
                                    {{ booking.status == 'confirmed' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' }}">
                                    {{ booking.status|capitalize }}
                                </span>
                            </div>
                            <div class="flex gap-2">
                                {% if booking.status == 'confirmed' %}
                                <button class="px-3 py-1 bg-blue-600 text-white rounded text-sm hover:bg-blue-700">
                                    Join
                                </button>
                                {% endif %}
                                <button class="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50">
                                    Details
                                </button>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="text-center py-8 text-gray-500">
                        <div class="text-4xl mb-2">📅</div>
                        <p>No upcoming sessions</p>
                        <a href="{{ path('tutoring_teachers') }}" class="text-blue-600 hover:underline">Find a tutor</a>
                    </div>
                    {% endif %}
                </div>
            </div>

            {# My Bundles #}
            <div class="bg-white rounded-lg shadow">
                <div class="p-6 border-b flex justify-between items-center">
                    <h2 class="text-xl font-semibold">My Bundles</h2>
                    <a href="{{ path('tutoring_bundles') }}" class="text-blue-600 hover:underline text-sm">View all</a>
                </div>
                <div class="p-6">
                    {% if bundles|length > 0 %}
                    <div class="space-y-4">
                        {% for bundle in bundles %}
                        <div class="p-4 border rounded-lg">
                            <div class="flex justify-between items-start mb-2">
                                <div>
                                    <div class="font-medium">{{ bundle.type|capitalize }} Pack</div>
                                    <div class="text-gray-500 text-sm">
                                        {% if bundle.teacher %}
                                        with {{ bundle.teacher.user.firstName }} {{ bundle.teacher.user.lastName }}
                                        {% else %}
                                        Any tutor
                                        {% endif %}
                                    </div>
                                </div>
                                <span class="px-2 py-1 bg-green-100 text-green-700 text-xs rounded-full">
                                    Active
                                </span>
                            </div>
                            <div class="mt-3">
                                <div class="flex justify-between text-sm mb-1">
                                    <span>{{ bundle.sessionsUsed }}/{{ bundle.sessionsTotal }} sessions used</span>
                                    <span>{{ bundle.sessionsRemaining }} left</span>
                                </div>
                                <div class="w-full bg-gray-200 rounded-full h-2">
                                    <div class="bg-blue-600 h-2 rounded-full" 
                                         style="width: {{ (bundle.sessionsUsed / bundle.sessionsTotal * 100) }}%"></div>
                                </div>
                                <div class="text-gray-500 text-xs mt-1">
                                    Expires: {{ bundle.expiresAt|date('M j, Y') }}
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="text-center py-8 text-gray-500">
                        <div class="text-4xl mb-2">🎁</div>
                        <p>No active bundles</p>
                        <p class="text-sm mt-2">Save up to 20% with session packs!</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Quick Actions #}
        <div class="mt-8 bg-white rounded-lg shadow p-6">
            <h2 class="text-xl font-semibold mb-4">Quick Actions</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <a href="{{ path('tutoring_teachers') }}" 
                   class="flex flex-col items-center p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition">
                    <span class="text-3xl mb-2">🔍</span>
                    <span class="text-sm font-medium">Find Tutors</span>
                </a>
                <a href="{{ path('tutoring_bookings') }}" 
                   class="flex flex-col items-center p-4 bg-green-50 rounded-lg hover:bg-green-100 transition">
                    <span class="text-3xl mb-2">📅</span>
                    <span class="text-sm font-medium">My Bookings</span>
                </a>
                <a href="{{ path('tutoring_bundles') }}" 
                   class="flex flex-col items-center p-4 bg-purple-50 rounded-lg hover:bg-purple-100 transition">
                    <span class="text-3xl mb-2">🎁</span>
                    <span class="text-sm font-medium">Buy Bundles</span>
                </a>
                <a href="{{ path('profile') }}" 
                   class="flex flex-col items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition">
                    <span class="text-3xl mb-2">⚙️</span>
                    <span class="text-sm font-medium">Settings</span>
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
