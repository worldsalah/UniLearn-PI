{% extends 'front_base.html.twig' %}

{% block title %}{{ teacher.user.firstName }} {{ teacher.user.lastName }} - Tutor Profile{% endblock %}

{% block content %}
<!-- **************** MAIN CONTENT START **************** -->
<main>
    <!-- =======================
    Profile Header START -->
    <section class="bg-primary py-5" style="background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8 mx-auto">
                    <div class="d-flex align-items-center gap-4">
                        <!-- Avatar -->
                        <div class="avatar avatar-xxl">
                            <div class="avatar-img rounded-circle bg-white bg-opacity-25 d-flex align-items-center justify-content-center" style="width: 120px; height: 120px;">
                                <i class="fas fa-user-tie text-white fs-1"></i>
                            </div>
                        </div>
                        
                        <!-- Info -->
                        <div class="flex-grow-1">
                            <h1 class="text-white display-6 mb-2">{{ teacher.user.firstName }} {{ teacher.user.lastName }}</h1>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                {% for subject in teacher.subjects %}
                                <span class="badge bg-white bg-opacity-25 text-white fs-6">{{ subject }}</span>
                                {% endfor %}
                            </div>
                            <div class="d-flex align-items-center gap-4 text-white">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-star text-warning me-1"></i>
                                    <span class="fw-semibold">{{ teacher.ratingAvg|number_format(1) }}</span>
                                    <span class="opacity-75 ms-1">({{ teacher.reviewCount }} reviews)</span>
                                </div>
                                {% if teacher.isVerified %}
                                <span class="badge bg-success"><i class="fas fa-check me-1"></i>Verified</span>
                                {% endif %}
                            </div>
                        </div>
                        
                        <!-- Price -->
                        <div class="text-end">
                            <div class="text-white display-6 fw-bold">${{ teacher.hourlyRate }}</div>
                            <div class="text-white opacity-75">per hour</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Profile Header END -->

    <!-- =======================
    Profile Content START -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row g-4">
                <!-- Left Column - About & Stats -->
                <div class="col-lg-4">
                    <!-- About Card -->
                    <div class="card border shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <h5 class="mb-0"><i class="fas fa-user text-primary me-2"></i>About Me</h5>
                        </div>
                        <div class="card-body">
                            {% if teacher.bio %}
                            <p class="text-muted mb-4">{{ teacher.bio }}</p>
                            {% else %}
                            <p class="text-muted mb-4">No description provided yet.</p>
                            {% endif %}
                            
                            <hr>
                            
                            <div class="d-flex flex-column gap-3">
                                <!-- Education -->
                                {% if teacher.education %}
                                <div class="d-flex align-items-start gap-3">
                                    <div class="icon-lg bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="fas fa-graduation-cap text-primary"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold">Education</div>
                                        <div class="text-muted small">{{ teacher.education }}</div>
                                    </div>
                                </div>
                                {% endif %}
                                
                                <!-- Experience -->
                                <div class="d-flex align-items-start gap-3">
                                    <div class="icon-lg bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="fas fa-briefcase text-success"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold">Experience</div>
                                        <div class="text-muted small">{{ teacher.experienceYears|default(0) }} years of teaching</div>
                                    </div>
                                </div>
                                
                                <!-- Subjects -->
                                <div class="d-flex align-items-start gap-3">
                                    <div class="icon-lg bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="fas fa-book text-warning"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold">Subjects I Teach</div>
                                        <ul class="list-unstyled mb-0 small text-muted">
                                            {% for subject in teacher.subjects %}
                                            <li><i class="fas fa-check text-success me-1"></i>{{ subject }}</li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Stats Card -->
                    <div class="card border shadow-sm">
                        <div class="card-header bg-white">
                            <h5 class="mb-0"><i class="fas fa-chart-bar text-primary me-2"></i>Statistics</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3 text-center">
                                <div class="col-6">
                                    <div class="p-3 bg-light rounded">
                                        <div class="fs-3 fw-bold text-primary">{{ teacher.reviewCount }}</div>
                                        <div class="text-muted small">Reviews</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-3 bg-light rounded">
                                        <div class="fs-3 fw-bold text-warning">{{ teacher.ratingAvg|number_format(1) }}</div>
                                        <div class="text-muted small">Rating</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-3 bg-light rounded">
                                        <div class="fs-3 fw-bold text-success">{{ teacher.subjects|length }}</div>
                                        <div class="text-muted small">Subjects</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-3 bg-light rounded">
                                        <div class="fs-3 fw-bold text-info">{{ teacher.experienceYears|default(0) }}</div>
                                        <div class="text-muted small">Years Exp.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Middle Column - Available Slots -->
                <div class="col-lg-4">
                    <div class="card border shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="fas fa-calendar-check text-primary me-2"></i>Available Slots</h5>
                            <span class="badge bg-success bg-opacity-10 text-success">Book Now</span>
                        </div>
                        <div class="card-body">
                            {% if slots|length > 0 %}
                            <div class="vstack gap-2">
                                {% set currentDate = null %}
                                {% for slot in slots %}
                                    {% if slot.date|date('Y-m-d') != currentDate %}
                                        {% set currentDate = slot.date|date('Y-m-d') %}
                                        <div class="fw-semibold text-primary mt-3 {% if loop.first %}mt-0{% endif %}">
                                            <i class="fas fa-calendar-day me-1"></i>{{ slot.date|date('l, M j') }}
                                        </div>
                                    {% endif %}
                                    
                                    <button onclick="selectSlot('{{ slot.id }}', '{{ slot.date|date('M j') }}', '{{ slot.startTime|date('H:i') }}', event)"
                                            class="slot-btn btn btn-outline-primary text-start w-100">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span><i class="far fa-clock me-1"></i>{{ slot.startTime|date('H:i') }} - {{ slot.endTime|date('H:i') }}</span>
                                            <span class="badge bg-success-subtle text-success">Open</span>
                                        </div>
                                    </button>
                                {% endfor %}
                            </div>
                            {% else %}
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-calendar-times display-4 mb-3"></i>
                                <p>No available slots in the next 7 days</p>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Right Column - Reviews -->
                <div class="col-lg-4">
                    <div class="card border shadow-sm">
                        <div class="card-header bg-white">
                            <h5 class="mb-0"><i class="fas fa-comments text-primary me-2"></i>Student Reviews</h5>
                        </div>
                        <div class="card-body">
                            {% if reviews|length > 0 %}
                            <div class="vstack gap-3">
                                {% for review in reviews %}
                                <div class="border-bottom pb-3 {% if loop.last %}border-0 pb-0{% endif %}">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div class="text-warning">
                                            {% for i in 1..5 %}
                                                {% if i <= review.rating %}<i class="fas fa-star"></i>{% else %}<i class="far fa-star"></i>{% endif %}
                                            {% endfor %}
                                        </div>
                                        <span class="text-muted small">{{ review.createdAt|date('M j, Y') }}</span>
                                    </div>
                                    {% if review.comment %}
                                    <p class="text-muted small mb-2">"{{ review.comment }}"</p>
                                    {% endif %}
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar avatar-sm">
                                            <div class="avatar-img rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center">
                                                <i class="fas fa-user text-primary small"></i>
                                            </div>
                                        </div>
                                        <span class="fw-medium small">{{ review.student.firstName }}</span>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                            {% else %}
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-comment-slash display-4 mb-3"></i>
                                <p>No reviews yet</p>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Profile Content END -->
</main>
<!-- **************** MAIN CONTENT END **************** -->

<!-- Booking Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-calendar-plus text-primary me-2"></i>Book a Session</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Teacher Info -->
                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded mb-3">
                    <div class="avatar avatar-lg">
                        <div class="avatar-img rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center">
                            <i class="fas fa-user-tie text-primary"></i>
                        </div>
                    </div>
                    <div>
                        <div class="fw-semibold">{{ teacher.user.firstName }} {{ teacher.user.lastName }}</div>
                        <div class="text-muted small">{{ teacher.subjects|join(', ') }}</div>
                    </div>
                    <div class="ms-auto text-end">
                        <div class="fw-bold text-primary">${{ teacher.hourlyRate }}/hr</div>
                    </div>
                </div>
                
                <!-- Selected Slot -->
                <div id="selectedSlot" class="d-none p-3 bg-primary bg-opacity-10 rounded mb-3">
                    <div class="text-muted small">Selected Time</div>
                    <div id="selectedTime" class="fw-semibold text-primary"></div>
                </div>
                
                <!-- Subject Selection -->
                <div class="mb-3">
                    <label class="form-label">Subject</label>
                    <select id="bookingSubject" class="form-select">
                        {% for subject in teacher.subjects %}
                        <option value="{{ subject }}">{{ subject }}</option>
                        {% endfor %}
                    </select>
                </div>
                
                <!-- Notes -->
                <div class="mb-3">
                    <label class="form-label">Notes (optional)</label>
                    <textarea id="bookingNotes" class="form-control" rows="3" placeholder="What would you like to focus on?"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" onclick="confirmBooking()" class="btn btn-primary">
                    <i class="fas fa-check me-1"></i>Confirm Booking
                </button>
            </div>
        </div>
    </div>
</div>

<script>
let selectedSlotId = null;

function selectSlot(slotId, date, time, event) {
    selectedSlotId = slotId;
    document.getElementById('selectedSlot').classList.remove('d-none');
    document.getElementById('selectedTime').textContent = date + ' at ' + time;
    
    // Highlight selected button
    document.querySelectorAll('.slot-btn').forEach(btn => {
        btn.classList.remove('btn-primary');
        btn.classList.add('btn-outline-primary');
    });
    event.target.closest('.slot-btn').classList.remove('btn-outline-primary');
    event.target.closest('.slot-btn').classList.add('btn-primary');
    
    // Open modal
    new bootstrap.Modal(document.getElementById('bookingModal')).show();
}

function confirmBooking() {
    if (!selectedSlotId) {
        showGlobalNotification('Error', 'Please select a time slot', 'error', 'fas fa-exclamation-circle');
        return;
    }
    
    const subject = document.getElementById('bookingSubject').value;
    const notes = document.getElementById('bookingNotes').value;
    
    fetch('/api/bookings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            slotId: selectedSlotId,
            subject: subject,
            notes: notes
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('bookingModal')).hide();
            showGlobalNotification('Success!', 'Session booked successfully!', 'success', 'fas fa-check-circle');
            setTimeout(() => window.location.reload(), 1500);
        } else {
            showGlobalNotification('Error', data.error || 'Failed to book session', 'error', 'fas fa-exclamation-circle');
        }
    })
    .catch(() => {
        showGlobalNotification('Error', 'Failed to book session', 'error', 'fas fa-exclamation-circle');
    });
}
</script>
{% endblock %}
